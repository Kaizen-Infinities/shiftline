# Development-only values for `docker compose --profile full up`. Every secret here is a
# placeholder that works out of the box on a laptop; never reuse them anywhere reachable
# from the internet. apps/api/.env (gitignored) overrides anything set here.

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
LOG_LEVEL=info
LOG_FORMAT=pretty

# Auth and encryption (32+ characters each)
JWT_ACCESS_SECRET=dev-jwt-access-secret-shiftline-local-0123456789abcdef
DATA_ENCRYPTION_KEY=dev-data-encryption-key-shiftline-local-0123456789ab
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_REUSE_GRACE_MS=10000
# Login attempts per IP per 15 minutes (browser test suites raise it)
AUTH_RATE_LIMIT_MAX=30
GLOBAL_RATE_LIMIT_MAX=1200

# Platform admin (platform console login)
ADMIN_EMAIL=admin@dev.shiftline.local
ADMIN_USERNAME=devadmin
ADMIN_PASSWORD=DevAdmin#2026!!

# Demo tenant users seeded by `npm run db:seed` (owner@demo.shiftline.local, accounts@…, …)
SEED_PASSWORD=Demo@12345678

# Background jobs, archives and backups (paths inside the container)
PGBOSS_SCHEMA=pgboss
ARCHIVE_DIR=/app/archives
BACKUP_DIR=/app/backups
EXPORT_DIR=/app/exports
BACKUP_KEEP_DAYS=30
PG_DUMP_PATH=pg_dump

# Email: leave the host blank and outgoing mail is logged instead of sent
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dev.shiftline.local
SMTP_ENCRYPTION=ssl
FROM_NAME=Shiftline (dev)

# Password-reset email via Resend; leave the key blank and sending is skipped (required in production)
RESEND_API_KEY=
RESEND_FROM=Shiftline <no-reply@dev.shiftline.local>
