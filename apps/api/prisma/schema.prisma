  isActive        Boolean        @default(true) @map("is_active")
  sortOrder       Int            @default(0) @map("sort_order")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  subscriptions   Subscription[]

  @@map("plans")
}

/// One subscription per tenant (history is in the audit trail). Seats and the API cap may
/// override the plan; overrides of individual features live in FeatureFlagOverride.
model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  companyId              String             @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus @default(TRIALING)
  seats                  Int?
  apiLimit               Int?               @map("api_limit")
  trialEndsAt            DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart     DateTime?          @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(6)
  cancelledAt            DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  notes                  String?            @db.VarChar(500)
  /// The gateway's own ids, when the subscription is billed through one (P1-21).
  providerSubscriptionId String?            @map("provider_subscription_id") @db.VarChar(120)
  providerCustomerId     String?            @map("provider_customer_id") @db.VarChar(120)
  /// A hand-negotiated monthly price that overrides the plan's list price when set (P2-19);
  /// settable only by a platform admin, and it is what the monthly billing sweep bills.
  negotiatedMonthlyPrice Decimal?           @map("negotiated_monthly_price") @db.Decimal(12, 2)
  createdBy              String?            @map("created_by") @db.VarChar(36)
  updatedBy              String?            @map("updated_by") @db.VarChar(36)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  company Company @relation("CompanySubscription", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId])
  @@map("subscriptions")
}

/// Per-tenant switch for one feature on top of the plan (a pilot, a paid add-on, a kill switch).
model FeatureFlagOverride {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  feature   String    @db.VarChar(40)
  enabled   Boolean
  reason    String?   @db.VarChar(255)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.VarChar(36)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyFeatureFlagOverride", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, feature])
  @@map("feature_flag_overrides")
}

enum GstRegistrationType {
  REGULAR
  COMPOSITION
  UNREGISTERED
  SEZ
  OVERSEAS
  UIN
}

enum HsnType {
  HSN
  SAC
}

/// Nature of a GST supply, decided from the supplier's and recipient's state codes.
enum SupplyType {
  INTRA_STATE
  INTER_STATE
  EXPORT
  SEZ
  DEEMED_EXPORT
}

enum SalesDocumentType {
  TAX_INVOICE
  BILL_OF_SUPPLY
  EXPORT_INVOICE
}

/// A return moves goods back; a price adjustment only corrects value (credit/debit note without stock).
enum ReturnKind {
  GOODS_RETURN
  PRICE_ADJUSTMENT
}

/// HSN (goods) or SAC (services) code with its default GST rate (P1-08). Tenant-scoped so a
/// company can add codes and adjust rates; provisioning seeds a starter list.
model HsnCode {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  code        String   @db.VarChar(8)
  type        HsnType  @default(HSN)
  description String   @db.VarChar(255)
  /// Total GST rate (CGST + SGST, or IGST) in percent.
  gstRate     Decimal  @default(0) @map("gst_rate") @db.Decimal(5, 2)
  cessRate    Decimal  @default(0) @map("cess_rate") @db.Decimal(5, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products     Product[]
  rawMaterials RawMaterial[]
  company      Company       @relation("CompanyHsnCode", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@index([companyId, type])
  @@map("hsn_codes")
}

/// GST slab with optional cess (P1-08). Seeded with the statutory slabs; tenants may add cess variants.
model GstRate {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  name      String   @db.VarChar(40)
  rate      Decimal  @db.Decimal(5, 2)
  cessRate  Decimal  @default(0) @map("cess_rate") @db.Decimal(5, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyGstRate", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, rate, cessRate])
  @@map("gst_rates")
}

model Voucher {
  id              Int             @id @default(autoincrement())
  companyId       String          @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  voucherNo       String          @db.VarChar(30)
  type            VoucherType
  date            DateTime        @db.Date
  narration       String?         @db.VarChar(500)
  refDocType      String?         @db.VarChar(30)
  refDocId        String?         @db.VarChar(36)
  createdBy       String?         @db.VarChar(36)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           JournalItem[]
  businessPlaceId BigInt?         @map("business_place_id")
  businessPlace   BusinessPlace?  @relation("VoucherBusinessPlace", fields: [businessPlaceId], references: [id])
  /// P1-09: a cancelled voucher stays on file and is netted by its reversal.
  status          VoucherStatus   @default(POSTED)
  cancelledAt     DateTime?       @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy     String?         @map("cancelled_by") @db.VarChar(36)
  cancelReason    String?         @map("cancel_reason") @db.VarChar(255)
  reversalOfId    Int?            @unique @map("reversal_of_id")
  /// 0 while posted; set to the voucher's own id on cancellation so a document can be posted again.
  cancelSeq       Int             @default(0) @map("cancel_seq")
  reversalOf      Voucher?        @relation("VoucherReversal", fields: [reversalOfId], references: [id])
  reversedBy      Voucher?        @relation("VoucherReversal")
  yearEndClosing  YearEndClosing? @relation("YearEndClosingVoucher")

  company Company @relation("CompanyVoucher", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, refDocType, refDocId, cancelSeq])
  @@unique([companyId, voucherNo])
  @@index([refDocType, refDocId])
  @@map("vouchers")
}

model JournalItem {
  id             Int            @id @default(autoincrement())
  companyId      String         @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  voucherId      Int
  debitLedgerId  Int?
  creditLedgerId Int?
  debitAmount    Decimal        @default(0) @db.Decimal(14, 2)
  creditAmount   Decimal        @default(0) @db.Decimal(14, 2)
  narration      String?        @db.VarChar(255)
  /// P1-19: where this cost belongs. Null means unallocated, which the cost-centre P&L shows
  /// rather than hides — an unallocated pile is the thing that makes the report untrustworthy.
  costCentreId   String?        @map("cost_centre_id") @db.Uuid
  costCentre     CostCentre?    @relation(fields: [costCentreId], references: [id])
  voucher        Voucher        @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  debitLedger    AccountLedger? @relation("DebitItems", fields: [debitLedgerId], references: [id])
  creditLedger   AccountLedger? @relation("CreditItems", fields: [creditLedgerId], references: [id])

  company Company @relation("CompanyJournalItem", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([voucherId])
  @@index([debitLedgerId])
  @@index([creditLedgerId])
  @@index([companyId])
  @@map("journal_items")
}

model SalesReturn {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  returnNo        String            @db.VarChar(30)
  returnDate      DateTime          @db.Date
  customerId      String            @db.Uuid
  salesInvoiceId  String?           @db.Uuid
  reason          String?           @db.VarChar(255)
  refundMode      String            @default("CREDIT_NOTE") @db.VarChar(20) // CREDIT_NOTE | CASH | BANK
  kind            ReturnKind        @default(GOODS_RETURN)
  /// GST credit note number from the CREDIT_NOTE series (GSTR-1 CDNR).
  creditNoteNo    String?           @map("credit_note_no") @db.VarChar(30)
  businessPlaceId BigInt?           @map("business_place_id")
  placeOfSupply   String?           @map("place_of_supply") @db.VarChar(2)
  supplyType      SupplyType        @default(INTRA_STATE) @map("supply_type")
  customerGstin   String?           @map("customer_gstin") @db.VarChar(15)
  cgstAmount      Decimal           @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount      Decimal           @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount      Decimal           @default(0) @map("igst_amount") @db.Decimal(14, 2)
  subTotal        Decimal           @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal           @default(0) @db.Decimal(14, 2)
  grandTotal      Decimal           @db.Decimal(14, 2)
  status          String            @default("APPROVED") @db.VarChar(20)
  narration       String?           @db.VarChar(500)
  createdBy       String?           @db.VarChar(36)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  customer        Customer          @relation(fields: [customerId], references: [id])
  salesInvoice    SalesInvoice?     @relation(fields: [salesInvoiceId], references: [id])
  items           SalesReturnItem[]
  businessPlace   BusinessPlace?    @relation("SalesReturnBusinessPlace", fields: [businessPlaceId], references: [id])
  /// Cancelled documents stay on file (MCA Rule 3(1)); their vouchers are reversed (P1-09).
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy     String?           @map("cancelled_by") @db.VarChar(36)
  cancelReason    String?           @map("cancel_reason") @db.VarChar(255)

  company Company @relation("CompanySalesReturn", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, returnNo])
  @@index([customerId])
  @@index([companyId])
  @@index([salesInvoiceId])
  @@map("sales_returns")
}

