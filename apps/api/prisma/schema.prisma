model PayrollRun {
  id               Int             @id @default(autoincrement())
  companyId        String          @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  runCode          String
  period           String
  type             String
  status           String          @default("DRAFT")
  employeeCategory String          @default("ALL")
  calendarDays     Int             @default(31)
  totalEmployees   Int             @default(0)
  totalGross       Decimal         @default(0) @db.Decimal(14, 2)
  totalNetSalary   Decimal         @default(0) @db.Decimal(14, 2)
  totalPfEmployee  Decimal         @default(0) @db.Decimal(14, 2)
  totalPfEmployer  Decimal         @default(0) @db.Decimal(14, 2)
  totalEsiEmployee Decimal         @default(0) @db.Decimal(14, 2)
  totalEsiEmployer Decimal         @default(0) @db.Decimal(14, 2)
  createdById      String
  approvedById     String?
  lockedById       String?
  createdAt        DateTime        @default(now())
  approvedAt       DateTime?
  lockedAt         DateTime?
  results          PayrollResult[]

  company Company @relation("CompanyPayrollRun", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, runCode])
  @@map("payroll_runs")
}

model PayrollResult {
  id                      Int                     @id @default(autoincrement())
  companyId               String                  @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  payrollRunId            Int
  employeeId              BigInt
  employeeCode            String
  employeeName            String
  department              String
  salaryType              String
  totalDays               Int                     @default(0)
  presentDays             Decimal                 @default(0) @db.Decimal(10, 2)
  absentDays              Decimal                 @default(0) @db.Decimal(10, 2)
  lopDays                 Decimal                 @default(0) @db.Decimal(10, 2)
  halfDays                Decimal                 @default(0) @db.Decimal(10, 2)
  dailyRate               Decimal                 @default(0) @db.Decimal(14, 2)
  earnedSalary            Decimal                 @default(0) @db.Decimal(14, 2)
  grossSalary             Decimal                 @default(0) @db.Decimal(14, 2)
  otHours                 Decimal                 @default(0) @db.Decimal(10, 2)
  otPay                   Decimal                 @default(0) @db.Decimal(14, 2)
  /// Overtime hours this run pushed past the OSH Code's 125-hour quarterly cap (P2-16), from the
  /// running total in `OvertimeQuarterPeriod`. Zero means no breach; paid either way — the cap is
  /// a compliance breach for the company, never a reason to withhold OT pay already earned.
  otHoursOverCap          Decimal                 @default(0) @map("ot_hours_over_cap") @db.Decimal(10, 2)
  pfWage                  Decimal                 @default(0) @db.Decimal(14, 2)
  employeePf              Decimal                 @default(0) @db.Decimal(14, 2)
  employerPf              Decimal                 @default(0) @db.Decimal(14, 2)
  employeeEsi             Decimal                 @default(0) @db.Decimal(14, 2)
  employerEsi             Decimal                 @default(0) @db.Decimal(14, 2)
  pfApplicable            Boolean                 @default(false)
  esiApplicable           Boolean                 @default(false)
  professionalTax         Decimal                 @default(0) @db.Decimal(14, 2)
  /// Tax on salary for the month (P2-02): a twelfth of the projected annual liability from
  /// `statutory.calc`'s `salaryTax`, on the employee's declared regime.
  salaryTds               Decimal                 @default(0) @map("salary_tds") @db.Decimal(14, 2)
  permissionDeduction     Decimal                 @default(0) @db.Decimal(14, 2)
  salaryAdvance           Decimal                 @default(0) @db.Decimal(14, 2)
  loanRecovery            Decimal                 @default(0) @db.Decimal(14, 2)
  otherDeductions         Decimal                 @default(0) @db.Decimal(14, 2)
  totalDeductions         Decimal                 @default(0) @db.Decimal(14, 2)
  netSalary               Decimal                 @default(0) @db.Decimal(14, 2)
  paymentMode             String                  @default("CASH")
  hasVariance             Boolean                 @default(false)
  varianceNote            String?
  lateEntryDeduction      Decimal                 @default(0) @db.Decimal(14, 2)
  cashInHand              Decimal                 @default(0) @db.Decimal(14, 2)
  payrollRun              PayrollRun              @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee                Employee                @relation(fields: [employeeId], references: [id])
  recoveredFineDeductions EmployeeFineDeduction[] @relation("FineDeductionRecovery")

  company Company @relation("CompanyPayrollResult", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([payrollRunId])
  @@index([employeeId])
  @@index([companyId])
  @@map("payroll_results")
}

model SalaryAdvance {
