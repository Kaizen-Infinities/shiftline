generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id            BigInt         @id @default(autoincrement())
  empCode       String         @unique
  fullName      String
  mobile        String?        @db.VarChar(20)
  email         String?        @unique @db.VarChar(100)
  dateOfJoining DateTime?
  departmentId  Int?
  status        EmployeeStatus @default(active)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
  createdBy     String?
  updatedBy     String?

  // Section 1: Basic Info
  photoUrl      String?
  gender        Gender?
  dateOfBirth   DateTime?      @db.Date
  bloodGroup    String?
  maritalStatus MaritalStatus?

  // Section 2: Contact Info
  personalMobile         String? @db.VarChar(20)
  personalEmail          String? @db.VarChar(100)
  emergencyContactName   String?
  emergencyContactNumber String? @db.VarChar(20)

  // Section 3: Family Details
  fatherName           String?
  motherName           String?
  spouseName           String?
  guardianName         String?
  guardianRelationship String?

  // Section 4: Identity Documents
  aadhaarNumber  String? @unique
  panNumber      String? @unique
  drivingLicense String?
  voterId        String?

  // Section 5: Address
  permanentAddressLine1 String?
  permanentAddressLine2 String?
  permanentCity         String?
  permanentState        String?
  permanentPincode      String?
  presentAddressLine1   String?
  presentAddressLine2   String?
  presentCity           String?
  presentState          String?
  presentPincode        String?

  // Section 6: Official Info
  designation  String?
  employeeType EmployeeType?
  roleId       Int?

  // Section 7: Joining Details
  relievingDate      DateTime?
  previousExperience String?
  probationPeriod    Int?
  noticePeriod       Int?

  // Section 8: Shift
  shiftId String?

  // Section 9: Payroll & Statutory
  salaryType        SalaryType?
  basicSalary       Decimal?    @db.Decimal(12, 2)
  grossSalary       Decimal?    @db.Decimal(12, 2)
  pfApplicable      Boolean     @default(false)
  pfNumber          String?     @unique
  uanNumber         String?     @unique
  esiApplicable     Boolean     @default(false)
  esiNumber         String?     @unique
  professionalTax   Boolean     @default(false)
  tdsApplicable     Boolean     @default(false)
  paymentMode       String?     @default("BANK")
  bankName          String?
  bankBranch        String?
  accountNumber     String?
  ifscCode          String?
  accountHolderName String?


  createdByUser              User?                        @relation("EmployeeCreatedBy", fields: [createdBy], references: [userId])
  department                 Department?                  @relation(fields: [departmentId], references: [id])
  updatedByUser              User?                        @relation("EmployeeUpdatedBy", fields: [updatedBy], references: [userId])
  machineAssignmentOperators MachineAssignmentOperator[]
  inchargeAssignments        MachineOperationAssignment[] @relation("InchargeEmployeeAssignments")
  stores                     Store[]
  user                       User?
  role                       Role?                        @relation(fields: [roleId], references: [id])
  shift                      Shift?                       @relation(fields: [shiftId], references: [shiftCode])
  payrollConfig              EmployeePayrollConfig?
  payrollResults             PayrollResult[]
  salaryAdvances             SalaryAdvance[]
  permanentDeductions        EmployeePermanentDeduction[]

  @@index([departmentId])
  @@index([roleId])
  @@index([status])
  @@index([shiftId])
  @@map("employees")
}

model Admin {
  id                  BigInt               @id @default(autoincrement())
  fullName            String
  email               String?              @unique
  phone               String?
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  username            String               @unique
  passwordHash        String
  status              UserStatus           @default(active)
  lastLoginAt         DateTime?            @db.Timestamptz(6)
  roleId              Int?
  role                Role?                @relation(fields: [roleId], references: [id])
  auditLogs           AuditLog[]           @relation("ChangedByAdmin")
  loginAttempts       LoginAttempt[]
  passwordResetTokens PasswordResetToken[]
  userSessions        UserSession[]

  @@map("admins")
}

model User {
  userId                String               @id @default(uuid())
  username              String               @unique
  fullName              String
  email                 String?              @unique
  passwordHash          String
  employeeId            BigInt?              @unique
  roleId                Int?
  status                UserStatus           @default(active)
  mustChangePw          Boolean              @default(false)
  failedAttempts        Int                  @default(0)
  lockedUntil           DateTime?            @db.Timestamptz(6)
  lastLoginAt           DateTime?            @db.Timestamptz(6)
  lastLoginIp           String?
  mfaEnabled            Boolean              @default(false)
  mfaSecret             String?
  createdBy             String?
  createdOn             DateTime             @default(now()) @db.Timestamptz(6)
  updatedOn             DateTime             @updatedAt @db.Timestamptz(6)
  auditLogs             AuditLog[]           @relation("ChangedBy")
  createdEmployees      Employee[]           @relation("EmployeeCreatedBy")
  updatedEmployees      Employee[]           @relation("EmployeeUpdatedBy")
  expensesCreated       Expense[]            @relation("ExpenseCreatedBy")
  loginAttempts         LoginAttempt[]
  passwordResetTokens   PasswordResetToken[]
  createdSalesOrders         SalesOrder[]         @relation("SalesOrderCreatedBy")
  sessions                   UserSession[]
  employee              Employee?            @relation(fields: [employeeId], references: [id])
  role                  Role?                @relation(fields: [roleId], references: [id])

  @@index([status])
  @@index([employeeId])
  @@index([roleId])
  @@map("users")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String?
  adminId      BigInt?
  sessionToken String    @unique
  ipAddress    String?
  userAgent    String?
  deviceLabel  String?
  loginAt      DateTime  @default(now()) @db.Timestamptz(6)
  logoutAt     DateTime? @db.Timestamptz(6)
  expiresAt    DateTime  @db.Timestamptz(6)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  admin        Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([adminId, isActive])
  @@index([sessionToken])
  @@map("user_sessions")
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String?
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz(6)
  usedAt      DateTime? @db.Timestamptz(6)
  used        Boolean   @default(false)
  requestedIp String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  adminId     BigInt?
  admin       Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model LoginAttempt {
  id            BigInt   @id @default(autoincrement())
  username      String
  userId        String?
  ipAddress     String
  success       Boolean
  failureReason String?
  userAgent     String?
  attemptedAt   DateTime @default(now()) @db.Timestamptz(6)
  adminId       BigInt?
  admin         Admin?   @relation(fields: [adminId], references: [id])
  user          User?    @relation(fields: [userId], references: [userId])

  @@index([username])
  @@index([ipAddress])
  @@index([attemptedAt])
  @@index([userId])
  @@map("login_attempts")
}

model AuditLog {
  id                BigInt      @id @default(autoincrement())
  entityName        String
  entityId          String?
  action            AuditAction
  oldValues         Json?
  newValues         Json?
  changedBy         String?
  ipAddress         String?
  userAgent         String?
  changedAt         DateTime    @default(now()) @db.Timestamptz(6)
  changedByAdmin    BigInt?
  changedByAdminRel Admin?      @relation("ChangedByAdmin", fields: [changedByAdmin], references: [id])
  changedByUser     User?       @relation("ChangedBy", fields: [changedBy], references: [userId])

  @@index([entityName, entityId])
  @@index([changedBy])
  @@map("audit_log")
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique
  module          String
  action          String
  scope           String?
  description     String?
  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id                         Int                          @id @default(autoincrement())
  code                       String                       @unique @default("ADMIN")
  name                       String
  description                String?
  isSystem                   Boolean                      @default(true)
  status                     RoleStatus                   @default(active)
  createdAt                  DateTime                     @default(now()) @db.Timestamptz(6)
  Admin                      Admin[]
  machineAssignmentOperators MachineAssignmentOperator[]
  inchargeRoleAssignments    MachineOperationAssignment[] @relation("InchargeRoleAssignments")
  rolePermissions            RolePermission[]
  users                      User[]
  employees                  Employee[]

  @@map("roles")
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Department {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]

  @@map("departments")
}

model CustomerType {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(100)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  customers   Customer[]

  @@map("customer_types")
}

model CustomerGrade {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(100)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  customers   Customer[]

  @@map("customer_grades")
}

model Customer {

  email                String?                  @db.VarChar(120)
  gstin                String?                  @db.VarChar(15)
  creditLimit          Decimal                  @default(0) @db.Decimal(14, 2)

  outstandingAmount    Decimal                  @default(0) @db.Decimal(14, 2)
  createdBy            String
  createdAt            DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(6)

  companyId            String                   @db.Uuid
  customerCode         String                   @db.VarChar(20)
  deletedAt            DateTime?                @db.Timestamptz(6)
  displayName          String?                  @db.VarChar(80)
  firmName             String                   @db.VarChar(160)

  mobile               Json?                    @map("mobile")

  searchTsv            Unsupported("tsvector")?

  status               String                   @default("Active") @db.VarChar(20)

  updatedBy            String?
  id                   String                   @id @default(uuid()) @db.Uuid
  openingBalance       Decimal                  @default(0) @db.Decimal(14, 2)
  openingBalanceType   String                   @default("DEBIT") @db.VarChar(10)
  customerTypeId       Int?
  customerGradeId      Int?
  customerType         CustomerType?            @relation(fields: [customerTypeId], references: [id])
  customerGrade        CustomerGrade?           @relation(fields: [customerGradeId], references: [id])
  addresses            CustomerAddress[]
  company              Company                  @relation(fields: [companyId], references: [id])
  salesInvoices        SalesInvoice[]
  salesOrders          SalesOrder[]             @relation("CustomerSalesOrders")
  accountLedger        AccountLedger?
  salesReturns         SalesReturn[]

  @@unique([companyId, customerCode])
  @@index([companyId, status], map: "idx_cust_company_status")

  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(uuid()) @map("id")
  address    Json     @map("address")
  customerId String   @map("customer_id") @db.Uuid
  is_default Boolean  @default(false)
  label      String   @db.VarChar(40)
  state_code String   @db.VarChar(50)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model Company {
  id             String          @id @default(uuid()) @db.Uuid
  companyCode    String?         @unique @db.VarChar(20)
  companyName    String          @db.VarChar(160)
  legalName      String?         @db.VarChar(160)
  shortName      String?         @db.VarChar(60)
  gstin          String?         @db.VarChar(15)
  currencyCode   String          @default("INR") @db.VarChar(3)
  phone          String?         @db.VarChar(20)
  mobile         String?         @db.VarChar(1000)
  email          String?         @db.VarChar(120)
  website        String?         @db.VarChar(200)
  logoUrl        String?
  faviconUrl     String?
  addressLine1   String?         @db.VarChar(255)

  city           String?         @db.VarChar(100)
  state          String?         @db.VarChar(100)
  zipcode        String?         @db.VarChar(20)
  country        String?         @db.VarChar(100)
  isOnboarded    Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdBy      String?         @db.Uuid
  updatedBy      String?         @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  businessPlaces BusinessPlace[]
  customers      Customer[]
  expenses       Expense[]
  invoiceSetting InvoiceSetting?
  whatsappConfig WhatsappConfig?

  @@map("companies")
}

model WhatsappConfig {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @unique @db.Uuid
  phoneNumberId      String   @db.VarChar(50)
  wabaId             String   @db.VarChar(50)
  businessPhone      String   @db.VarChar(20)
  accessToken        String
  webhookVerifyToken String?  @db.VarChar(100)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)
  company            Company  @relation(fields: [companyId], references: [id])

  @@map("whatsapp_configs")
}

model EmailConfig {
  id           String   @id @default(uuid()) @db.Uuid
  smtpHost     String   @db.VarChar(200)
  smtpPort     Int
  smtpUsername String   @db.VarChar(200)
  smtpPassword String   @db.VarChar(200)
  fromEmail    String   @db.VarChar(200)
  fromName     String   @db.VarChar(160)
  encryption   String   @default("TLS") @db.VarChar(20)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@map("email_configs")
}

model BusinessPlace {
  id           BigInt            @id @default(autoincrement())
  companyId    String            @db.Uuid
  code         String            @db.VarChar(20)
  name         String            @db.VarChar(120)
  type         BusinessPlaceType
  gstPlaceCode String?           @db.VarChar(2)
  phone        String?           @db.VarChar(20)
  email        String?           @db.VarChar(120)
  isHeadOffice Boolean           @default(false)
  isActive     Boolean           @default(true)
  address      Json?
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(6)
  company      Company           @relation(fields: [companyId], references: [id])
  machines     Machine[]
  stores       Store[]

  @@map("business_places")
}

model Route {
  id        String     @id @default(uuid()) @db.Uuid
  routeCode String     @unique
  routeName String
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)


  @@map("routes")
}

model SupplierMaterialPrice {
  id            String    @id @default(uuid())
  supplierId    Int
  rawMaterialId String
  price         Decimal
  validFrom     DateTime
  validTo       DateTime?
  createdAt     DateTime  @default(now())
  supplier      Supplier  @relation(fields: [supplierId], references: [id])

  @@index([supplierId, rawMaterialId, validFrom, validTo])
}

model Supplier {
  mobile                Json?                   @map("mobile")
  email                 String?                 @map("email") @db.VarChar(120)
  gstin                 String?                 @map("gstin") @db.VarChar(15)
  pan                   String?                 @map("pan") @db.VarChar(10)
  altPhone              String?                 @map("alt_phone") @db.VarChar(15)
  billingAddressLine1   String                  @map("billing_address_line1") @db.VarChar(255)
  billingCity           String                  @map("billing_city") @db.VarChar(100)
  billingState          String                  @map("billing_state") @db.VarChar(100)
  billingPincode        String                  @map("billing_pincode") @db.VarChar(20)
  billingCountry        String?                 @default("India") @map("billing_country") @db.VarChar(100)
  companyId             String                  @map("company_id")
  contactPerson         String?                 @map("contact_person") @db.VarChar(80)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy             String                  @map("created_by")
  deletedAt             DateTime?               @map("deleted_at") @db.Timestamptz(6)
  displayName           String?                 @map("display_name") @db.VarChar(80)
  gstRegType            String?                 @map("gst_reg_type") @db.VarChar(20)
  legalName             String                  @map("legal_name") @db.VarChar(160)
  minOrderQty           Decimal?                @map("min_order_qty") @db.Decimal(12, 3)
  stateCode             String                  @map("state_code") @db.VarChar(2)
  status                String                  @default("Active") @map("status") @db.VarChar(20)
  supplierCode          String                  @map("supplier_code") @db.VarChar(20)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy             String?                 @map("updated_by")
  whatsapp              String?                 @map("whatsapp") @db.VarChar(15)
  openingBalance        Decimal                 @default(0) @map("opening_balance") @db.Decimal(14, 2)
  openingBalanceType    String                  @default("CREDIT") @map("opening_balance_type") @db.VarChar(10)
  id                    Int                     @id @default(autoincrement())
  materialPrices        SupplierMaterialPrice[]
  expenses              Expense[]
  grnInvoices           GrnInvoice[]
  purchaseOrders        PurchaseOrder[]
  addresses             SupplierAddress[]
  accountLedger         AccountLedger?
  purchaseReturns       PurchaseReturn[]

  @@unique([companyId, supplierCode])
  @@index([legalName])
  @@index([status])
  @@map("suppliers")
}

model SupplierAddress {
  id         String   @id @default(uuid()) @map("id")
  address    Json     @map("address")
  supplierId Int      @map("supplier_id")
  is_default Boolean  @default(false)
  label      String   @db.VarChar(40)
  state_code String   @db.VarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_addresses")
}

model Shift {
  id                   Int                          @id @default(autoincrement())
  shiftCode            String                       @unique
  shiftName            String                       @unique
  startTime            String
  endTime              String
  breakDuration        Int?
  gracePeriod          Int?
  isActive             Boolean                      @default(true)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  dailyProductionPlans DailyProductionPlan[]
  HourlyProduction     HourlyProduction[]
  machineAssignments   MachineOperationAssignment[]
  productionWastages   ProductionWastage[]
  WeeklyMachineProgram WeeklyMachineProgram[]
  shiftRecords         ProductShiftRecord[]
  employees            Employee[]
  attendanceRecords    AttendanceRecord[]

  @@map("shifts")
}


model ProductImage {
  id        BigInt  @id @default(autoincrement())
  productId BigInt
  imageUrl  String
  isPrimary Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Product {
  id                        BigInt                     @id @default(autoincrement())
  productCode               String                     @unique
  productName               String
  description               String?
  uomId                     Int?
  capacityLitres            Decimal?                   @db.Decimal(6, 2)
  weightPerPiece            Decimal?                   @db.Decimal(10, 2)
  weightUom                 String                     @default("kg") @map("weight_uom") @db.VarChar(10)
  isActive                  Boolean                    @default(true)
  createdBy                 String?
  modifiedBy                String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  rate                      Decimal?                   @db.Decimal(12, 2)
  gradeRates                Json?                      @map("grade_rates")
  hsnCode                   String?
  minimumQty                String                     @default("0") @map("minimum_qty")
  productType               ProductType                @default(PRODUCTION) @map("product_type")
  categoryId                Int?                       @map("category_id")
  billOfMaterials           BillOfMaterial[]
  finishedGoodsStocks       FinishedGoodsStock[]
  finishedGoodsTransactions FinishedGoodsTransaction[]
  goodsDispatchItems        GoodsDispatchItem[]
  images                    ProductImage[]
  productionOrders          ProductionOrder[]
  productionSteps           ProductionStep[]
  productionWastages        ProductionWastage[]
  uom                       UnitOfMeasure?             @relation(fields: [uomId], references: [id], onDelete: Restrict)
  category                  Category?                  @relation(fields: [categoryId], references: [id])
  salesInvoiceItems         SalesInvoiceItem[]
  salesOrderItems           SalesOrderItem[]           @relation("SalesOrderItemProduct")
  salesReturnItems          SalesReturnItem[]
  StockAdjustmentItem       StockAdjustmentItem[]
  weeklyPrograms            WeeklyMachineProgram[]     @relation("ProductWeeklyPrograms")
  shiftRecords              ProductShiftRecord[]
  capacityHistories         ProductCapacityHistory[]
  usedInSalesProducts       SalesProductComponent[]

  @@index([uomId])
  @@index([productName])
  @@map("products")
}

// A separately-catalogued sellable item (e.g. "3L Container" kit), distinct
// from the Production Product catalog. Assembled from Production Products
// via SalesProductComponent, and carries its own price/stock like any
// sellable item.
model SalesProduct {
  id               BigInt   @id @default(autoincrement())
  salesProductCode String   @unique @map("sales_product_code")
  salesProductName String   @map("sales_product_name")
  description      String?
  hsnCode          String?  @map("hsn_code")
  rate             Decimal? @db.Decimal(12, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdBy        String?  @map("created_by")
  modifiedBy       String?  @map("modified_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  components SalesProductComponent[]
  stocks     SalesProductStock[]

  @@index([salesProductName])
  @@map("sales_products")
}

model SalesProductStock {
  storeId        String   @map("store_id") @db.VarChar(20)
  salesProductId BigInt   @map("sales_product_id")
  onHandQty      Decimal  @default(0) @map("on_hand_qty") @db.Decimal(14, 3)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  salesProduct SalesProduct @relation(fields: [salesProductId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [storeId])

  @@id([storeId, salesProductId])
  @@index([storeId])
  @@index([salesProductId])
  @@map("sales_product_stocks")
}

// Links a Sales Product (e.g. "3L Container") to the Production Products it
// is assembled from (e.g. "Container" + "Lid"), each with its own quantity.
model SalesProductComponent {
  id                 BigInt   @id @default(autoincrement())
  salesProductId     BigInt   @map("sales_product_id")
  componentProductId BigInt   @map("component_product_id")
  quantity           Decimal  @map("quantity") @db.Decimal(12, 3)
  remarks            String?  @db.VarChar(255)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  salesProduct     SalesProduct @relation(fields: [salesProductId], references: [id], onDelete: Cascade)
  componentProduct Product      @relation(fields: [componentProductId], references: [id])

  @@unique([salesProductId, componentProductId])
  @@index([salesProductId])
  @@index([componentProductId])
  @@map("sales_product_components")
}

model ProductionStep {
  id        BigInt  @id @default(autoincrement())
  productId BigInt  @map("product_id")
  stepKey   String  @map("step_key")
  stepOrder Int     @map("step_order")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("production_steps")
}

model UnitOfMeasure {
  id          Int       @id @default(autoincrement())
  uomCode     String    @unique
  uomName     String
  description String?
  isActive    Boolean   @default(true)
