model GrnInvoice {
  id                   String              @id @default(uuid()) @db.Uuid
  companyId            String              @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  grnNumber            String              @map("grn_number")
  invoiceNo            String              @map("invoice_no")
  grnDate              DateTime            @map("grn_date") @db.Date
  supplierId           Int                 @map("supplier_id")
  storeId              String              @map("store_id") @db.VarChar(20)
  billingAddressLine1  String              @map("billing_address_line1")
  billingCity          String              @map("billing_city")
  billingState         String              @map("billing_state")
  billingPincode       String              @map("billing_pincode")
  billingCountry       String?             @default("India") @map("billing_country")
  sameAsBilling        Boolean             @default(false) @map("same_as_billing")
  updateStock          Boolean             @default(false) @map("update_stock")
  shippingAddressLine1 String              @map("shipping_address_line1")
  shippingCity         String              @map("shipping_city")
  shippingState        String              @map("shipping_state")
  shippingPincode      String              @map("shipping_pincode")
  shippingCountry      String?             @default("India") @map("shipping_country")
  receiveDate          DateTime?           @map("receive_date") @db.Date
  billDueDate          DateTime?           @map("bill_due_date") @db.Date
  challanNo            String?             @map("challan_no")
  transport            String?
  eWayBill             String?             @map("eway_bill")
  invoiceImage         String?             @map("invoice_image")
  remarks              String?
  discountType         DiscountType        @default(PERCENT) @map("discount_type")
  discountValue        Decimal             @default(0) @map("discount_value") @db.Decimal(12, 2)
  roundingAdjust       Decimal             @default(0) @map("rounding_adjust") @db.Decimal(12, 2)
  paymentStatus        String              @default("Unpaid") @map("payment_status")
  paymentMethod        String?             @map("payment_method")
  referenceNumber      String?             @map("reference_number")
  paymentDate          DateTime?           @map("payment_date") @db.Date
  payments             Json?               @default("[]") @map("payments")
  subtotal             Decimal             @default(0) @db.Decimal(12, 2)
  totalDiscount        Decimal             @default(0) @db.Decimal(12, 2)
  totalTax             Decimal             @default(0) @db.Decimal(12, 2)
  totalCgst            Decimal             @default(0) @db.Decimal(12, 2)
  totalSgst            Decimal             @default(0) @db.Decimal(12, 2)
  totalIgst            Decimal             @default(0) @db.Decimal(12, 2)
  netAmount            Decimal             @default(0) @db.Decimal(12, 2)
  totalCess            Decimal             @default(0) @db.Decimal(12, 2)
  /// P2-05: TDS withheld from this bill; the section that decided it, and what it came to. The
  /// payable to the supplier is netAmount minus this.
  tdsSectionCode       String?             @map("tds_section_code") @db.VarChar(20)
  tdsAmount            Decimal             @default(0) @map("tds_amount") @db.Decimal(14, 2)
  businessPlaceId      BigInt?             @map("business_place_id")
  placeOfSupply        String?             @map("place_of_supply") @db.VarChar(2)
  supplyType           SupplyType          @default(INTRA_STATE) @map("supply_type")
  supplierGstin        String?             @map("supplier_gstin") @db.VarChar(15)
  /// Tax is paid by the recipient under reverse charge; the supplier is credited net of GST.
  reverseCharge        Boolean             @default(false) @map("reverse_charge")
  supplierInvoiceDate  DateTime?           @map("supplier_invoice_date") @db.Date
  /// A foreign-currency bill keeps both: the books are in INR at the rate it posted at (P2-06,
  /// mirroring what P1-14 added to SalesInvoice).
  currencyCode         String              @default("INR") @map("currency_code") @db.VarChar(3)
  exchangeRate         Decimal             @default(1) @map("exchange_rate") @db.Decimal(14, 6)
  foreignTotal         Decimal?            @map("foreign_total") @db.Decimal(14, 2)
  createdBy            String?             @map("created_by")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  poId                 String?             @map("po_id") @db.Uuid
  items                GrnInvoiceItem[]
  paymentRecords       GrnInvoicePayment[]
  purchaseOrder        PurchaseOrder?      @relation(fields: [poId], references: [id])
  store                Store               @relation(fields: [companyId, storeId], references: [companyId, storeId])
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  purchaseReturns      PurchaseReturn[]
  businessPlace        BusinessPlace?      @relation("GrnInvoiceBusinessPlace", fields: [businessPlaceId], references: [id])
  /// Cancelled documents stay on file (MCA Rule 3(1)); their vouchers are reversed (P1-09).
  cancelledAt          DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy          String?             @map("cancelled_by") @db.VarChar(36)
  cancelReason         String?             @map("cancel_reason") @db.VarChar(255)
  status               String              @default("POSTED") @db.VarChar(20)

  company Company @relation("CompanyGrnInvoice", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, grnNumber])
  @@index([supplierId])
  @@index([storeId])
  @@index([companyId])
  @@index([poId])
  @@map("grn_invoices")
}

model GrnInvoiceItem {
  id             String      @id @default(uuid()) @db.Uuid
  companyId      String      @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  grnInvoiceId   String      @map("grn_invoice_id") @db.Uuid
  productId      String      @map("product_id")
  description    String
  uom            String
  quantity       Decimal     @db.Decimal(12, 3)
  unitPrice      Decimal     @map("unit_price") @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @map("discount_amount") @db.Decimal(14, 2)
  tax            Decimal     @default(0) @db.Decimal(5, 2)
  taxableAmount  Decimal     @default(0) @map("taxable_amount") @db.Decimal(14, 2)
  cgstRate       Decimal     @default(0) @map("cgst_rate") @db.Decimal(5, 2)
  cgstAmount     Decimal     @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstRate       Decimal     @default(0) @map("sgst_rate") @db.Decimal(5, 2)
  sgstAmount     Decimal     @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstRate       Decimal     @default(0) @map("igst_rate") @db.Decimal(5, 2)
  igstAmount     Decimal     @default(0) @map("igst_amount") @db.Decimal(14, 2)
  lineTotal      Decimal     @map("line_total") @db.Decimal(12, 2)
  hsnCode        String?     @map("hsn_code") @db.VarChar(8)
  cessRate       Decimal     @default(0) @map("cess_rate") @db.Decimal(5, 2)
  cessAmount     Decimal     @default(0) @map("cess_amount") @db.Decimal(14, 2)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  grnInvoice     GrnInvoice  @relation(fields: [grnInvoiceId], references: [id], onDelete: Cascade)
  rawMaterial    RawMaterial @relation(fields: [companyId, productId], references: [companyId, rawMaterialId])

  company Company @relation("CompanyGrnInvoiceItem", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([grnInvoiceId])
  @@index([productId])
  @@index([companyId])
  @@map("grn_invoice_items")
}

model GrnInvoicePayment {
  id              String     @id @default(uuid()) @db.Uuid
  companyId       String     @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  grnInvoiceId    String     @map("grn_invoice_id") @db.Uuid
  amount          Decimal    @db.Decimal(14, 2)
  paymentMethod   String     @map("payment_method") @db.VarChar(50)
  referenceNumber String?    @map("reference_number") @db.VarChar(100)
  paymentDate     DateTime   @map("payment_date") @db.Date
  recordedBy      String?    @map("recorded_by") @db.VarChar(36)
  voucherPosted   Boolean    @default(false) @map("voucher_posted")
  sourceVoucherId String?    @map("source_voucher_id") @db.VarChar(36)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  grnInvoice      GrnInvoice @relation(fields: [grnInvoiceId], references: [id], onDelete: Cascade)

  company Company @relation("CompanyGrnInvoicePayment", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([grnInvoiceId])
  @@index([companyId])
  @@map("grn_invoice_payments")
}

model ProductionWastage {
  id                     BigInt            @id @default(autoincrement())
  companyId              String            @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  wastageNo              String            @map("wastage_no") @db.VarChar(30)
  wastageDate            DateTime          @map("wastage_date") @db.Date
  productionOrderId      String            @map("production_order_id") @db.VarChar(20)
  hourlyProductionId     BigInt?           @map("hourly_production_id")
  machineId              String            @map("machine_id") @db.VarChar(20)
  shiftId                String            @map("shift_id") @db.VarChar(20)
  productId              BigInt            @map("product_id")
  rawMaterialId          String?           @map("raw_material_id") @db.VarChar(20)
  wastageType            WastageType       @map("wastage_type")
  quantity               Decimal           @map("quantity") @db.Decimal(18, 3)
  uom                    String            @db.VarChar(10)
  estimatedValue         Decimal?          @map("estimated_value") @db.Decimal(18, 2)
  reason                 String?           @db.VarChar(255)
  correctiveAction       String?           @map("corrective_action") @db.VarChar(255)
  remarks                String?           @db.VarChar(255)
  isRecyclable           Boolean           @default(false) @map("is_recyclable")
  sentForRework          Boolean           @default(false) @map("sent_for_rework")
  approvedBy             String?           @map("approved_by") @db.VarChar(36)
  approvedAt             DateTime?         @map("approved_at")
  status                 WastageStatus     @default(DRAFT)
  createdBy              String            @map("created_by") @db.VarChar(36)
  updatedBy              String?           @map("updated_by") @db.VarChar(36)
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  targetWastageProductId String?           @map("target_wastage_product_id") @db.VarChar(20)
  storeId                String?           @map("store_id") @db.VarChar(20)
  categoryId             Int?              @map("category_id")
  hourlyProduction       HourlyProduction? @relation(fields: [hourlyProductionId], references: [hourlyProductionId])
  machine                Machine           @relation(fields: [companyId, machineId], references: [companyId, machineId], onDelete: Cascade)
  product                Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productionOrder        ProductionOrder   @relation(fields: [companyId, productionOrderId], references: [companyId, productionOrderId], onDelete: Cascade)
  rawMaterial            RawMaterial?      @relation(fields: [companyId, rawMaterialId], references: [companyId, rawMaterialId])
  shift                  Shift             @relation(fields: [companyId, shiftId], references: [companyId, shiftCode], onDelete: Cascade)
  store                  Store?            @relation(fields: [companyId, storeId], references: [companyId, storeId])
  targetWastageProduct   RawMaterial?      @relation("TargetWastageProduct", fields: [companyId, targetWastageProductId], references: [companyId, rawMaterialId])
  category               Category?         @relation(fields: [categoryId], references: [id])

  company Company @relation("CompanyProductionWastage", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, wastageNo])
  @@index([productionOrderId])
  @@index([hourlyProductionId])
  @@index([machineId])
  @@index([shiftId])
  @@index([productId])
  @@index([wastageDate])
  @@map("production_wastages")
}

model StockAdjustment {
  id                BigInt                @id @default(autoincrement()) @map("adj_id")
  companyId         String                @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  adjustmentNumber  String                @map("adjustment_number") @db.VarChar(50)
  adjustmentDate    DateTime              @map("adjustment_date")
  adjustmentType    String                @default("STOCK_INCREASE") @map("adjustment_type") @db.VarChar(40)
  reason            String?               @db.VarChar(255)
  status            AdjustmentStatus      @default(DRAFT)
  approvedBy        String?               @map("approved_by") @db.VarChar(36)
  approvedAt        DateTime?             @map("approved_at")
  createdBy         String?               @map("created_by") @db.VarChar(36)
  updatedBy         String?               @map("updated_by") @db.VarChar(36)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  sourceDocument    String?               @map("source_document") @db.VarChar(50)
  sourceDocId       String?               @map("source_doc_id") @db.VarChar(50)
  autoGenerated     Boolean               @default(false) @map("auto_generated")
  type              String?               @map("type") @db.VarChar(50)
  productionOrderId String?               @map("production_order_id") @db.VarChar(20)
  items             StockAdjustmentItem[]
  productionOrder   ProductionOrder?      @relation(fields: [companyId, productionOrderId], references: [companyId, productionOrderId])

  company Company @relation("CompanyStockAdjustment", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, adjustmentNumber])
  @@index([adjustmentDate])
  @@index([status])
  @@index([adjustmentType])
  @@index([productionOrderId])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id                BigInt           @id @default(autoincrement()) @map("adj_item_id")
  companyId         String           @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  stockAdjustmentId BigInt           @map("stock_adjustment_id")
  itemType          ItemCategoryType @map("item_type")
  rawMaterialId     String?          @map("raw_material_id") @db.VarChar(20)
  productItemId     BigInt?          @map("product_item_id")
  storeId           String           @map("store_id") @db.VarChar(20)
  currentQty        Decimal          @map("current_qty") @db.Decimal(14, 3)
  adjustedQty       Decimal          @map("adjusted_qty") @db.Decimal(14, 3)
  difference        Decimal          @map("difference") @db.Decimal(14, 3)
  remarks           String?          @db.VarChar(255)
  unitCost          Decimal?         @map("unit_cost") @db.Decimal(14, 2)
  batchNo           String?          @map("batch_no") @db.VarChar(40)
  product           Product?         @relation(fields: [productItemId], references: [id])
  rawMaterial       RawMaterial?     @relation(fields: [companyId, rawMaterialId], references: [companyId, rawMaterialId])
  stockAdjustment   StockAdjustment  @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  store             Store            @relation(fields: [companyId, storeId], references: [companyId, storeId])

  company Company @relation("CompanyStockAdjustmentItem", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([stockAdjustmentId])
  @@index([storeId])
  @@index([companyId])
  @@map("stock_adjustment_items")
}

model ProductionOrderHistory {
  id                BigInt          @id @default(autoincrement())
  companyId         String          @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  productionOrderId String          @map("production_order_id") @db.VarChar(20)
  fromStatus        String?         @map("from_status") @db.VarChar(30)
  toStatus          String          @map("to_status") @db.VarChar(30)
  changedAt         DateTime        @default(now()) @map("changed_at") @db.Timestamptz(6)
  changedBy         String?         @map("changed_by") @db.VarChar(36)
  remarks           String?         @db.VarChar(500)
  action            String?         @map("action") @db.VarChar(100)
  metadata          Json?           @map("metadata")
  productionOrder   ProductionOrder @relation(fields: [companyId, productionOrderId], references: [companyId, productionOrderId], onDelete: Cascade)

  company Company @relation("CompanyProductionOrderHistory", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([productionOrderId])
  @@index([changedAt])
  @@index([companyId])
  @@map("production_order_history")
}

model Expense {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  expenseNumber   String         @db.VarChar(30)
  expenseCategory String         @db.VarChar(60)
  date            DateTime       @db.Date
  expense         String         @db.VarChar(120)
  amount          Decimal        @db.Decimal(12, 2)
  description     String?
  paymentMethod   String         @db.VarChar(50)
  status          String         @default("Draft") @db.VarChar(30)
  notes           String?
  receiptInvoice  String?        @db.VarChar(255)
  supplierId      Int?
  businessPlaceId BigInt?        @map("business_place_id")
  vendorGstin     String?        @map("vendor_gstin") @db.VarChar(15)
  hsnCode         String?        @map("hsn_code") @db.VarChar(8)
  /// Value before GST; `amount` stays the total payable.
  taxableAmount   Decimal?       @map("taxable_amount") @db.Decimal(12, 2)
  gstRate         Decimal        @default(0) @map("gst_rate") @db.Decimal(5, 2)
  cgstAmount      Decimal        @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount      Decimal        @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount      Decimal        @default(0) @map("igst_amount") @db.Decimal(12, 2)
  supplyType      SupplyType     @default(INTRA_STATE) @map("supply_type")
  reverseCharge   Boolean        @default(false) @map("reverse_charge")
  /// Input credit may be claimed (false for blocked credits under s.17(5)).
  itcEligible     Boolean        @default(true) @map("itc_eligible")
  tdsSection      String?        @map("tds_section") @db.VarChar(10)
  tdsRate         Decimal        @default(0) @map("tds_rate") @db.Decimal(5, 2)
  tdsAmount       Decimal        @default(0) @map("tds_amount") @db.Decimal(12, 2)
  /// Expense claims (P1-10d): who approved or rejected, and why it was rejected.
  approvedBy      String?        @map("approved_by") @db.VarChar(36)
  approvedAt      DateTime?      @map("approved_at") @db.Timestamptz(6)
  rejectReason    String?        @map("reject_reason") @db.VarChar(255)
  createdBy       String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)
  user            User?          @relation("ExpenseCreatedBy", fields: [createdBy], references: [userId])
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  businessPlace   BusinessPlace? @relation("ExpenseBusinessPlace", fields: [businessPlaceId], references: [id])
  /// Cancelled documents stay on file (MCA Rule 3(1)); their vouchers are reversed (P1-09).
  cancelledAt     DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy     String?        @map("cancelled_by") @db.VarChar(36)
  cancelReason    String?        @map("cancel_reason") @db.VarChar(255)

  company Company @relation("CompanyExpense", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, expenseNumber])
  @@map("expenses")
}

model InvoiceSetting {
  id                    String   @id @default(uuid()) @db.Uuid
  companyId             String   @unique @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  invoicePrefix         String   @default("INV") @map("invoice_prefix") @db.VarChar(20)
  sequenceLength        Int      @default(4) @map("sequence_length")
  currentSequenceNumber Int      @default(1) @map("current_sequence_number")
  financialYearStart    DateTime @map("financial_year_start") @db.Date
  financialYearEnd      DateTime @map("financial_year_end") @db.Date
  autoFinancialYear     Boolean  @default(true) @map("auto_financial_year")
  formatTemplate        String   @default("{PREFIX}-{FY}-{SEQ}") @map("format_template") @db.VarChar(100)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyInvoiceSetting", fields: [companyId], references: [id], onDelete: Restrict)

  @@map("invoice_settings")
}

model SalesInvoice {
  id                    String                 @id @default(uuid()) @db.Uuid
  companyId             String                 @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  invoiceNo             String                 @map("invoice_no")
  invoiceDate           DateTime               @map("invoice_date") @db.Date
  dueDate               DateTime?              @map("due_date") @db.Date
  status                String                 @default("DRAFT")
  customerId            String                 @map("customer_id") @db.Uuid
  notes                 String?
  subTotal              Decimal                @map("sub_total") @db.Decimal(14, 2)
  discountType          String?                @map("discount_type") @db.VarChar(10)
  discountValue         Decimal?               @map("discount_value") @db.Decimal(14, 2)
  totalDiscount         Decimal                @default(0) @map("total_discount") @db.Decimal(14, 2)
  taxTotal              Decimal                @map("tax_total") @db.Decimal(14, 2)
  grandTotal            Decimal                @map("grand_total") @db.Decimal(14, 2)
  createdBy             String?                @map("created_by")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  salesOrderId          Int?                   @map("sales_order_id")
  storeId               String?                @map("store_id") @db.VarChar(20)
  payments              Json?                  @default("[]") @map("payments")
  narration             String?                @db.VarChar(2000)
  transport             Json?                  @map("transport")
  numberOfBundle        Int?                   @map("number_of_bundle")
  billSundry            Json?                  @map("bill_sundry")
  shippingAddressLine1  String?                @map("shipping_address_line1") @db.VarChar(255)
  shippingCity          String?                @map("shipping_city") @db.VarChar(100)
  shippingState         String?                @map("shipping_state") @db.VarChar(100)
  shippingPincode       String?                @map("shipping_pincode") @db.VarChar(20)
  documentType          SalesDocumentType      @default(TAX_INVOICE) @map("document_type")
  businessPlaceId       BigInt?                @map("business_place_id")
  /// GST state code of the recipient (goods: where they are delivered).
  placeOfSupply         String?                @map("place_of_supply") @db.VarChar(2)
  supplyType            SupplyType             @default(INTRA_STATE) @map("supply_type")
  customerGstin         String?                @map("customer_gstin") @db.VarChar(15)
  reverseCharge         Boolean                @default(false) @map("reverse_charge")
  cessTotal             Decimal                @default(0) @map("cess_total") @db.Decimal(14, 2)
  /// Exports and SEZ supplies (P1-14): whether tax was charged, and the shipping bill that
  /// proves the goods left, which GSTR-1's EXP table carries.
  exportType            ExportType?            @map("export_type")
  lutNumber             String?                @map("lut_number") @db.VarChar(30)
  shippingBillNo        String?                @map("shipping_bill_no") @db.VarChar(20)
  shippingBillDate      DateTime?              @map("shipping_bill_date") @db.Date
  portCode              String?                @map("port_code") @db.VarChar(10)
  /// A foreign-currency document keeps both: the books are in INR at the rate it posted at.
  currencyCode          String                 @default("INR") @map("currency_code") @db.VarChar(3)
  exchangeRate          Decimal                @default(1) @map("exchange_rate") @db.Decimal(14, 6)
  foreignTotal          Decimal?               @map("foreign_total") @db.Decimal(14, 2)
  /// P2-05: TCS collected on this invoice (section 394, e.g. 206C(1) scrap or 206C(1H) above the
  /// buyer threshold). Included in grandTotal — the customer owes it too.
  tcsSectionCode        String?                @map("tcs_section_code") @db.VarChar(20)
  tcsAmount             Decimal                @default(0) @map("tcs_amount") @db.Decimal(14, 2)
  items                 SalesInvoiceItem[]
  paymentRecords        SalesInvoicePayment[]
  customer              Customer               @relation(fields: [customerId], references: [id])
  salesOrder            SalesOrder?            @relation(fields: [salesOrderId], references: [id])
  store                 Store?                 @relation(fields: [companyId, storeId], references: [companyId, storeId])
  salesReturns          SalesReturn[]
  advanceAdjustments    AdvanceAdjustment[]
  exportIncentiveClaims ExportIncentiveClaim[]
  businessPlace         BusinessPlace?         @relation("SalesInvoiceBusinessPlace", fields: [businessPlaceId], references: [id])
  /// Cancelled documents stay on file (MCA Rule 3(1)); their vouchers are reversed (P1-09).
