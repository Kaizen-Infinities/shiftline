model StoreLocation {
  id           String          @id @default(uuid())
  companyId    String          @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  storeId      String          @map("store_id") @db.VarChar(20)
  parentId     String?         @map("parent_id")
