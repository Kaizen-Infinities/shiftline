model Supplier {
  mobile                Json?                   @map("mobile")
  email                 String?                 @map("email") @db.VarChar(120)
  gstin                 String?                 @map("gstin") @db.VarChar(15)
  pan                   String?                 @map("pan") @db.VarChar(10)
  altPhone              String?                 @map("alt_phone") @db.VarChar(15)
  billingAddressLine1   String                  @map("billing_address_line1") @db.VarChar(255)
  billingCity           String                  @map("billing_city") @db.VarChar(100)
  billingState          String                  @map("billing_state") @db.VarChar(100)
  billingPincode        String                  @map("billing_pincode") @db.VarChar(20)
  billingCountry        String?                 @default("India") @map("billing_country") @db.VarChar(100)
  contactPerson         String?                 @map("contact_person") @db.VarChar(80)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy             String                  @map("created_by")
  deletedAt             DateTime?               @map("deleted_at") @db.Timestamptz(6)
  displayName           String?                 @map("display_name") @db.VarChar(80)
  gstRegType            GstRegistrationType?    @map("gst_reg_type")
  legalName             String                  @map("legal_name") @db.VarChar(160)
  minOrderQty           Decimal?                @map("min_order_qty") @db.Decimal(12, 3)
  stateCode             String                  @map("state_code") @db.VarChar(2)
  status                String                  @default("Active") @map("status") @db.VarChar(20)
  supplierCode          String                  @map("supplier_code") @db.VarChar(20)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy             String?                 @map("updated_by")
  whatsapp              String?                 @map("whatsapp") @db.VarChar(15)
  openingBalance        Decimal                 @default(0) @map("opening_balance") @db.Decimal(14, 2)
  openingBalanceType    String                  @default("CREDIT") @map("opening_balance_type") @db.VarChar(10)
  /// Days after the bill date a supplier bill falls due (P1-10); sets GrnInvoice.billDueDate.
  creditDays            Int?                    @map("credit_days")
  id                    Int                     @id @default(autoincrement())
  companyId             String                  @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  /// Deductee details for TDS (P1-15): who they are decides the rate, and 206AB doubles it.
  deducteeType          DeducteeType?           @map("deductee_type")
  /// MSME status (P1-07). Only MICRO and SMALL bring section 15 and 43B(h) with them.
  msmeCategory          MsmeCategory            @default(NOT_REGISTERED) @map("msme_category")
  /// UDYAM-XX-00-0000000 from the supplier's registration certificate.
  udyamNumber           String?                 @map("udyam_number") @db.VarChar(19)
  /// The day the certificate was actually seen; status claimed but unverified is worth knowing.
  msmeVerifiedOn        DateTime?               @map("msme_verified_on") @db.Date
  /// Section 15 allows up to 45 days only where there is a written agreement; 15 days otherwise.
  hasWrittenContract    Boolean                 @default(false) @map("has_written_contract")
  /// The days the contract agrees to. Capped at 45 when the limit is worked out, never here.
  agreedPaymentDays     Int?                    @map("agreed_payment_days")
  /// The payee has not filed their returns, so tax comes off at the higher rate (206AB).
  higherRate206AB       Boolean                 @default(false) @map("higher_rate_206ab")
  /// Section this supplier is usually deducted under (P2-11); the GRN form defaults to it.
  defaultTdsSectionCode String?                 @map("default_tds_section_code") @db.VarChar(20)
  materialPrices        SupplierMaterialPrice[]
  tdsDeductions         TdsDeduction[]
  expenses              Expense[]
  grnInvoices           GrnInvoice[]
  purchaseOrders        PurchaseOrder[]
  addresses             SupplierAddress[]
  accountLedger         AccountLedger?
  purchaseReturns       PurchaseReturn[]
  cheques               Cheque[]

  company       Company       @relation("CompanySupplier", fields: [companyId], references: [id], onDelete: Restrict)
  fixedAssets   FixedAsset[]
  billOfEntries BillOfEntry[]

  @@unique([companyId, supplierCode])
  @@index([legalName])
  @@index([status])
  @@index([companyId, msmeCategory])
  @@map("suppliers")
}

