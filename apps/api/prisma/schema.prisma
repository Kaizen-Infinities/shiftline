model RawMaterial {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rawMaterialId           String                   @map("raw_material_id") @db.VarChar(20)
  companyId               String                   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  materialName            String                   @map("material_name") @db.VarChar(100)
  baseUom                 String                   @map("base_uom") @db.VarChar(50)
  reorderLevel            Decimal?                 @map("reorder_level") @db.Decimal(14, 3)
  rate                    Decimal?                 @map("rate") @db.Decimal(14, 2)
  isActive                Boolean                  @default(true) @map("is_active")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  createdBy               String?                  @map("created_by") @db.VarChar(36)
  updatedBy               String?                  @map("updated_by") @db.VarChar(36)
  storeId                 String?                  @map("store_id") @db.VarChar(20)
  minimumStock            Decimal?                 @map("minimum_stock") @db.Decimal(14, 3)
  status                  String                   @default("Active") @map("status") @db.VarChar(20)
  batchNo                 String?                  @map("batch_no") @db.VarChar(40)
  lastMovementAt          DateTime?                @map("last_movement_at")
  locationId              String?                  @map("location_id")
  onHandQty               Decimal                  @default(0) @map("on_hand_qty") @db.Decimal(14, 3)
  reservedQty             Decimal                  @default(0) @map("qty_reserved") @db.Decimal(14, 3)
  narration               String?                  @map("narration") @db.VarChar(255)
  itemType                String?                  @map("item_type") @db.VarChar(50)
  flaggedForReview        Boolean                  @default(false) @map("flagged_for_review")
  categoryId              Int?                     @map("category_id")
  hsnCodeId               String?                  @map("hsn_code_id") @db.Uuid
  gstRate                 Decimal?                 @map("gst_rate") @db.Decimal(5, 2)
  hsnCode                 HsnCode?                 @relation(fields: [hsnCodeId], references: [id])
  billOfMaterials         BillOfMaterial[]
  grnInvoiceItems         GrnInvoiceItem[]
  productionWastages      ProductionWastage[]
  targetedWastages        ProductionWastage[]      @relation("TargetWastageProduct")
  rawMaterialTransactions RawMaterialTransaction[]
  storeLocation           StoreLocation?           @relation(fields: [locationId], references: [id])
  purchaseReturnItems     PurchaseReturnItem[]
  store                   Store?                   @relation("StoreToRawMaterial", fields: [companyId, storeId], references: [companyId, storeId])
  StockAdjustmentItem     StockAdjustmentItem[]
  category                Category?                @relation(fields: [categoryId], references: [id])

  company Company @relation("CompanyRawMaterial", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, rawMaterialId])
  @@index([storeId])
  @@index([locationId])
  @@index([isActive])
  @@index([companyId])
  @@map("raw_materials")
}

model BillOfMaterial {
  id               BigInt      @id @default(autoincrement())
  companyId        String      @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  productId        BigInt      @map("product_id")
  rawMaterialId    String      @map("raw_material_id") @db.VarChar(20)
  requiredQuantity Decimal     @map("required_quantity") @db.Decimal(12, 3)
  percentage       Decimal?    @map("percentage") @db.Decimal(12, 4)
