// from the Production Product catalog. Assembled from Production Products
// via SalesProductComponent, and carries its own price/stock like any
// sellable item.
model SalesProduct {
  id               BigInt   @id @default(autoincrement())
  companyId        String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
