  @@unique([companyId, shiftName])
  @@unique([companyId, shiftCode])
  @@map("shifts")
}

model ProductImage {
  id        BigInt  @id @default(autoincrement())
  companyId String  @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  productId BigInt
  imageUrl  String
  isPrimary Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  company Company @relation("CompanyProductImage", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([companyId])
  @@map("product_images")
}

model Product {
  id                        BigInt                     @id @default(autoincrement())
  companyId                 String                     @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  productCode               String
  productName               String
  description               String?
  uomId                     Int?
  capacityLitres            Decimal?                   @db.Decimal(6, 2)
  weightPerPiece            Decimal?                   @db.Decimal(10, 2)
  weightUom                 String                     @default("g") @map("weight_uom") @db.VarChar(10)
  isActive                  Boolean                    @default(true)
  createdBy                 String?
  modifiedBy                String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  rate                      Decimal?                   @db.Decimal(12, 2)
  gradeRates                Json?                      @map("grade_rates")
  minimumQty                String                     @default("0") @map("minimum_qty")
  productType               ProductType                @default(PRODUCTION) @map("product_type")
  categoryId                Int?                       @map("category_id")
  hsnCodeId                 String?                    @map("hsn_code_id") @db.Uuid
  /// Overrides the HSN default when set.
  gstRate                   Decimal?                   @map("gst_rate") @db.Decimal(5, 2)
  hsnCode                   HsnCode?                   @relation(fields: [hsnCodeId], references: [id])
  billOfMaterials           BillOfMaterial[]
  finishedGoodsStocks       FinishedGoodsStock[]
  finishedGoodsTransactions FinishedGoodsTransaction[]
  goodsDispatchItems        GoodsDispatchItem[]
  images                    ProductImage[]
  productionOrders          ProductionOrder[]
  productionSteps           ProductionStep[]
  productionWastages        ProductionWastage[]
  uom                       UnitOfMeasure?             @relation(fields: [uomId], references: [id], onDelete: Restrict)
  category                  Category?                  @relation(fields: [categoryId], references: [id])
  salesInvoiceItems         SalesInvoiceItem[]
  salesOrderItems           SalesOrderItem[]           @relation("SalesOrderItemProduct")
  salesReturnItems          SalesReturnItem[]
  StockAdjustmentItem       StockAdjustmentItem[]
  weeklyPrograms            WeeklyMachineProgram[]     @relation("ProductWeeklyPrograms")
  shiftRecords              ProductShiftRecord[]
  capacityHistories         ProductCapacityHistory[]
  usedInSalesProducts       SalesProductComponent[]

  company Company @relation("CompanyProduct", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, productCode])
  @@index([uomId])
  @@index([productName])
  @@map("products")
}

// A separately-catalogued sellable item (e.g. "3L Container" kit), distinct
// from the Production Product catalog. Assembled from Production Products
// via SalesProductComponent, and carries its own price/stock like any
// sellable item.
model SalesProduct {
  id               BigInt   @id @default(autoincrement())
  companyId        String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  salesProductCode String   @map("sales_product_code")
  salesProductName String   @map("sales_product_name")
  description      String?
  rate             Decimal? @db.Decimal(12, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdBy        String?  @map("created_by")
  modifiedBy       String?  @map("modified_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  components      SalesProductComponent[]
  stocks          SalesProductStock[]
  salesOrderItems SalesOrderItem[]

  company Company @relation("CompanySalesProduct", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, salesProductCode])
  @@index([salesProductName])
  @@map("sales_products")
}

model SalesProductStock {
  companyId      String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  storeId        String   @map("store_id") @db.VarChar(20)
  salesProductId BigInt   @map("sales_product_id")
  onHandQty      Decimal  @default(0) @map("on_hand_qty") @db.Decimal(14, 3)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  salesProduct SalesProduct @relation(fields: [salesProductId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [companyId, storeId], references: [companyId, storeId])

  company Company @relation("CompanySalesProductStock", fields: [companyId], references: [id], onDelete: Restrict)

  @@id([storeId, salesProductId])
  @@index([storeId])
  @@index([salesProductId])
  @@index([companyId])
  @@map("sales_product_stocks")
}

// Links a Sales Product (e.g. "3L Container") to the Production Products it
// is assembled from (e.g. "Container" + "Lid"), each with its own quantity.
model SalesProductComponent {
  id                 BigInt   @id @default(autoincrement())
  companyId          String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  salesProductId     BigInt   @map("sales_product_id")
  componentProductId BigInt   @map("component_product_id")
  quantity           Decimal  @map("quantity") @db.Decimal(12, 3)
  remarks            String?  @db.VarChar(255)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  salesProduct     SalesProduct @relation(fields: [salesProductId], references: [id], onDelete: Cascade)
  componentProduct Product      @relation(fields: [componentProductId], references: [id])

  company Company @relation("CompanySalesProductComponent", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([salesProductId, componentProductId])
  @@index([salesProductId])
  @@index([componentProductId])
  @@index([companyId])
  @@map("sales_product_components")
}

model ProductionStep {
  id        BigInt  @id @default(autoincrement())
  companyId String  @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  productId BigInt  @map("product_id")
  stepKey   String  @map("step_key")
  stepOrder Int     @map("step_order")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  company Company @relation("CompanyProductionStep", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([companyId])
  @@map("production_steps")
}

model UnitOfMeasure {
  id          Int       @id @default(autoincrement())
  companyId   String    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  uomCode     String
  uomName     String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Product     Product[]

  company Company @relation("CompanyUnitOfMeasure", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, uomCode])
  @@map("units_of_measure")
}

