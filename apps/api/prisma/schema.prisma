  customer    Customer?     @relation(fields: [customerId], references: [id])
  supplier    Supplier?     @relation(fields: [supplierId], references: [id])
  debitItems  JournalItem[] @relation("DebitItems")
  creditItems JournalItem[] @relation("CreditItems")
  bankAccount BankAccount?

  company Company @relation("CompanyAccountLedger", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("account_ledgers")
}

/// A bank account of the tenant, backed by an asset ledger in the "Bank Accounts"
/// group. Created by the onboarding wizard (P1-00); the base for statement import and
/// reconciliation (P1-20) and payment links (P1-21).
model BankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  ledgerId      Int      @unique @map("ledger_id")
  bankName      String   @map("bank_name") @db.VarChar(120)
  /// Name the account is held in, when it differs from the company name.
  accountName   String?  @map("account_name") @db.VarChar(160)
  accountNumber String?  @map("account_number") @db.VarChar(34)
  ifsc          String?  @db.VarChar(11)
  branch        String?  @db.VarChar(120)
  upiId         String?  @map("upi_id") @db.VarChar(80)
  isDefault     Boolean  @default(false) @map("is_default")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ledger  AccountLedger @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  company Company       @relation("CompanyBankAccount", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("bank_accounts")
}

enum NotificationLevel {
  INFO
  SUCCESS
  WARNING
  ERROR
}

/// In-app notice for one member of a tenant (P1-00). Broadcasts fan out to one row per
/// recipient so read state and retention are per user. Producers call `notify()`.
model Notification {
  id        String            @id @default(uuid()) @db.Uuid
  companyId String            @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  userId    String            @map("user_id")
  level     NotificationLevel @default(INFO)
  /// Producer area: onboarding, team, imports, retention, inventory, system.
  category  String            @db.VarChar(40)
  title     String            @db.VarChar(160)
  body      String?           @db.VarChar(1000)
  /// In-app path to open when clicked.
  link      String?           @db.VarChar(255)
  data      Json?
  readAt    DateTime?         @map("read_at") @db.Timestamptz(6)
  createdBy String?           @map("created_by") @db.VarChar(36)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  company Company @relation("CompanyNotification", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, userId, readAt, createdAt])
  @@map("notifications")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

/// Platform catalogue (global, no tenant). Features and limits live in the row so a tier
/// can change without a deploy; `@shiftline/shared` PLAN_TIERS is the seed.
model Plan {
  id              String         @id @default(uuid()) @db.Uuid
  code            String         @unique @db.VarChar(30)
  name            String         @db.VarChar(80)
  description     String?        @db.VarChar(255)
  /// Feature keys from the shared registry.
  features        String[]
  /// Active users plus pending invitations; null means unlimited.
  seatLimit       Int?           @map("seat_limit")
  /// API requests per tenant per 15 minutes; null means the platform default.
  apiLimit        Int?           @map("api_limit")
  priceInrMonthly Decimal?       @map("price_inr_monthly") @db.Decimal(12, 2)
  isActive        Boolean        @default(true) @map("is_active")
  sortOrder       Int            @default(0) @map("sort_order")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  subscriptions   Subscription[]

  @@map("plans")
}

/// One subscription per tenant (history is in the audit trail). Seats and the API cap may
/// override the plan; overrides of individual features live in FeatureFlagOverride.
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  seats              Int?
  apiLimit           Int?               @map("api_limit")
