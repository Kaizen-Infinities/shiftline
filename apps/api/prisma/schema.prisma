  salesInvoices             SalesInvoice[]
  StockAdjustmentItem       StockAdjustmentItem[]
  storeLocations            StoreLocation[]
  businessPlace             BusinessPlace?             @relation(fields: [businessPlaceId], references: [id])
  incharge                  Employee?                  @relation(fields: [inchargeId], references: [id])
  location                  Location?                  @relation(fields: [companyId, locationId], references: [companyId, locationId])

