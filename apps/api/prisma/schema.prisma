// ─── Retention (P0-10) ────────────────────────────────────────────────────────

/// Classes of data a tenant may set retention for. Statutory minimums are
/// enforced in code (modules/retention/retention.policy.ts), not here.
enum RetentionDataClass {
  BOOKS
  FILINGS
  PAYROLL
  AUDIT_LOGS
  EOD_SNAPSHOTS
  SESSIONS
  LOGIN_ATTEMPTS
  SYNC_TOMBSTONES
  AGENT_POSITIONS
  NOTIFICATIONS
}

enum RetentionAction {
  RETAIN
  ARCHIVE
  PURGE
}

model RetentionPolicy {
  id            String             @id @default(uuid()) @db.Uuid
  companyId     String             @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  dataClass     RetentionDataClass @map("data_class")
  retentionDays Int                @map("retention_days")
  action        RetentionAction    @default(RETAIN)
  isActive      Boolean            @default(true) @map("is_active")
  updatedBy     String?            @map("updated_by") @db.VarChar(36)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyRetentionPolicy", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, dataClass])
  @@map("retention_policies")
}

/// One row per data class per sweep run; dry runs are recorded too.
model RetentionSweep {
  id          BigInt             @id @default(autoincrement())
  companyId   String             @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  dataClass   RetentionDataClass @map("data_class")
  action      RetentionAction
  dryRun      Boolean            @map("dry_run")
  cutoff      DateTime           @db.Timestamptz(6)
  matched     Int                @default(0)
  affected    Int                @default(0)
  archivePath String?            @map("archive_path") @db.VarChar(500)
  error       String?            @db.VarChar(1000)
  triggeredBy String?            @map("triggered_by") @db.VarChar(36)
  jobId       String?            @map("job_id") @db.VarChar(64)
  startedAt   DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime?          @map("finished_at") @db.Timestamptz(6)

  company Company @relation("CompanyRetentionSweep", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, startedAt])
  @@map("retention_sweeps")
}

// ─── Mobile devices and positions (P0-11) ─────────────────────────────────────

/// One row per physical device that has synced for a tenant. Revoking a device
/// makes every sync, push and position call from it fail with DEVICE_REVOKED.
/// Device-bound refresh tokens and remote wipe arrive with the device registry
/// screens in P1-02.
model MobileDevice {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  deviceId    String    @map("device_id") @db.VarChar(64)
  userId      String    @map("user_id") @db.VarChar(36)
  platform    String?   @db.VarChar(20)
  appVersion  String?   @map("app_version") @db.VarChar(20)
  model       String?   @db.VarChar(80)
  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  lastSyncAt  DateTime? @map("last_sync_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy   String?   @map("revoked_by") @db.VarChar(36)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyMobileDevice", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, deviceId])
  @@index([companyId, userId])
  @@map("mobile_devices")
}

/// GPS points sent by the Field app (batched, offline-buffered). Personal data:
/// the AGENT_POSITIONS retention class purges them after 90 days by default.
model AgentPosition {
  id          BigInt   @id @default(autoincrement())
  companyId   String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  agentUserId String   @map("agent_user_id") @db.VarChar(36)
  deviceId    String?  @map("device_id") @db.VarChar(64)
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  accuracyM   Decimal? @map("accuracy_m") @db.Decimal(8, 2)
  speedKmh    Decimal? @map("speed_kmh") @db.Decimal(6, 2)
  heading     Decimal? @db.Decimal(6, 2)
  batteryPct  Int?     @map("battery_pct")
  recordedAt  DateTime @map("recorded_at") @db.Timestamptz(6)
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  company Company @relation("CompanyAgentPosition", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, agentUserId, recordedAt])
  @@index([companyId, receivedAt])
  @@map("agent_positions")
}

// ─── Platform backups (P0-13) ─────────────────────────────────────────────────

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// One row per pg_dump run (daily job or manual). Platform table: no companyId,
/// readable by platform admins only. MCA Rule 3(5): daily backup of the books.
model BackupRun {
  id          BigInt       @id @default(autoincrement())
  status      BackupStatus @default(RUNNING)
  fileName    String?      @map("file_name") @db.VarChar(255)
  bytes       BigInt?
  sha256      String?      @db.VarChar(64)
  durationMs  Int?         @map("duration_ms")
  error       String?      @db.VarChar(1000)
  triggeredBy String?      @map("triggered_by") @db.VarChar(36)
  jobId       String?      @map("job_id") @db.VarChar(64)
  startedAt   DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime?    @map("finished_at") @db.Timestamptz(6)

  @@index([startedAt])
  @@map("backup_runs")
}

// ─── Invitations (P1-00) ──────────────────────────────────────────────────────

/// A pending user invitation. The raw token travels only in the email link;
/// the row keeps its sha256. Accepting creates the user with the invited role.
model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  email          String    @db.VarChar(120)
  fullName       String?   @map("full_name") @db.VarChar(160)
  roleId         Int       @map("role_id")
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedUserId String?   @map("accepted_user_id") @db.VarChar(36)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  invitedBy      String?   @map("invited_by") @db.VarChar(36)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyInvitation", fields: [companyId], references: [id], onDelete: Restrict)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([companyId, email])
  @@map("invitations")
}
