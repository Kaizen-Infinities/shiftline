model Store {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId                   String                     @map("store_id") @db.VarChar(20)
  companyId                 String                     @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  storeName                 String                     @map("store_name") @db.VarChar(120)
  storeCategory             StoreCategory?             @map("store_category")
  locationId                String?                    @map("location_id") @db.VarChar(20)
  isActive                  Boolean                    @default(true) @map("is_active")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  createdBy                 String?                    @map("created_by") @db.VarChar(36)
  updatedBy                 String?                    @map("updated_by") @db.VarChar(36)
  allowNegative             Boolean                    @default(false) @map("allow_negative")
  costMethod                String                     @default("WAVG") @map("cost_method") @db.VarChar(10)
  gstPlace                  String?                    @map("gst_place") @db.VarChar(50)
