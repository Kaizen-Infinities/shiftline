  productionOrder    ProductionOrder   @relation(fields: [productionOrderId], references: [productionOrderId], onDelete: Cascade)
  rawMaterial        RawMaterial?      @relation(fields: [rawMaterialId], references: [rawMaterialId])
  shift              Shift             @relation(fields: [shiftId], references: [shiftCode], onDelete: Cascade)

  @@index([productionOrderId])
  @@index([hourlyProductionId])
  @@index([machineId])
  @@index([shiftId])
  @@index([productId])
  @@index([wastageDate])
  @@map("production_wastages")
}

model StockAdjustment {
  id               BigInt                @id @default(autoincrement()) @map("adj_id")
  adjustmentNumber String                @unique @map("adjustment_number") @db.VarChar(50)
  adjustmentDate   DateTime              @map("adjustment_date")
  reason           String?               @db.VarChar(255)
  status           AdjustmentStatus      @default(DRAFT)
  approvedBy       String?               @map("approved_by") @db.VarChar(36)
  approvedAt       DateTime?             @map("approved_at")
  createdBy        String?               @map("created_by") @db.VarChar(36)
  updatedBy        String?               @map("updated_by") @db.VarChar(36)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  items            StockAdjustmentItem[]

  @@index([adjustmentDate])
  @@index([status])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id                BigInt           @id @default(autoincrement()) @map("adj_item_id")
  stockAdjustmentId BigInt           @map("stock_adjustment_id")
  itemType          ItemCategoryType @map("item_type")
  rawMaterialId     String?          @map("raw_material_id") @db.VarChar(20)
  productItemId     BigInt?          @map("product_item_id")
  storeId           String           @map("store_id") @db.VarChar(20)
  currentQty        Decimal          @map("current_qty") @db.Decimal(14, 3)
  adjustedQty       Decimal          @map("adjusted_qty") @db.Decimal(14, 3)
  difference        Decimal          @map("difference") @db.Decimal(14, 3)
  remarks           String?          @db.VarChar(255)
  product           Product?         @relation(fields: [productItemId], references: [id])
  rawMaterial       RawMaterial?     @relation(fields: [rawMaterialId], references: [rawMaterialId])
  stockAdjustment   StockAdjustment  @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  store             Store            @relation(fields: [storeId], references: [storeId])

  @@index([stockAdjustmentId])
  @@index([storeId])
  @@map("stock_adjustment_items")
}

