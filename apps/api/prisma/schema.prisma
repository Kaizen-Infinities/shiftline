generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id            BigInt         @id @default(autoincrement())
  companyId     String         @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  empCode       String
  fullName      String
  mobile        String?        @db.VarChar(20)
  email         String?        @db.VarChar(100)
  dateOfJoining DateTime?
  departmentId  Int?
  status        EmployeeStatus @default(active)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
  createdBy     String?
  updatedBy     String?

  // Section 1: Basic Info
  photoUrl      String?
  gender        Gender?
  dateOfBirth   DateTime?      @db.Date
  bloodGroup    String?
  maritalStatus MaritalStatus?

  // Section 2: Contact Info
  personalMobile         String? @db.VarChar(20)
  personalEmail          String? @db.VarChar(100)
  emergencyContactName   String?
  emergencyContactNumber String? @db.VarChar(20)

  // Section 3: Family Details
  fatherName           String?
  motherName           String?
  spouseName           String?
  guardianName         String?
  guardianRelationship String?

  // Section 4: Identity Documents
  aadhaarNumber  String?
  panNumber      String?
  drivingLicense String?
  voterId        String?

  // Section 5: Address
  permanentAddressLine1 String?
  permanentAddressLine2 String?
  permanentCity         String?
  permanentState        String?
  permanentPincode      String?
  presentAddressLine1   String?
  presentAddressLine2   String?
  presentCity           String?
  presentState          String?
  presentPincode        String?

  // Section 6: Official Info
  designation  String?
  employeeType EmployeeType?
  roleId       Int?

  // Section 7: Joining Details
  relievingDate      DateTime?
  previousExperience String?
  probationPeriod    Int?
  noticePeriod       Int?

  // Section 8: Shift
  shiftId String?

  // Section 9: Payroll & Statutory
  salaryType        SalaryType?
  basicSalary       Decimal?    @db.Decimal(12, 2)
  grossSalary       Decimal?    @db.Decimal(12, 2)
  pfApplicable      Boolean     @default(false)
  pfNumber          String?
  uanNumber         String?
  esiApplicable     Boolean     @default(false)
  esiNumber         String?
  professionalTax   Boolean     @default(false)
  tdsApplicable     Boolean     @default(false)
  paymentMode       String?     @default("BANK")
  bankName          String?
  bankBranch        String?
  accountNumber     String?
  ifscCode          String?
  accountHolderName String?

  createdByUser              User?                        @relation("EmployeeCreatedBy", fields: [createdBy], references: [userId])
  department                 Department?                  @relation(fields: [departmentId], references: [id])
  updatedByUser              User?                        @relation("EmployeeUpdatedBy", fields: [updatedBy], references: [userId])
  machineAssignmentOperators MachineAssignmentOperator[]
  inchargeAssignments        MachineOperationAssignment[] @relation("InchargeEmployeeAssignments")
  stores                     Store[]
  user                       User?
  role                       Role?                        @relation(fields: [roleId], references: [id])
  shift                      Shift?                       @relation(fields: [companyId, shiftId], references: [companyId, shiftCode])
  payrollConfig              EmployeePayrollConfig?
  payrollResults             PayrollResult[]
  salaryAdvances             SalaryAdvance[]
  permanentDeductions        EmployeePermanentDeduction[]
  salesOrdersAsSource        SalesOrder[]                 @relation("SalesOrderSourceEmployee")

  company Company @relation("CompanyEmployee", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, empCode])
  @@unique([companyId, email])
  @@unique([companyId, aadhaarNumber])
  @@unique([companyId, panNumber])
  @@unique([companyId, pfNumber])
  @@unique([companyId, uanNumber])
  @@unique([companyId, esiNumber])
  @@index([departmentId])
  @@index([roleId])
  @@index([status])
  @@index([shiftId])
  @@map("employees")
}

model Admin {
  id                  BigInt               @id @default(autoincrement())
  fullName            String
  email               String?              @unique
  phone               String?
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  username            String               @unique
  passwordHash        String
  status              UserStatus           @default(active)
  lastLoginAt         DateTime?            @db.Timestamptz(6)
  roleId              Int?
  role                Role?                @relation(fields: [roleId], references: [id])
  auditLogs           AuditLog[]           @relation("ChangedByAdmin")
  loginAttempts       LoginAttempt[]
  passwordResetTokens PasswordResetToken[]
  userSessions        UserSession[]

  @@map("admins")
}

model User {
  userId              String               @id @default(uuid())
  companyId           String               @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  username            String               @unique
  fullName            String
  email               String?              @unique
  passwordHash        String
  employeeId          BigInt?              @unique
  roleId              Int?
  status              UserStatus           @default(active)
  mustChangePw        Boolean              @default(false)
  failedAttempts      Int                  @default(0)
  lockedUntil         DateTime?            @db.Timestamptz(6)
  lastLoginAt         DateTime?            @db.Timestamptz(6)
  lastLoginIp         String?
  mfaEnabled          Boolean              @default(false)
  mfaSecret           String?
  createdBy           String?
  createdOn           DateTime             @default(now()) @db.Timestamptz(6)
  updatedOn           DateTime             @updatedAt @db.Timestamptz(6)
  auditLogs           AuditLog[]           @relation("ChangedBy")
  createdEmployees    Employee[]           @relation("EmployeeCreatedBy")
  updatedEmployees    Employee[]           @relation("EmployeeUpdatedBy")
  expensesCreated     Expense[]            @relation("ExpenseCreatedBy")
  loginAttempts       LoginAttempt[]
  passwordResetTokens PasswordResetToken[]
  createdSalesOrders  SalesOrder[]         @relation("SalesOrderCreatedBy")
  sessions            UserSession[]
  notifications       Notification[]
  employee            Employee?            @relation(fields: [employeeId], references: [id])
  role                Role?                @relation(fields: [roleId], references: [id])

  company Company @relation("CompanyUser", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([employeeId])
  @@index([roleId])
  @@index([companyId])
  @@map("users")
}

model UserSession {
  id            String    @id @default(uuid())
  userId        String?
  adminId       BigInt?
  sessionToken  String    @unique
  ipAddress     String?
  userAgent     String?
  deviceLabel   String?
  loginAt       DateTime  @default(now()) @db.Timestamptz(6)
  logoutAt      DateTime? @db.Timestamptz(6)
  expiresAt     DateTime  @db.Timestamptz(6)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  /// sha256 of the refresh token this session accepted before the last rotation (reuse detection).
  prevTokenHash String?   @map("prev_token_hash") @db.VarChar(64)
  rotatedAt     DateTime? @map("rotated_at") @db.Timestamptz(6)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  admin         Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([adminId, isActive])
  @@index([sessionToken])
  @@index([prevTokenHash])
  @@map("user_sessions")
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String?
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz(6)
  usedAt      DateTime? @db.Timestamptz(6)
  used        Boolean   @default(false)
  requestedIp String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  adminId     BigInt?
  admin       Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model LoginAttempt {
  id            BigInt   @id @default(autoincrement())
  username      String
  userId        String?
  ipAddress     String
  success       Boolean
  failureReason String?
  userAgent     String?
  attemptedAt   DateTime @default(now()) @db.Timestamptz(6)
  adminId       BigInt?
  admin         Admin?   @relation(fields: [adminId], references: [id])
  user          User?    @relation(fields: [userId], references: [userId])

  @@index([username])
  @@index([ipAddress])
  @@index([attemptedAt])
  @@index([userId])
  @@map("login_attempts")
}

model AuditLog {
  id                BigInt      @id @default(autoincrement())
  companyId         String?     @map("company_id") @db.Uuid
  entityName        String
  entityId          String?
  action            AuditAction
  oldValues         Json?
  newValues         Json?
  changedBy         String?
  ipAddress         String?
  userAgent         String?
  changedAt         DateTime    @default(now()) @db.Timestamptz(6)
  changedByAdmin    BigInt?
  changedByAdminRel Admin?      @relation("ChangedByAdmin", fields: [changedByAdmin], references: [id])
  changedByUser     User?       @relation("ChangedBy", fields: [changedBy], references: [userId])

  company        Company? @relation("CompanyAuditLog", fields: [companyId], references: [id], onDelete: Restrict)
  requestId      String?  @map("request_id") @db.VarChar(64)
  actorType      String?  @map("actor_type") @db.VarChar(20)
  impersonatedBy String?  @map("impersonated_by") @db.VarChar(36)

  @@index([entityName, entityId])
  @@index([changedBy])
  @@index([companyId])
  @@map("audit_log")
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique
  module          String
  action          String
  scope           String?
  description     String?
  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id                         Int                          @id @default(autoincrement())
  companyId                  String                       @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  code                       String                       @default("ADMIN")
  name                       String
  description                String?
  isSystem                   Boolean                      @default(true)
  status                     RoleStatus                   @default(active)
  createdAt                  DateTime                     @default(now()) @db.Timestamptz(6)
  Admin                      Admin[]
  machineAssignmentOperators MachineAssignmentOperator[]
  inchargeRoleAssignments    MachineOperationAssignment[] @relation("InchargeRoleAssignments")
  rolePermissions            RolePermission[]
  users                      User[]
  employees                  Employee[]
  /// How many days back this role may post; null = no limit, 0 = today only (P1-09).
  backdateDays               Int?                         @map("backdate_days")

  company Company @relation("CompanyRole", fields: [companyId], references: [id], onDelete: Restrict)

  invitations Invitation[]

  @@unique([companyId, code])
  @@map("roles")
}

model RolePermission {
  companyId    String     @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  company Company @relation("CompanyRolePermission", fields: [companyId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@index([companyId])
  @@map("role_permissions")
}

model Department {
  id          Int        @id @default(autoincrement())
  companyId   String     @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]

  company Company @relation("CompanyDepartment", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("departments")
}

model CustomerType {
  id        Int        @id @default(autoincrement())
  companyId String     @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  name      String     @db.VarChar(100)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  customers Customer[]

  company Company @relation("CompanyCustomerType", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
  @@map("customer_types")
}

model CustomerGrade {
  id        Int        @id @default(autoincrement())
  companyId String     @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  name      String     @db.VarChar(100)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  customers Customer[]

  company Company @relation("CompanyCustomerGrade", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
  @@map("customer_grades")
}

model Customer {
  email       String? @db.VarChar(120)
  gstin       String? @db.VarChar(15)
  creditLimit Decimal @default(0) @db.Decimal(14, 2)
  creditDays  Int?    @map("credit_days")

  transports Json? @map("transports")

  outstandingAmount Decimal  @default(0) @db.Decimal(14, 2)
  createdBy         String
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  customerCode String    @db.VarChar(20)
  deletedAt    DateTime? @db.Timestamptz(6)
  displayName  String?   @db.VarChar(80)
  firmName     String    @db.VarChar(160)

  mobile Json? @map("mobile")

  searchTsv Unsupported("tsvector")?

  status String @default("Active") @db.VarChar(20)

  updatedBy             String?
  id                    String              @id @default(uuid()) @db.Uuid
  companyId             String              @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  openingBalance        Decimal             @default(0) @db.Decimal(14, 2)
  openingBalanceType    String              @default("DEBIT") @db.VarChar(10)
  gstRegType            GstRegistrationType @default(UNREGISTERED) @map("gst_reg_type")
  stateCode             String?             @map("state_code") @db.VarChar(2)
  customerTypeId        Int?
  customerGradeId       Int?
  customerType          CustomerType?       @relation(fields: [customerTypeId], references: [id])
  customerGrade         CustomerGrade?      @relation(fields: [customerGradeId], references: [id])
  addresses             CustomerAddress[]
  salesInvoices         SalesInvoice[]
  salesOrders           SalesOrder[]        @relation("CustomerSalesOrders")
  salesOrdersAsReferral SalesOrder[]        @relation("SalesOrderReferredBy")
  accountLedger         AccountLedger?
  salesReturns          SalesReturn[]

  company Company @relation("CompanyCustomer", fields: [companyId], references: [id], onDelete: Restrict)

  mobileVisits         MobileVisit[]
  mobileCollections    MobileCollection[]
  mobileRouteCustomers MobileRouteCustomer[]

  @@unique([companyId, customerCode])
  @@index([companyId, status], map: "idx_cust_company_status")
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(uuid()) @map("id")
  companyId  String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  address    Json     @map("address")
  customerId String   @map("customer_id") @db.Uuid
  is_default Boolean  @default(false)
  label      String   @db.VarChar(40)
  state_code String   @db.VarChar(50)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  company Company @relation("CompanyCustomerAddress", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("customer_addresses")
}

model Company {
  id           String  @id @default(uuid()) @db.Uuid
  companyCode  String? @unique @db.VarChar(20)
  companyName  String  @db.VarChar(160)
  legalName    String? @db.VarChar(160)
  shortName    String? @db.VarChar(60)
  gstin        String? @db.VarChar(15)
  currencyCode String  @default("INR") @db.VarChar(3)
  phone        String? @db.VarChar(20)
  mobile       String? @db.VarChar(1000)
  email        String? @db.VarChar(120)
  website      String? @db.VarChar(200)
  logoUrl      String?
  faviconUrl   String?
  addressLine1 String? @db.VarChar(255)

  city                String?             @db.VarChar(100)
  state               String?             @db.VarChar(100)
  zipcode             String?             @db.VarChar(20)
  country             String?             @db.VarChar(100)
  isOnboarded         Boolean             @default(false)
  isActive            Boolean             @default(true)
  createdBy           String?             @db.Uuid
  updatedBy           String?             @db.Uuid
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(6)
  /// URL-safe tenant handle (login branding, invitations); unique across the platform.
  slug                String?             @unique @db.VarChar(40)
  onboardingStep      String?             @map("onboarding_step") @db.VarChar(40)
  tosAcceptedAt       DateTime?           @map("tos_accepted_at") @db.Timestamptz(6)
  tosAcceptedBy       String?             @map("tos_accepted_by") @db.VarChar(36)
  /// GST registration of the head office; places of business carry their own GSTIN.
  gstRegistrationType GstRegistrationType @default(REGULAR) @map("gst_registration_type")
  stateCode           String?             @map("state_code") @db.VarChar(2)
  invitations         Invitation[]        @relation("CompanyInvitation")

  accountLedgers              AccountLedger[]              @relation("CompanyAccountLedger")
  accountingPeriods           AccountingPeriod[]           @relation("CompanyAccountingPeriod")
  attendanceRecords           AttendanceRecord[]           @relation("CompanyAttendanceRecord")
  auditLogs                   AuditLog[]                   @relation("CompanyAuditLog")
  billOfMaterials             BillOfMaterial[]             @relation("CompanyBillOfMaterial")
  businessPlaces              BusinessPlace[]              @relation("CompanyBusinessPlace")
  categories                  Category[]                   @relation("CompanyCategory")
  customerAddresses           CustomerAddress[]            @relation("CompanyCustomerAddress")
  customerGrades              CustomerGrade[]              @relation("CompanyCustomerGrade")
  customerTypes               CustomerType[]               @relation("CompanyCustomerType")
  customers                   Customer[]                   @relation("CompanyCustomer")
  dailyProductionPlans        DailyProductionPlan[]        @relation("CompanyDailyProductionPlan")
  departments                 Department[]                 @relation("CompanyDepartment")
  emailConfigs                EmailConfig[]                @relation("CompanyEmailConfig")
  employeePayrollConfigs      EmployeePayrollConfig[]      @relation("CompanyEmployeePayrollConfig")
  employeePermanentDeductions EmployeePermanentDeduction[] @relation("CompanyEmployeePermanentDeduction")
  employees                   Employee[]                   @relation("CompanyEmployee")
  eodStockSnapshots           EodStockSnapshot[]           @relation("CompanyEodStockSnapshot")
  expenses                    Expense[]                    @relation("CompanyExpense")
  finishedGoodsStocks         FinishedGoodsStock[]         @relation("CompanyFinishedGoodsStock")
  finishedGoodsTransactions   FinishedGoodsTransaction[]   @relation("CompanyFinishedGoodsTransaction")
  goodsDispatchItems          GoodsDispatchItem[]          @relation("CompanyGoodsDispatchItem")
  goodsDispatchs              GoodsDispatch[]              @relation("CompanyGoodsDispatch")
  grnInvoiceItems             GrnInvoiceItem[]             @relation("CompanyGrnInvoiceItem")
  grnInvoicePayments          GrnInvoicePayment[]          @relation("CompanyGrnInvoicePayment")
  grnInvoices                 GrnInvoice[]                 @relation("CompanyGrnInvoice")
  hourlyProductions           HourlyProduction[]           @relation("CompanyHourlyProduction")
  invoiceSetting              InvoiceSetting?              @relation("CompanyInvoiceSetting")
  journalItems                JournalItem[]                @relation("CompanyJournalItem")
  locations                   Location[]                   @relation("CompanyLocation")
  machineAssignmentOperators  MachineAssignmentOperator[]  @relation("CompanyMachineAssignmentOperator")
  machineOeeSnapshots         MachineOeeSnapshot[]         @relation("CompanyMachineOeeSnapshot")
  machineOperationAssignments MachineOperationAssignment[] @relation("CompanyMachineOperationAssignment")
  machines                    Machine[]                    @relation("CompanyMachine")
  payrollConfig               PayrollConfig?               @relation("CompanyPayrollConfig")
  payrollResults              PayrollResult[]              @relation("CompanyPayrollResult")
  payrollRuns                 PayrollRun[]                 @relation("CompanyPayrollRun")
  pettyCashEntries            PettyCashEntry[]             @relation("CompanyPettyCashEntry")
  productCapacityHistories    ProductCapacityHistory[]     @relation("CompanyProductCapacityHistory")
  productImages               ProductImage[]               @relation("CompanyProductImage")
  productShiftRecords         ProductShiftRecord[]         @relation("CompanyProductShiftRecord")
  productionOrderHistories    ProductionOrderHistory[]     @relation("CompanyProductionOrderHistory")
  productionOrders            ProductionOrder[]            @relation("CompanyProductionOrder")
  productionSteps             ProductionStep[]             @relation("CompanyProductionStep")
  productionWastages          ProductionWastage[]          @relation("CompanyProductionWastage")
  products                    Product[]                    @relation("CompanyProduct")
  purchaseOrderItems          PurchaseOrderItem[]          @relation("CompanyPurchaseOrderItem")
  purchaseOrders              PurchaseOrder[]              @relation("CompanyPurchaseOrder")
  purchaseReturnItems         PurchaseReturnItem[]         @relation("CompanyPurchaseReturnItem")
  purchaseReturns             PurchaseReturn[]             @relation("CompanyPurchaseReturn")
  rawMaterialTransactions     RawMaterialTransaction[]     @relation("CompanyRawMaterialTransaction")
  rawMaterials                RawMaterial[]                @relation("CompanyRawMaterial")
  rolePermissions             RolePermission[]             @relation("CompanyRolePermission")
  roles                       Role[]                       @relation("CompanyRole")
  routes                      Route[]                      @relation("CompanyRoute")
  salaryAdvances              SalaryAdvance[]              @relation("CompanySalaryAdvance")
  salesInvoiceItems           SalesInvoiceItem[]           @relation("CompanySalesInvoiceItem")
  salesInvoicePayments        SalesInvoicePayment[]        @relation("CompanySalesInvoicePayment")
  salesInvoices               SalesInvoice[]               @relation("CompanySalesInvoice")
  salesOrderItems             SalesOrderItem[]             @relation("CompanySalesOrderItem")
  salesOrders                 SalesOrder[]                 @relation("CompanySalesOrder")
  salesProductComponents      SalesProductComponent[]      @relation("CompanySalesProductComponent")
  salesProductStocks          SalesProductStock[]          @relation("CompanySalesProductStock")
  salesProducts               SalesProduct[]               @relation("CompanySalesProduct")
  salesReturnItems            SalesReturnItem[]            @relation("CompanySalesReturnItem")
  salesReturns                SalesReturn[]                @relation("CompanySalesReturn")
  shifts                      Shift[]                      @relation("CompanyShift")
  stockAdjustmentItems        StockAdjustmentItem[]        @relation("CompanyStockAdjustmentItem")
  stockAdjustments            StockAdjustment[]            @relation("CompanyStockAdjustment")
  storeLocations              StoreLocation[]              @relation("CompanyStoreLocation")
  stores                      Store[]                      @relation("CompanyStore")
  supplierAddresses           SupplierAddress[]            @relation("CompanySupplierAddress")
  supplierMaterialPrices      SupplierMaterialPrice[]      @relation("CompanySupplierMaterialPrice")
  suppliers                   Supplier[]                   @relation("CompanySupplier")
  systemSettings              SystemSetting[]              @relation("CompanySystemSetting")
  unitOfMeasures              UnitOfMeasure[]              @relation("CompanyUnitOfMeasure")
  users                       User[]                       @relation("CompanyUser")
  vouchers                    Voucher[]                    @relation("CompanyVoucher")
  weeklyMachinePrograms       WeeklyMachineProgram[]       @relation("CompanyWeeklyMachineProgram")
  whatsappConfig              WhatsappConfig?              @relation("CompanyWhatsappConfig")
  documentSequences           DocumentSequence[]           @relation("CompanyDocumentSequence")
  mobileVisits                MobileVisit[]                @relation("CompanyMobileVisit")
  mobileCollections           MobileCollection[]           @relation("CompanyMobileCollection")
  mobileRouteCustomers        MobileRouteCustomer[]        @relation("CompanyMobileRouteCustomer")
  mobileRouteAssignments      MobileRouteAssignment[]      @relation("CompanyMobileRouteAssignment")
  mobileSyncRecords           MobileSyncRecord[]           @relation("CompanyMobileSyncRecord")
  retentionPolicies           RetentionPolicy[]            @relation("CompanyRetentionPolicy")
  retentionSweeps             RetentionSweep[]             @relation("CompanyRetentionSweep")
  mobileDevices               MobileDevice[]               @relation("CompanyMobileDevice")
  agentPositions              AgentPosition[]              @relation("CompanyAgentPosition")
  bankAccounts                BankAccount[]                @relation("CompanyBankAccount")
  notifications               Notification[]               @relation("CompanyNotification")
  subscription                Subscription?                @relation("CompanySubscription")
  featureFlagOverrides        FeatureFlagOverride[]        @relation("CompanyFeatureFlagOverride")
  hsnCodes                    HsnCode[]                    @relation("CompanyHsnCode")
  ledgerGroups                LedgerGroup[]                @relation("CompanyLedgerGroup")
  gstRates                    GstRate[]                    @relation("CompanyGstRate")
  /// Books are frozen on and before this date (set after filing); postings are refused (P1-09).
  booksFrozenUpTo             DateTime?                    @map("books_frozen_up_to") @db.Date

  @@map("companies")
}

model WhatsappConfig {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @unique @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  phoneNumberId      String   @db.VarChar(50)
  wabaId             String   @db.VarChar(50)
  businessPhone      String   @db.VarChar(20)
  accessToken        String
  webhookVerifyToken String?  @db.VarChar(100)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  company Company @relation("CompanyWhatsappConfig", fields: [companyId], references: [id], onDelete: Restrict)

  @@map("whatsapp_configs")
}

model EmailConfig {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  smtpHost     String   @db.VarChar(200)
  smtpPort     Int
  smtpUsername String   @db.VarChar(200)
  smtpPassword String   @db.VarChar(200)
  fromEmail    String   @db.VarChar(200)
  fromName     String   @db.VarChar(160)
  encryption   String   @default("TLS") @db.VarChar(20)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  company Company @relation("CompanyEmailConfig", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("email_configs")
}

model BusinessPlace {
  id               BigInt            @id @default(autoincrement())
  companyId        String            @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  code             String            @db.VarChar(20)
  name             String            @db.VarChar(120)
  type             BusinessPlaceType
  gstPlaceCode     String?           @db.VarChar(2)
  /// GSTIN of this place when registered separately (branch registration); state code in gstPlaceCode.
  gstin            String?           @db.VarChar(15)
  phone            String?           @db.VarChar(20)
  email            String?           @db.VarChar(120)
  isHeadOffice     Boolean           @default(false)
  isActive         Boolean           @default(true)
  address          Json?
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  machines         Machine[]
  stores           Store[]
  salesInvoices    SalesInvoice[]    @relation("SalesInvoiceBusinessPlace")
  grnInvoices      GrnInvoice[]      @relation("GrnInvoiceBusinessPlace")
  salesReturns     SalesReturn[]     @relation("SalesReturnBusinessPlace")
  purchaseReturns  PurchaseReturn[]  @relation("PurchaseReturnBusinessPlace")
  vouchers         Voucher[]         @relation("VoucherBusinessPlace")
  goodsDispatches  GoodsDispatch[]   @relation("GoodsDispatchBusinessPlace")
  expenses         Expense[]         @relation("ExpenseBusinessPlace")
  pettyCashEntries PettyCashEntry[]  @relation("PettyCashBusinessPlace")

  company Company @relation("CompanyBusinessPlace", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("business_places")
}

model Route {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  routeCode String
  routeName String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  company                Company                 @relation("CompanyRoute", fields: [companyId], references: [id], onDelete: Restrict)
  mobileVisits           MobileVisit[]
  mobileRouteCustomers   MobileRouteCustomer[]
  mobileRouteAssignments MobileRouteAssignment[]

  @@unique([companyId, routeCode])
  @@map("routes")
}

model SupplierMaterialPrice {
  id            String    @id @default(uuid())
  companyId     String    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  supplierId    Int
  rawMaterialId String
  price         Decimal
  validFrom     DateTime
  validTo       DateTime?
  createdAt     DateTime  @default(now())
  supplier      Supplier  @relation(fields: [supplierId], references: [id])

  company Company @relation("CompanySupplierMaterialPrice", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([supplierId, rawMaterialId, validFrom, validTo])
  @@index([companyId])
