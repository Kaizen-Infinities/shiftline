  heading     Decimal? @db.Decimal(6, 2)
  batteryPct  Int?     @map("battery_pct")
  recordedAt  DateTime @map("recorded_at") @db.Timestamptz(6)
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  company Company @relation("CompanyAgentPosition", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, agentUserId, recordedAt])
  @@index([companyId, receivedAt])
  @@map("agent_positions")
}

// ─── Platform backups (P0-13) ─────────────────────────────────────────────────

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// One row per pg_dump run (daily job or manual). Platform table: no companyId,
/// readable by platform admins only. MCA Rule 3(5): daily backup of the books.
model BackupRun {
  id          BigInt       @id @default(autoincrement())
  status      BackupStatus @default(RUNNING)
  fileName    String?      @map("file_name") @db.VarChar(255)
  bytes       BigInt?
  sha256      String?      @db.VarChar(64)
  durationMs  Int?         @map("duration_ms")
  error       String?      @db.VarChar(1000)
  triggeredBy String?      @map("triggered_by") @db.VarChar(36)
  jobId       String?      @map("job_id") @db.VarChar(64)
  startedAt   DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime?    @map("finished_at") @db.Timestamptz(6)

  @@index([startedAt])
  @@map("backup_runs")
}

// ─── Invitations (P1-00) ──────────────────────────────────────────────────────

/// A pending user invitation. The raw token travels only in the email link;
/// the row keeps its sha256. Accepting creates the user with the invited role.
model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  email          String    @db.VarChar(120)
  fullName       String?   @map("full_name") @db.VarChar(160)
  roleId         Int       @map("role_id")
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedUserId String?   @map("accepted_user_id") @db.VarChar(36)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  invitedBy      String?   @map("invited_by") @db.VarChar(36)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyInvitation", fields: [companyId], references: [id], onDelete: Restrict)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([companyId, email])
  @@map("invitations")
}

// ─── E-invoicing (P1-11) ──────────────────────────────────────────────────────

enum EInvoiceStatus {
  PENDING
  GENERATED
  FAILED
  CANCELLED
}

/// Per-tenant e-invoice setup: which provider, whether it is on, from when, and the GSP
/// credentials (secrets encrypted with DATA_ENCRYPTION_KEY, never returned to the client).
model EInvoiceConfig {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @unique @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  /// FIXTURE (recorded responses, tests and demos) | GSP (a GST Suvidha Provider over HTTPS)
  provider       String    @default("FIXTURE") @db.VarChar(20)
  enabled        Boolean   @default(false)
  /// Documents dated on or after this day need an IRN.
  applicableFrom DateTime? @map("applicable_from") @db.Date
  /// Aggregate annual turnover in crore; at 10 and above the IRN must be raised within 30 days.
  aatoCrore      Decimal?  @map("aato_crore") @db.Decimal(10, 2)
  baseUrl        String?   @map("base_url") @db.VarChar(200)
  clientId       String?   @map("client_id") @db.VarChar(200)
  clientSecret   String?   @map("client_secret") @db.VarChar(500)
  username       String?   @db.VarChar(200)
  password       String?   @db.VarChar(500)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz(6)
  updatedBy      String?   @map("updated_by") @db.VarChar(36)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyEInvoiceConfig", fields: [companyId], references: [id], onDelete: Restrict)

  @@map("e_invoice_configs")
}

/// One row per document sent to the Invoice Registration Portal: the request as sent, the
/// IRN, acknowledgement and signed QR that came back, and the cancellation if any. Audited.
model EInvoice {
  id            String         @id @default(uuid()) @db.Uuid
  companyId     String         @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  /// INV (tax invoice) | CRN (credit note) | DBN (debit note)
  docType       String         @map("doc_type") @db.VarChar(3)
  docId         String         @map("doc_id") @db.Uuid
  docNo         String         @map("doc_no") @db.VarChar(30)
  docDate       DateTime       @map("doc_date") @db.Date
  sellerGstin   String         @map("seller_gstin") @db.VarChar(15)
  buyerGstin    String         @map("buyer_gstin") @db.VarChar(15)
  status        EInvoiceStatus @default(PENDING)
  irn           String?        @db.VarChar(64)
  ackNo         String?        @map("ack_no") @db.VarChar(30)
  ackDate       DateTime?      @map("ack_date") @db.Timestamptz(6)
  signedInvoice String?        @map("signed_invoice")
  signedQr      String?        @map("signed_qr")
  ewbNo         String?        @map("ewb_no") @db.VarChar(20)
  ewbDate       DateTime?      @map("ewb_date") @db.Timestamptz(6)
  ewbValidTill  DateTime?      @map("ewb_valid_till") @db.Timestamptz(6)
  request       Json
  response      Json?
  error         String?        @db.VarChar(1000)
  attempts      Int            @default(0)
  requestedBy   String?        @map("requested_by") @db.VarChar(36)
  cancelledAt   DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy   String?        @map("cancelled_by") @db.VarChar(36)
  cancelReason  String?        @map("cancel_reason") @db.VarChar(2)
  cancelRemarks String?        @map("cancel_remarks") @db.VarChar(100)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyEInvoice", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, docType, docId])
  @@unique([companyId, irn])
  @@index([companyId, status])
  @@map("e_invoices")
}

// ─── E-way bills (P1-12) ──────────────────────────────────────────────────────

enum EwayBillStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
  FAILED
}

/// Transporter master: who carries the goods; the transporter id (GSTIN or TRANSIN) goes on
/// the e-way bill when the transporter, not the consignor, updates Part B.
model Transporter {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  code          String   @db.VarChar(20)
  name          String   @db.VarChar(120)
  transporterId String?  @map("transporter_id") @db.VarChar(15)
  phone         String?  @db.VarChar(20)
  email         String?  @db.VarChar(120)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyTransporter", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("transporters")
}

/// One e-way bill per movement of a document: generated from the IRN when there is one, else
/// standalone; Part B (vehicle) and extension history in `updates`. Audited.
model EwayBill {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  /// INV (tax invoice) | CHL (delivery challan: goods dispatch)
  docType         String         @map("doc_type") @db.VarChar(3)
  /// The document's primary key as text (invoices are uuid, dispatches bigint).
  docRef          String         @map("doc_ref") @db.VarChar(40)
  docNo           String         @map("doc_no") @db.VarChar(30)
  docDate         DateTime       @map("doc_date") @db.Date
  eInvoiceId      String?        @map("e_invoice_id") @db.Uuid
  irn             String?        @db.VarChar(64)
  ewbNo           String?        @map("ewb_no") @db.VarChar(12)
  ewbDate         DateTime?      @map("ewb_date") @db.Timestamptz(6)
  validUpto       DateTime?      @map("valid_upto") @db.Timestamptz(6)
  status          EwayBillStatus @default(PENDING)
  fromGstin       String         @map("from_gstin") @db.VarChar(15)
  fromPincode     String         @map("from_pincode") @db.VarChar(6)
  fromStateCode   String         @map("from_state_code") @db.VarChar(2)
  toGstin         String?        @map("to_gstin") @db.VarChar(15)
  toPincode       String         @map("to_pincode") @db.VarChar(6)
  toStateCode     String         @map("to_state_code") @db.VarChar(2)
  distanceKm      Int            @default(0) @map("distance_km")
  /// 1 road, 2 rail, 3 air, 4 ship
  transMode       String         @default("1") @map("trans_mode") @db.VarChar(1)
  transporterId   String?        @map("transporter_id") @db.VarChar(15)
  transporterName String?        @map("transporter_name") @db.VarChar(120)
  transDocNo      String?        @map("trans_doc_no") @db.VarChar(30)
  transDocDate    DateTime?      @map("trans_doc_date") @db.Date
  vehicleNo       String?        @map("vehicle_no") @db.VarChar(15)
  /// R regular, O over-dimensional cargo
  vehicleType     String         @default("R") @map("vehicle_type") @db.VarChar(1)
  totalValue      Decimal        @default(0) @map("total_value") @db.Decimal(14, 2)
  request         Json
  response        Json?
  error           String?        @db.VarChar(1000)
  attempts        Int            @default(0)
  /// Part B updates and extensions as they happened.
  updates         Json           @default("[]")
  extensions      Int            @default(0)
  consolidatedNo  String?        @map("consolidated_no") @db.VarChar(12)
  cancelledAt     DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy     String?        @map("cancelled_by") @db.VarChar(36)
  cancelReason    String?        @map("cancel_reason") @db.VarChar(1)
  cancelRemarks   String?        @map("cancel_remarks") @db.VarChar(100)
  requestedBy     String?        @map("requested_by") @db.VarChar(36)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyEwayBill", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, ewbNo])
  @@index([companyId, docType, docRef])
  @@index([companyId, status, validUpto])
  @@map("eway_bills")
}

/// A trip sheet: several e-way bills moving on one vehicle.
model ConsolidatedEwayBill {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  cewbNo        String   @map("cewb_no") @db.VarChar(12)
  cewbDate      DateTime @map("cewb_date") @db.Timestamptz(6)
  vehicleNo     String   @map("vehicle_no") @db.VarChar(15)
  fromPlace     String   @map("from_place") @db.VarChar(50)
  fromStateCode String   @map("from_state_code") @db.VarChar(2)
  transMode     String   @default("1") @map("trans_mode") @db.VarChar(1)
  transDocNo    String?  @map("trans_doc_no") @db.VarChar(30)
  ewbNos        Json     @map("ewb_nos")
  request       Json
  response      Json?
  createdBy     String?  @map("created_by") @db.VarChar(36)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation("CompanyConsolidatedEwayBill", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, cewbNo])
  @@map("consolidated_eway_bills")
}

// ─── Input tax credit ledger (P1-13b) ─────────────────────────────────────────

enum ItcStatus {
  ELIGIBLE
  INELIGIBLE
  REVERSED
  RECLAIMED
  VOID
}

/// One row per inward document carrying GST: what credit it brings, whether it may be taken
/// (section 17(5) by HSN, or a manual call), whether it was reversed (180-day non-payment) and
/// reclaimed. Rebuilt from the documents each time a period is computed; rows are updated,
/// never deleted, and a cancelled document leaves a VOID row. Audited.
model ItcEntry {
  id              String     @id @default(uuid()) @db.Uuid
  companyId       String     @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  /// Month the credit is availed in (2026-08).
  periodKey       String     @map("period_key") @db.VarChar(7)
  /// GRN | EXPENSE | PETTY_CASH
  docType         String     @map("doc_type") @db.VarChar(12)
  docId           String     @map("doc_id") @db.VarChar(40)
  docNo           String     @map("doc_no") @db.VarChar(40)
  docDate         DateTime   @map("doc_date") @db.Date
  supplierGstin   String?    @map("supplier_gstin") @db.VarChar(15)
  hsnCode         String?    @map("hsn_code") @db.VarChar(8)
  /// RCM | IMPORT_GOODS | IMPORT_SERVICES | ISD | OTHER (GSTR-3B table 4A rows)
  source          String     @default("OTHER") @db.VarChar(16)
  taxable         Decimal    @default(0) @db.Decimal(14, 2)
  igst            Decimal    @default(0) @db.Decimal(14, 2)
  cgst            Decimal    @default(0) @db.Decimal(14, 2)
  sgst            Decimal    @default(0) @db.Decimal(14, 2)
  cess            Decimal    @default(0) @db.Decimal(14, 2)
  status          ItcStatus  @default(ELIGIBLE)
  /// 17(5) | 180D | MANUAL | CANCELLED
  rule            String?    @db.VarChar(12)
  reason          String?    @db.VarChar(255)
  reversedPeriod  String?    @map("reversed_period") @db.VarChar(7)
  reclaimedPeriod String?    @map("reclaimed_period") @db.VarChar(7)
  /// A manual classification survives rebuilds.
  manualStatus    ItcStatus? @map("manual_status")
  manualReason    String?    @map("manual_reason") @db.VarChar(255)
  manualBy        String?    @map("manual_by") @db.VarChar(36)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyItcEntry", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, docType, docId])
  @@index([companyId, periodKey, status])
  @@map("itc_entries")
}

/// What the portal says about an inward document: accepted, rejected, or left to the default.
enum ImsStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// How a 2B record lines up with the purchase register (P1-13c).
enum Gstr2bMatchStatus {
  MATCHED
  MISMATCH
  MISSING_IN_2B
  MISSING_IN_BOOKS
}

/// One supplier document in a GSTR-2B, as the portal drew it for a period. Imported from the
/// portal JSON or pulled through a provider; never written by hand. The credit the company may
/// actually take is decided here, not in its own purchase register. Audited.
model Gstr2bRecord {
  id             String             @id @default(uuid()) @db.Uuid
  companyId      String             @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  /// The 2B period the record was drawn for (2026-08).
  periodKey      String             @map("period_key") @db.VarChar(7)
  /// The company's own GSTIN this 2B belongs to.
  gstin          String             @db.VarChar(15)
  supplierGstin  String             @map("supplier_gstin") @db.VarChar(15)
  supplierName   String?            @map("supplier_name") @db.VarChar(160)
  /// INV | CRN | DBN | ISD | IMPG | IMPS
  docType        String             @map("doc_type") @db.VarChar(4)
  docNo          String             @map("doc_no") @db.VarChar(40)
  /// The document number with case, spaces and punctuation stripped, for matching.
  docNoNorm      String             @map("doc_no_norm") @db.VarChar(40)
  docDate        DateTime           @map("doc_date") @db.Date
  docValue       Decimal            @default(0) @map("doc_value") @db.Decimal(14, 2)
  placeOfSupply  String?            @map("place_of_supply") @db.VarChar(2)
  reverseCharge  Boolean            @default(false) @map("reverse_charge")
  taxable        Decimal            @default(0) @db.Decimal(14, 2)
  igst           Decimal            @default(0) @db.Decimal(14, 2)
  cgst           Decimal            @default(0) @db.Decimal(14, 2)
  sgst           Decimal            @default(0) @db.Decimal(14, 2)
  cess           Decimal            @default(0) @db.Decimal(14, 2)
  /// The portal's own call on whether the credit is available ("Y"/"N") and why not.
  itcAvailable   Boolean            @default(true) @map("itc_available")
  itcReason      String?            @map("itc_reason") @db.VarChar(120)
  /// The period the supplier filed in, and the day they filed.
  filingPeriod   String?            @map("filing_period") @db.VarChar(7)
  filingDate     DateTime?          @map("filing_date") @db.Date
  /// FIXTURE | GSP | IMPORT (a file the accountant downloaded)
  sourceKind     String             @default("IMPORT") @map("source_kind") @db.VarChar(10)
  /// The record exactly as it arrived, so a disputed figure can be traced.
  raw            Json?
  /// Set when reconciliation places it against a purchase document.
  matchStatus    Gstr2bMatchStatus? @map("match_status")
  matchedDocType String?            @map("matched_doc_type") @db.VarChar(12)
  matchedDocId   String?            @map("matched_doc_id") @db.VarChar(40)
  /// Which fields differ, and by how much, when the status is MISMATCH.
  mismatchFields Json?              @map("mismatch_fields")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  imsAction ImsAction?

  company Company @relation("CompanyGstr2bRecord", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, periodKey, supplierGstin, docType, docNo])
  @@index([companyId, periodKey, matchStatus])
  @@index([companyId, supplierGstin, docNoNorm])
  @@map("gstr2b_records")
}

/// The company's call on one inward record in the Invoice Management System. A record left
/// PENDING when the return is drawn is accepted by the portal's own default, so the absence of
/// a decision is itself a decision — which is why a pending row is stored, not implied. Audited.
model ImsAction {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  recordId  String    @unique @map("record_id") @db.Uuid
  status    ImsStatus @default(PENDING)
  reason    String?   @db.VarChar(255)
  decidedBy String?   @map("decided_by") @db.VarChar(36)
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(6)
  /// When the action reached the portal, and what it said back.
  pushedAt  DateTime? @map("pushed_at") @db.Timestamptz(6)
  pushedBy  String?   @map("pushed_by") @db.VarChar(36)
  pushRef   String?   @map("push_ref") @db.VarChar(64)
  pushError String?   @map("push_error") @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  record  Gstr2bRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  company Company      @relation("CompanyImsAction", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@map("ims_actions")
}

/// Per-tenant tolerances for the GSTR-2B reconciliation (P2-10): how many days and how many
/// rupees a book document may differ from the supplier's filing and still count as a match.
/// One row per company, created with the package defaults the first time it is read.
model Gstr2bSettings {
  id                String               @id @default(uuid()) @db.Uuid
  companyId         String               @unique @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  dateToleranceDays Int                  @default(7) @map("date_tolerance_days")
  valueTolerance    Decimal              @default(1.00) @map("value_tolerance") @db.Decimal(10, 2)
  /// FIXTURE never reaches a live gateway; LIVE sends through the real WhatsApp/email services.
  /// Defaults to FIXTURE outside production so a demo tenant never sends for real by accident
  /// (P2-18 — replaces the old NODE_ENV check in `followup.providers.ts`).
  followUpProvider  FollowUpProviderKind @default(FIXTURE) @map("follow_up_provider")
  /// Days a MISSING_IN_2B/MISMATCH record can sit with no follow-up before the daily nudge job
  /// flags it (P2-18).
  nudgeAfterDays    Int                  @default(5) @map("nudge_after_days")
  updatedBy         String?              @map("updated_by") @db.VarChar(36)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyGstr2bSettings", fields: [companyId], references: [id], onDelete: Restrict)

  @@map("gstr2b_settings")
}

/// A supplier chased over a MISSING_IN_2B or MISMATCH record of the month's reconciliation
/// (P2-10). Operational history, not a book or a document, so it is not audited — but it is
/// tenant-scoped like everything else, and it is the record of who was told what and when.
model SupplierFollowUp {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  periodKey     String          @map("period_key") @db.VarChar(7)
  gstin         String          @db.VarChar(15)
  supplierGstin String          @map("supplier_gstin") @db.VarChar(15)
  supplierName  String?         @map("supplier_name") @db.VarChar(160)
  channel       FollowUpChannel
  /// The record ids the message names: a Gstr2bRecord uuid for a mismatch, or `DOCTYPE:docId`
  /// for a book document the supplier never filed.
  recordIds     Json            @map("record_ids")
  recipient     String          @db.VarChar(160)
  message       String
  status        FollowUpStatus
  error         String?         @db.VarChar(255)
  sentAt        DateTime        @default(now()) @map("sent_at") @db.Timestamptz(6)
  sentBy        String?         @map("sent_by") @db.VarChar(36)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation("CompanySupplierFollowUp", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, periodKey, gstin, supplierGstin, sentAt])
  @@map("supplier_follow_ups")
}

enum FollowUpChannel {
  WHATSAPP
  EMAIL
}

/// Which follow-up channel implementation `Gstr2bSettings.followUpProvider` selects (P2-18).
enum FollowUpProviderKind {
  FIXTURE
  LIVE
}

enum FollowUpStatus {
  SENT
  FAILED
}

/// How an export or SEZ supply was made: under a bond/LUT with no tax, or on payment of IGST.
enum ExportType {
  UNDER_LUT
  WITH_TAX
}

/// Where a daily exchange rate came from.
enum RateSource {
  MANUAL
  RBI
  IMPORT
}

/// A currency the company transacts in. INR is seeded for every tenant and cannot be retired:
/// the books are kept in it, and every foreign document converts to it before it posts.
model Currency {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  /// ISO 4217, e.g. USD.
  code      String   @db.VarChar(3)
  name      String   @db.VarChar(60)
  symbol    String?  @db.VarChar(6)
  /// Minor units: 2 for most, 0 for JPY.
  decimals  Int      @default(2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rates ExchangeRate[]

  company Company @relation("CompanyCurrency", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("currencies")
}

/// One currency's rate against INR for one day. Rates are never edited in place once a document
/// has used one: a correction is a new row for the day, and the document keeps the rate it was
/// posted at, because that is what the books are in.
model ExchangeRate {
  id           String     @id @default(uuid()) @db.Uuid
  companyId    String     @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  currencyCode String     @map("currency_code") @db.VarChar(3)
  rateDate     DateTime   @map("rate_date") @db.Date
  /// Rupees for one unit of the currency.
  rate         Decimal    @db.Decimal(14, 6)
  source       RateSource @default(MANUAL)
  createdBy    String?    @map("created_by") @db.VarChar(36)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  currency Currency @relation(fields: [companyId, currencyCode], references: [companyId, code])

  company Company @relation("CompanyExchangeRate", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, currencyCode, rateDate])
  @@index([companyId, currencyCode, rateDate])
  @@map("exchange_rates")
}

/// Money taken before the invoice exists. GST is payable on an advance for a service when it is
/// received, so the receipt carries its own tax and its own document number, and the tax is
/// adjusted — not charged again — when the invoice finally goes out. Audited.
model AdvanceReceipt {
  id              String     @id @default(uuid()) @db.Uuid
  companyId       String     @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  receiptNo       String     @map("receipt_no") @db.VarChar(30)
  receiptDate     DateTime   @map("receipt_date") @db.Date
  customerId      String     @map("customer_id") @db.Uuid
  businessPlaceId BigInt?    @map("business_place_id")
  /// The gross amount received, tax included.
  amount          Decimal    @db.Decimal(14, 2)
  /// The value the tax was worked out on: amount less the tax in it.
  taxable         Decimal    @default(0) @db.Decimal(14, 2)
  gstRate         Decimal    @default(0) @map("gst_rate") @db.Decimal(5, 2)
  igst            Decimal    @default(0) @db.Decimal(14, 2)
  cgst            Decimal    @default(0) @db.Decimal(14, 2)
  sgst            Decimal    @default(0) @db.Decimal(14, 2)
  cess            Decimal    @default(0) @db.Decimal(14, 2)
  placeOfSupply   String?    @map("place_of_supply") @db.VarChar(2)
  supplyType      SupplyType @default(INTRA_STATE) @map("supply_type")
  customerGstin   String?    @map("customer_gstin") @db.VarChar(15)
  paymentMethod   String     @default("Bank") @map("payment_method") @db.VarChar(50)
  referenceNumber String?    @map("reference_number") @db.VarChar(100)
  narration       String?    @db.VarChar(500)
  /// How much of the advance has been used up by invoices or refunded.
  adjustedAmount  Decimal    @default(0) @map("adjusted_amount") @db.Decimal(14, 2)
  refundedAmount  Decimal    @default(0) @map("refunded_amount") @db.Decimal(14, 2)
  /// OPEN | PART_ADJUSTED | CLOSED
  status          String     @default("OPEN") @db.VarChar(20)
  createdBy       String?    @map("created_by") @db.VarChar(36)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Cancelled documents stay on file (MCA Rule 3(1)); their vouchers are reversed (P1-09).
  cancelledAt     DateTime?  @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy     String?    @map("cancelled_by") @db.VarChar(36)
  cancelReason    String?    @map("cancel_reason") @db.VarChar(255)

  customer      Customer            @relation(fields: [customerId], references: [id])
  businessPlace BusinessPlace?      @relation("AdvanceReceiptBusinessPlace", fields: [businessPlaceId], references: [id])
  adjustments   AdvanceAdjustment[]

  company Company @relation("CompanyAdvanceReceipt", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, receiptNo])
  @@index([companyId, customerId, status])
  @@map("advance_receipts")
}

/// One advance applied against one invoice, or refunded. The tax already paid on the advance
/// comes off the invoice's liability, which is what GSTR-1 table 11B reports. Audited.
model AdvanceAdjustment {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  advanceId       String   @map("advance_id") @db.Uuid
  /// Null for a refund: the advance is given back rather than used.
  salesInvoiceId  String?  @map("sales_invoice_id") @db.Uuid
  /// ADJUSTED | REFUNDED
  kind            String   @default("ADJUSTED") @db.VarChar(10)
  amount          Decimal  @db.Decimal(14, 2)
  taxable         Decimal  @default(0) @db.Decimal(14, 2)
  igst            Decimal  @default(0) @db.Decimal(14, 2)
  cgst            Decimal  @default(0) @db.Decimal(14, 2)
  sgst            Decimal  @default(0) @db.Decimal(14, 2)
  /// The refund voucher's own number, when this is a refund.
  refundVoucherNo String?  @map("refund_voucher_no") @db.VarChar(30)
  adjustedOn      DateTime @map("adjusted_on") @db.Date
  createdBy       String?  @map("created_by") @db.VarChar(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  advance      AdvanceReceipt @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  salesInvoice SalesInvoice?  @relation(fields: [salesInvoiceId], references: [id])

  company Company @relation("CompanyAdvanceAdjustment", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, advanceId])
  @@index([salesInvoiceId])
  @@map("advance_adjustments")
}

/// Why goods are moving when they are not being sold (P1-14).
enum ChallanKind {
  /// Sent to a job worker for processing.
  JOB_WORK_OUT
  /// Coming back from a job worker, against an out challan.
  JOB_WORK_RETURN
  /// Between the company's own registered places.
  BRANCH_TRANSFER
  /// To an exhibition or a trade fair.
  EXHIBITION
  /// Out on a van for line sales; what is not sold comes back.
  LINE_SALES
  OTHER
}

enum ChallanStatus {
  OPEN
  PART_RETURNED
  CLOSED
  CANCELLED
}

/// Someone who processes the company's goods and sends them back. Registered or not: an
/// unregistered job worker is common and changes who accounts for the movement, so the GSTIN
/// is optional and its absence is meaningful.
model JobWorker {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  code          String   @db.VarChar(20)
  name          String   @db.VarChar(160)
  gstin         String?  @db.VarChar(15)
  stateCode     String?  @map("state_code") @db.VarChar(2)
  addressLine1  String?  @map("address_line1") @db.VarChar(255)
  city          String?  @db.VarChar(100)
  pincode       String?  @db.VarChar(10)
  contactPerson String?  @map("contact_person") @db.VarChar(120)
  phone         String?  @db.VarChar(20)
  email         String?  @db.VarChar(120)
  /// What they do, for the register.
  processType   String?  @map("process_type") @db.VarChar(80)
  isActive      Boolean  @default(true) @map("is_active")
  createdBy     String?  @map("created_by") @db.VarChar(36)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  challans     DeliveryChallan[]
  /// Movements sent on from this worker to another (ITC-04 table 5B).
  challansFrom DeliveryChallan[] @relation("ChallanFromJobWorker")

  company Company @relation("CompanyJobWorker", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("job_workers")
}

/// Goods leaving without a sale. The credit taken on inputs sent for job work is only safe while
/// they come back within a year — three years for capital goods — so the clock starts here and
/// the balance on the challan is what it is measured against. Audited.
model DeliveryChallan {
  id                String        @id @default(uuid()) @db.Uuid
  companyId         String        @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  challanNo         String        @map("challan_no") @db.VarChar(30)
  challanDate       DateTime      @map("challan_date") @db.Date
  kind              ChallanKind
  status            ChallanStatus @default(OPEN)
  jobWorkerId       String?       @map("job_worker_id") @db.Uuid
  /// Set when this movement is between two job workers (ITC-04 table 5B): the worker the goods
  /// leave from; `jobWorkerId` is who they arrive at.
  fromJobWorkerId   String?       @map("from_job_worker_id") @db.Uuid
  /// The challan this one returns goods against (a JOB_WORK_RETURN).
  parentChallanId   String?       @map("parent_challan_id") @db.Uuid
  businessPlaceId   BigInt?       @map("business_place_id")
  /// Where the goods left from, and where a branch transfer is going.
  storeId           String?       @map("store_id") @db.VarChar(20)
  toBusinessPlaceId BigInt?       @map("to_business_place_id")
  placeOfSupply     String?       @map("place_of_supply") @db.VarChar(2)
  supplyType        SupplyType    @default(INTRA_STATE) @map("supply_type")
  purpose           String?       @db.VarChar(255)
  /// Capital goods get three years to come back instead of one.
  capitalGoods      Boolean       @default(false) @map("capital_goods")
  /// Day the goods have to be back by; the rule that set it travels with it.
  returnDueDate     DateTime?     @map("return_due_date") @db.Date
  /// The notional value the movement is worth, for the e-way bill.
  taxable           Decimal       @default(0) @db.Decimal(14, 2)
  igst              Decimal       @default(0) @db.Decimal(14, 2)
  cgst              Decimal       @default(0) @db.Decimal(14, 2)
  sgst              Decimal       @default(0) @db.Decimal(14, 2)
  totalValue        Decimal       @default(0) @map("total_value") @db.Decimal(14, 2)
  transporterName   String?       @map("transporter_name") @db.VarChar(120)
  vehicleNumber     String?       @map("vehicle_number") @db.VarChar(20)
  remarks           String?       @db.VarChar(500)
  /// Set once every line is accounted for, by return, consumption or scrap.
  closedAt          DateTime?     @map("closed_at") @db.Timestamptz(6)
  createdBy         String?       @map("created_by") @db.VarChar(36)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Cancelled documents stay on file (MCA Rule 3(1)).
  cancelledAt       DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy       String?       @map("cancelled_by") @db.VarChar(36)
  cancelReason      String?       @map("cancel_reason") @db.VarChar(255)

  jobWorker     JobWorker?            @relation(fields: [jobWorkerId], references: [id])
  fromJobWorker JobWorker?            @relation("ChallanFromJobWorker", fields: [fromJobWorkerId], references: [id])
  parentChallan DeliveryChallan?      @relation("ChallanReturns", fields: [parentChallanId], references: [id])
  returns       DeliveryChallan[]     @relation("ChallanReturns")
  businessPlace BusinessPlace?        @relation("ChallanBusinessPlace", fields: [businessPlaceId], references: [id])
  items         DeliveryChallanItem[]

  company Company @relation("CompanyDeliveryChallan", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, challanNo])
  @@index([companyId, kind, status])
  @@index([companyId, jobWorkerId])
  @@index([returnDueDate])
  @@map("delivery_challans")
}

/// One line of a challan, and what became of it. A line is accounted for when what was sent
/// equals what came back plus what was consumed in the process plus what was scrapped.
model DeliveryChallanItem {
  id                      String           @id @default(uuid()) @db.Uuid
  companyId               String           @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  challanId               String           @map("challan_id") @db.Uuid
  /// On a return-challan line: the parent challan's line it is returning against, so the receipt
  /// posts to the parent in the same transaction the return is raised in.
  parentItemId            String?          @map("parent_item_id") @db.Uuid
  itemType                ItemCategoryType @map("item_type")
  rawMaterialId           String?          @map("raw_material_id") @db.VarChar(20)
  productItemId           BigInt?          @map("product_item_id")
  description             String?          @db.VarChar(255)
  uom                     String?          @db.VarChar(20)
  hsnCode                 String?          @map("hsn_code") @db.VarChar(8)
  quantitySent            Decimal          @default(0) @map("quantity_sent") @db.Decimal(14, 3)
  quantityReturned        Decimal          @default(0) @map("quantity_returned") @db.Decimal(14, 3)
  /// Used up in the process and never coming back as itself.
  quantityConsumed        Decimal          @default(0) @map("quantity_consumed") @db.Decimal(14, 3)
  quantityScrap           Decimal          @default(0) @map("quantity_scrap") @db.Decimal(14, 3)
  /// ITC-04 table 5C: supplied directly from the job worker's premises rather than returned.
  quantityDirectSupply    Decimal          @default(0) @map("quantity_direct_supply") @db.Decimal(14, 3)
  directSupplyInvoiceNo   String?          @map("direct_supply_invoice_no") @db.VarChar(30)
  directSupplyInvoiceDate DateTime?        @map("direct_supply_invoice_date") @db.Date
  rate                    Decimal          @default(0) @db.Decimal(14, 2)
  taxableAmount           Decimal          @default(0) @map("taxable_amount") @db.Decimal(14, 2)
  gstRate                 Decimal          @default(0) @map("gst_rate") @db.Decimal(5, 2)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  challan     DeliveryChallan       @relation(fields: [challanId], references: [id], onDelete: Cascade)
  parentItem  DeliveryChallanItem?  @relation("ChallanItemReturn", fields: [parentItemId], references: [id])
  returnItems DeliveryChallanItem[] @relation("ChallanItemReturn")
  rawMaterial RawMaterial?          @relation(fields: [companyId, rawMaterialId], references: [companyId, rawMaterialId])
  product     Product?              @relation(fields: [productItemId], references: [id])

  company Company @relation("CompanyDeliveryChallanItem", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([challanId])
  @@index([companyId, rawMaterialId])
  @@index([parentItemId])
  @@map("delivery_challan_items")
}

/// Who the payee is decides the rate on several sections, and the return asks for it.
enum DeducteeType {
  COMPANY
  INDIVIDUAL_HUF
  FIRM
  AOP_BOI
  LOCAL_AUTHORITY
  NON_RESIDENT
}

/// Where a deduction came from, which decides the quarter it is reported in.
enum TdsEventKind {
  /// Deducted when the bill was booked.
  ON_BILL
  /// Deducted when the money went out.
  ON_PAYMENT
  /// Collected on a sale (TCS).
  ON_COLLECTION
}

enum TdsDeductionStatus {
  PENDING
  CHALLAN_PAID
  RETURN_FILED
  CANCELLED
}

/// A section tax is deducted or collected under (P1-15).
///
/// The Income-tax Act 2025 renumbers the sections — deduction at source sits in section 393 and
/// collection in 394, each with a table of items — but every accountant, every challan and every
/// return utility still says 194C and 194J. So both live on the row: `code` is what people type
/// and what the return carries, `actCode` is where it sits in the new Act.
model TdsSection {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  /// The familiar code: 194C, 194J, 194Q, 206C(1H).
  code            String   @db.VarChar(20)
  /// Where it sits in the Income-tax Act 2025: "393 Table item 2" and so on.
  actCode         String?  @map("act_code") @db.VarChar(40)
  name            String   @db.VarChar(160)
  /// True for a collection at source (section 394) rather than a deduction (393).
  isTcs           Boolean  @default(false) @map("is_tcs")
  /// Rate when the payee is a company or a firm.
  rateCompany     Decimal  @default(0) @map("rate_company") @db.Decimal(5, 2)
  /// Rate when the payee is an individual or a HUF; several sections differ.
  rateIndividual  Decimal  @default(0) @map("rate_individual") @db.Decimal(5, 2)
  /// Rate when no PAN is furnished (section 206AA) or the payee is a non-filer (206AB).
  rateNoPan       Decimal  @default(20) @map("rate_no_pan") @db.Decimal(5, 2)
  /// Deduct only once a single payment crosses this; zero means no single-payment threshold.
  thresholdSingle Decimal  @default(0) @map("threshold_single") @db.Decimal(14, 2)
  /// Deduct once the year's payments to this payee cross this.
  thresholdAnnual Decimal  @default(0) @map("threshold_annual") @db.Decimal(14, 2)
  /// The ledger the liability is credited to; one per section keeps the challan reconcilable.
  ledgerCode      String?  @map("ledger_code") @db.VarChar(20)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  deductions TdsDeduction[]

  company Company @relation("CompanyTdsSection", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("tds_sections")
}

/// One deduction or collection. Never deleted — a return has been filed against it — only
/// cancelled when the document behind it is. Audited.
model TdsDeduction {
  id            String             @id @default(uuid()) @db.Uuid
  companyId     String             @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  sectionId     String             @map("section_id") @db.Uuid
  /// The payee. A supplier for 26Q; a non-resident payee is still a supplier row (27Q).
  supplierId    Int?               @map("supplier_id")
  /// P2-05: the buyer a TCS collection (section 394) was raised on. Deductions and collections
  /// are the same row shape but never share a payee type.
  customerId    String?            @map("customer_id") @db.Uuid
  /// Copied at the time of deduction: the return carries what was true then.
  deducteeName  String             @map("deductee_name") @db.VarChar(160)
  deducteePan   String?            @map("deductee_pan") @db.VarChar(10)
  deducteeType  DeducteeType       @default(COMPANY) @map("deductee_type")
  /// True when no PAN was available, or the payee is a non-filer under 206AB.
  higherRate    Boolean            @default(false) @map("higher_rate")
  kind          TdsEventKind       @default(ON_BILL)
  /// EXPENSE | GRN | PETTY_CASH | SALES_INVOICE (for TCS)
  docType       String             @map("doc_type") @db.VarChar(16)
  docId         String             @map("doc_id") @db.VarChar(40)
  docNo         String             @map("doc_no") @db.VarChar(40)
  deductionDate DateTime           @map("deduction_date") @db.Date
  /// The whole amount paid or credited to the payee. Thresholds accumulate against this, and
  /// it is what the return's "amount paid" column carries.
  amountPaid    Decimal            @default(0) @map("amount_paid") @db.Decimal(14, 2)
  /// The part of it the rate was actually applied to. For most sections that is the whole
  /// amount; for 194Q and 206C(1H) it is only what sits above the annual threshold.
  taxableAmount Decimal            @default(0) @map("taxable_amount") @db.Decimal(14, 2)
  rate          Decimal            @default(0) @db.Decimal(5, 2)
  tdsAmount     Decimal            @default(0) @map("tds_amount") @db.Decimal(14, 2)
  /// Financial year `2026-27` and the quarter `Q1`..`Q4`, both derived from the date.
  fyCode        String             @map("fy_code") @db.VarChar(7)
  quarter       String             @db.VarChar(2)
  challanId     String?            @map("challan_id") @db.Uuid
  status        TdsDeductionStatus @default(PENDING)
  /// Why the rate was what it was, for the person who has to explain it later.
  rateReason    String?            @map("rate_reason") @db.VarChar(160)
  createdBy     String?            @map("created_by") @db.VarChar(36)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  cancelledAt   DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancelReason  String?            @map("cancel_reason") @db.VarChar(255)

  section  TdsSection  @relation(fields: [sectionId], references: [id])
  supplier Supplier?   @relation(fields: [supplierId], references: [id])
  customer Customer?   @relation("CustomerTdsDeduction", fields: [customerId], references: [id])
  challan  TdsChallan? @relation(fields: [challanId], references: [id])

  company Company @relation("CompanyTdsDeduction", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, docType, docId, sectionId])
  @@index([companyId, fyCode, quarter])
  @@index([companyId, status])
  @@index([challanId])
  @@index([customerId])
  @@map("tds_deductions")
}

/// A challan (ITNS 281) paying a month's deductions to the government. The deductions it covers
/// point at it, which is what makes a return reconcile: every deduction in a quarter has to sit
/// on a challan, and every challan's total has to equal the deductions on it. Audited.
model TdsChallan {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  /// Bank branch code, 7 digits — half of the challan's identity.
  bsrCode       String   @map("bsr_code") @db.VarChar(7)
  /// The bank's serial number for the day.
  challanSerial String   @map("challan_serial") @db.VarChar(10)
  challanDate   DateTime @map("challan_date") @db.Date
  /// The month the deductions belong to, `2026-08`.
  periodKey     String   @map("period_key") @db.VarChar(7)
  fyCode        String   @map("fy_code") @db.VarChar(7)
  quarter       String   @db.VarChar(2)
  /// What was actually paid, split the way the challan is.
  tdsAmount     Decimal  @default(0) @map("tds_amount") @db.Decimal(14, 2)
  surcharge     Decimal  @default(0) @db.Decimal(14, 2)
  educationCess Decimal  @default(0) @map("education_cess") @db.Decimal(14, 2)
  interest      Decimal  @default(0) @db.Decimal(14, 2)
  lateFee       Decimal  @default(0) @map("late_fee") @db.Decimal(14, 2)
  totalAmount   Decimal  @default(0) @map("total_amount") @db.Decimal(14, 2)
  /// 200 for a regular payment, 400 for one raised by a demand.
  paymentCode   String   @default("200") @map("payment_code") @db.VarChar(3)
  /// True for a collection challan (TCS) rather than a deduction one.
  isTcs         Boolean  @default(false) @map("is_tcs")
  remarks       String?  @db.VarChar(255)
  createdBy     String?  @map("created_by") @db.VarChar(36)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  deductions TdsDeduction[]

  company Company @relation("CompanyTdsChallan", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, bsrCode, challanSerial, challanDate])
  @@index([companyId, fyCode, quarter])
  @@map("tds_challans")
}

// ── Tally XML export (P1-06) ──────────────────────────────────────────────────

enum TallyNameKind {
  GROUP
  LEDGER
  UNIT
  STOCK_ITEM
  VOUCHER_TYPE
}

/// What something in our books is called in the tenant's Tally company (P1-06).
///
/// A Tally company that has been running for ten years has its own names, and an import has to
/// meet them where they are: a ledger imported under a name Tally does not have is created as a
/// new one, and the balance quietly splits in two. Built-in defaults cover Tally's reserved
/// groups; this table is the tenant's override on top of them.
model TallyNameMap {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  kind        TallyNameKind
  /// Our side: a ledger group code, ledger code, uom code, item code or voucher type.
  sourceCode  String        @map("source_code") @db.VarChar(60)
  /// What it is called in Tally.
  tallyName   String        @map("tally_name") @db.VarChar(160)
  /// The Tally group a ledger or group must be created under, when it is not the mapped default.
  tallyParent String?       @map("tally_parent") @db.VarChar(160)
  /// False keeps the row out of the export entirely — a ledger Tally is not to be told about.
  isExported  Boolean       @default(true) @map("is_exported")
  notes       String?       @db.VarChar(255)
  createdBy   String?       @map("created_by") @db.VarChar(36)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyTallyNameMap", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, kind, sourceCode])
  @@index([companyId, kind])
  @@map("tally_name_maps")
}

enum TallyExportScope {
  MASTERS
  VOUCHERS
  BOTH
}

enum TallyExportStatus {
  DRAFT
  CONFIRMED
  DISCARDED
}

/// One generated Tally file (P1-06).
///
/// The run is the watermark: the next incremental export starts where the last CONFIRMED one
/// ended, so a month can be handed over weekly without re-importing what the accountant already
/// has. Nothing here can know whether Tally accepted the file, which is why confirming is a
/// person's act.
model TallyExportRun {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  scope            TallyExportScope  @default(BOTH)
  /// The Tally company the file names in its request header.
  tallyCompany     String            @map("tally_company") @db.VarChar(160)
  fromDate         DateTime?         @map("from_date") @db.Date
  toDate           DateTime?         @map("to_date") @db.Date
  incremental      Boolean           @default(false)
  /// Only vouchers touched after this are in the file; taken from the last confirmed run.
  sinceAt          DateTime?         @map("since_at") @db.Timestamptz(6)
  /// The newest voucher timestamp the file covers, and where the next incremental run starts.
  throughAt        DateTime?         @map("through_at") @db.Timestamptz(6)
  /// How many of each kind of record the file carries.
  counts           Json
  sizeBytes        Int               @default(0) @map("size_bytes")
  payloadHash      String            @map("payload_hash") @db.VarChar(64)
  status           TallyExportStatus @default(DRAFT)
  notes            String?           @db.VarChar(255)
  requestedBy      String?           @map("requested_by") @db.VarChar(36)
  confirmedBy      String?           @map("confirmed_by") @db.VarChar(36)
  confirmedAt      DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  downloads        Int               @default(0)
  lastDownloadedAt DateTime?         @map("last_downloaded_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyTallyExportRun", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@map("tally_export_runs")
}

/// Micro, small or medium under the MSMED Act (P1-07). Only the first two carry section 15 and
/// section 43B(h) with them; a medium enterprise has neither.
enum MsmeCategory {
  MICRO
  SMALL
  MEDIUM
  NOT_REGISTERED
}

// ── Fixed assets and depreciation (P1-18) ─────────────────────────────────────

enum DepreciationMethod {
  SLM
  WDV
}

enum AssetStatus {
  ACTIVE
  DISPOSED
  WRITTEN_OFF
}

enum AssetEventKind {
  ADDITION
  REVALUATION
  TRANSFER
  DISPOSAL
  IMPAIRMENT
}

enum DepreciationRunStatus {
  DRAFT
  POSTED
  CANCELLED
  REVERSED
}

/// A class of asset (P1-18): what its useful life is under Schedule II, and which income-tax
/// block it falls in. The two live on the same row because they describe the same machine, but
/// they are never the same number — see `depreciation.calc.ts`.
model AssetClass {
  id                   String             @id @default(uuid()) @db.Uuid
  companyId            String             @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  code                 String             @db.VarChar(20)
  name                 String             @db.VarChar(120)
  /// Schedule II: the life in years the Act gives this kind of asset.
  usefulLifeYears      Int                @default(15) @map("useful_life_years")
  method               DepreciationMethod @default(SLM)
  /// Schedule II allows up to 5% of cost as residual; it is a percentage, not an amount.
  residualPercent      Decimal            @default(5) @map("residual_percent") @db.Decimal(5, 2)
  /// The Schedule II head the register groups under, e.g. "Plant and Machinery".
  scheduleIiHead       String?            @map("schedule_ii_head") @db.VarChar(80)
  /// Income-tax block name and rate. The block depreciates as a pool at this rate, not per asset.
  itBlockName          String?            @map("it_block_name") @db.VarChar(80)
  itBlockRate          Decimal            @default(15) @map("it_block_rate") @db.Decimal(5, 2)
  /// The three ledgers a class posts to. Codes rather than ids so a seed can name them.
  assetLedgerCode      String             @map("asset_ledger_code") @db.VarChar(30)
  accumDepLedgerCode   String             @map("accum_dep_ledger_code") @db.VarChar(30)
  depExpenseLedgerCode String             @map("dep_expense_ledger_code") @db.VarChar(30)
  isActive             Boolean            @default(true) @map("is_active")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  assets  FixedAsset[]
  company Company      @relation("CompanyAssetClass", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("asset_classes")
}

/// One asset on the register (P1-18).
model FixedAsset {
  id                      String             @id @default(uuid()) @db.Uuid
  companyId               String             @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  code                    String             @db.VarChar(30)
  name                    String             @db.VarChar(160)
  classId                 String             @map("class_id") @db.Uuid
  businessPlaceId         BigInt?            @map("business_place_id")
  /// When it was bought, and when it was put to use — depreciation runs from the second.
  acquiredOn              DateTime           @map("acquired_on") @db.Date
  capitalisedOn           DateTime           @map("capitalised_on") @db.Date
  /// Everything it cost to bring into use: price, freight, installation, non-creditable tax.
  cost                    Decimal            @default(0) @db.Decimal(14, 2)
  /// Derived from the class at capitalisation and then fixed, because the class may be edited.
  residualValue           Decimal            @default(0) @map("residual_value") @db.Decimal(14, 2)
  method                  DepreciationMethod @default(SLM)
  usefulLifeMonths        Int                @map("useful_life_months")
  /// Depreciation charged to date under the Companies Act. The income-tax side is a block, not
  /// an asset, so there is deliberately no per-asset tax figure here.
  accumulatedDepreciation Decimal            @default(0) @map("accumulated_depreciation") @db.Decimal(14, 2)
  quantity                Decimal            @default(1) @db.Decimal(12, 3)
  serialNo                String?            @map("serial_no") @db.VarChar(80)
  location                String?            @db.VarChar(120)
  status                  AssetStatus        @default(ACTIVE)
  /// Where it was capitalised from, when it came off a bill rather than being typed.
  sourceDocType           String?            @map("source_doc_type") @db.VarChar(20)
  sourceDocId             String?            @map("source_doc_id") @db.VarChar(40)
  /// The specific line on the source document (a GRN line), when capitalisation is line-level.
  sourceLineId            String?            @map("source_line_id") @db.VarChar(40)
  /// True for an asset brought in by the opening-balance import (P2-07) rather than bought after
  /// the books began; its accumulated depreciation is what the import said, not what has been run.
  openingBalance          Boolean            @default(false) @map("opening_balance")
  /// The income-tax written-down value at the moment of an opening-balance import — the pool
  /// figure the block report starts from, since section 32 depreciation is a pool, not per asset.
  openingItWdv            Decimal?           @map("opening_it_wdv") @db.Decimal(14, 2)
  supplierId              Int?               @map("supplier_id")
  disposedOn              DateTime?          @map("disposed_on") @db.Date
  disposalProceeds        Decimal            @default(0) @map("disposal_proceeds") @db.Decimal(14, 2)
  notes                   String?            @db.VarChar(255)
  createdBy               String?            @map("created_by") @db.VarChar(36)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  assetClass    AssetClass          @relation(fields: [classId], references: [id], onDelete: Restrict)
  businessPlace BusinessPlace?      @relation("FixedAssetBusinessPlace", fields: [businessPlaceId], references: [id])
  supplier      Supplier?           @relation(fields: [supplierId], references: [id])
  events        AssetEvent[]
  depreciations AssetDepreciation[]
  company       Company             @relation("CompanyFixedAsset", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, classId])
  @@map("fixed_assets")
}

/// Anything that happened to an asset other than the monthly charge (P1-18).
model AssetEvent {
  id                  String         @id @default(uuid()) @db.Uuid
  companyId           String         @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  assetId             String         @map("asset_id") @db.Uuid
  kind                AssetEventKind
  effectiveOn         DateTime       @map("effective_on") @db.Date
  /// What it changed the cost by, or what the disposal fetched.
  amount              Decimal        @default(0) @db.Decimal(14, 2)
  /// The written-down value at the moment of the event; what a disposal's result is measured from.
  wdvAtEvent          Decimal        @default(0) @map("wdv_at_event") @db.Decimal(14, 2)
  /// Profit (positive) or loss (negative) on a disposal.
  resultAmount        Decimal        @default(0) @map("result_amount") @db.Decimal(14, 2)
  fromBusinessPlaceId BigInt?        @map("from_business_place_id")
  toBusinessPlaceId   BigInt?        @map("to_business_place_id")
  narration           String?        @db.VarChar(255)
  voucherId           Int?           @map("voucher_id")
  createdBy           String?        @map("created_by") @db.VarChar(36)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  asset   FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  company Company    @relation("CompanyAssetEvent", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, assetId])
  @@index([companyId, effectiveOn])
  @@map("asset_events")
}

/// One month's depreciation, prepared and then posted (P1-18).
model DepreciationRun {
  id                String                @id @default(uuid()) @db.Uuid
  companyId         String                @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  /// `2026-08`; a month is run once, which is what stops a double charge.
  periodKey         String                @map("period_key") @db.VarChar(7)
  status            DepreciationRunStatus @default(DRAFT)
  totalAmount       Decimal               @default(0) @map("total_amount") @db.Decimal(14, 2)
  assetCount        Int                   @default(0) @map("asset_count")
  voucherId         Int?                  @map("voucher_id")
  preparedBy        String?               @map("prepared_by") @db.VarChar(36)
  postedBy          String?               @map("posted_by") @db.VarChar(36)
  postedAt          DateTime?             @map("posted_at") @db.Timestamptz(6)
  /// Set when the run is reversed (P2-07): the reversal voucher cancels the original one and
  /// every asset's accumulated depreciation is moved back.
  reversedBy        String?               @map("reversed_by") @db.VarChar(36)
  reversedAt        DateTime?             @map("reversed_at") @db.Timestamptz(6)
  reversalVoucherId Int?                  @map("reversal_voucher_id")
  notes             String?               @db.VarChar(255)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  lines   AssetDepreciation[]
  company Company             @relation("CompanyDepreciationRun", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, periodKey])
  @@index([companyId, status])
  @@map("depreciation_runs")
}

/// What one asset was charged in one month (P1-18).
model AssetDepreciation {
  id         String             @id @default(uuid()) @db.Uuid
  companyId  String             @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  runId      String             @map("run_id") @db.Uuid
  assetId    String             @map("asset_id") @db.Uuid
  periodKey  String             @map("period_key") @db.VarChar(7)
  /// The days the asset was in use in the month; a mid-month purchase is not a full month.
  daysInUse  Int                @default(0) @map("days_in_use")
  openingWdv Decimal            @default(0) @map("opening_wdv") @db.Decimal(14, 2)
  amount     Decimal            @default(0) @db.Decimal(14, 2)
  closingWdv Decimal            @default(0) @map("closing_wdv") @db.Decimal(14, 2)
  method     DepreciationMethod
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  run     DepreciationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  asset   FixedAsset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  company Company         @relation("CompanyAssetDepreciation", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, assetId, periodKey])
  @@index([companyId, periodKey])
  @@map("asset_depreciations")
}

// ── Foreign exchange and imports (P1-17) ──────────────────────────────────────

enum FxRevaluationStatus {
  DRAFT
  POSTED
  REVERSED
}

/// A period-end restatement of open foreign-currency balances (P1-17).
///
/// An unrealised difference is an opinion about a rate, not a transaction, so the run posts on
/// the last day of the period and reverses on the first day of the next one. Left standing, it
/// would be counted twice the month the balance is actually settled.
model FxRevaluation {
  id                String              @id @default(uuid()) @db.Uuid
  companyId         String              @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  /// `2026-08`; a period is revalued once.
  periodKey         String              @map("period_key") @db.VarChar(7)
  asOn              DateTime            @map("as_on") @db.Date
  status            FxRevaluationStatus @default(DRAFT)
  /// Net gain (positive) or loss (negative) across every open balance.
  netAmount         Decimal             @default(0) @map("net_amount") @db.Decimal(14, 2)
  lines             Json
  voucherId         Int?                @map("voucher_id")
  reversalVoucherId Int?                @map("reversal_voucher_id")
  preparedBy        String?             @map("prepared_by") @db.VarChar(36)
  postedBy          String?             @map("posted_by") @db.VarChar(36)
  postedAt          DateTime?           @map("posted_at") @db.Timestamptz(6)
  notes             String?             @db.VarChar(255)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyFxRevaluation", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, periodKey])
  @@index([companyId, status])
  @@map("fx_revaluations")
}

/// A bill of entry: what customs charged to let the goods in (P1-17).
///
/// The split matters more than the total. IGST under section 3(7) is creditable and must not
/// reach the cost of the goods; basic customs duty and the surcharge are not creditable and
/// must. Putting the whole bill into stock overstates it by the IGST and loses the credit.
model BillOfEntry {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  beNumber               String   @map("be_number") @db.VarChar(20)
  beDate                 DateTime @map("be_date") @db.Date
  portCode               String?  @map("port_code") @db.VarChar(10)
  /// The purchase this clears, when it came in through one.
  grnInvoiceId           String?  @map("grn_invoice_id") @db.Uuid
  supplierId             Int?     @map("supplier_id")
  currencyCode           String   @default("USD") @map("currency_code") @db.VarChar(3)
  /// The rate customs used, which is notified fortnightly and is NOT the day's market rate.
  exchangeRate           Decimal  @default(1) @map("exchange_rate") @db.Decimal(14, 6)
  /// The invoice value in foreign currency, and the assessable value customs worked out in INR.
  foreignValue           Decimal  @default(0) @map("foreign_value") @db.Decimal(14, 2)
  assessableValue        Decimal  @default(0) @map("assessable_value") @db.Decimal(14, 2)
  basicDuty              Decimal  @default(0) @map("basic_duty") @db.Decimal(14, 2)
  socialWelfareSurcharge Decimal  @default(0) @map("social_welfare_surcharge") @db.Decimal(14, 2)
  /// Creditable: it goes to the input-credit ledger, never into the cost of the goods.
  igst                   Decimal  @default(0) @db.Decimal(14, 2)
  cess                   Decimal  @default(0) @db.Decimal(14, 2)
  /// Freight, insurance, clearing and handling — all part of what the stock cost.
  otherCharges           Decimal  @default(0) @map("other_charges") @db.Decimal(14, 2)
  /// Assessable value plus everything that is not creditable.
  landedCost             Decimal  @default(0) @map("landed_cost") @db.Decimal(14, 2)
  voucherId              Int?     @map("voucher_id")
  notes                  String?  @db.VarChar(255)
  createdBy              String?  @map("created_by") @db.VarChar(36)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier Supplier? @relation(fields: [supplierId], references: [id])
  company  Company   @relation("CompanyBillOfEntry", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, beNumber, beDate])
  @@index([companyId, beDate])
  @@map("bills_of_entry")
}

// ── Valuation, costing, cost centres and budgets (P1-19) ──────────────────────

enum StockMoveKind {
  OPENING
  RECEIPT
  ISSUE
  PRODUCTION_IN
  SCRAP
  ADJUSTMENT
  RETURN_IN
  RETURN_OUT
}

/// One movement in the weighted-average valuation ledger (P1-19).
///
/// Kept as a ledger rather than a single running number on the item because the average is the
/// number everyone argues about at a year end, and a balance you cannot explain is a balance you
/// cannot defend. Each row carries the balance and the average *after* it, so any month's closing
/// stock can be read straight off the last row before the cut-off.
model StockValuationEntry {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  /// RAW_MATERIAL or PRODUCT; the two live in different tables but value the same way.
  itemType        String        @map("item_type") @db.VarChar(16)
  itemId          String        @map("item_id") @db.VarChar(40)
  storeId         String?       @map("store_id") @db.VarChar(20)
  movedOn         DateTime      @map("moved_on") @db.Date
  kind            StockMoveKind
  quantity        Decimal       @default(0) @db.Decimal(14, 3)
  /// What this movement came in at. An issue is valued at the running average instead.
  rate            Decimal       @default(0) @db.Decimal(14, 4)
  value           Decimal       @default(0) @db.Decimal(14, 2)
  balanceQuantity Decimal       @default(0) @map("balance_quantity") @db.Decimal(14, 3)
  balanceValue    Decimal       @default(0) @map("balance_value") @db.Decimal(14, 2)
  avgRate         Decimal       @default(0) @map("avg_rate") @db.Decimal(14, 4)
  /// True when the movement took the balance below zero — the average stops meaning anything and
  /// somebody has to go and look.
  wentNegative    Boolean       @default(false) @map("went_negative")
  refDocType      String?       @map("ref_doc_type") @db.VarChar(30)
  refDocId        String?       @map("ref_doc_id") @db.VarChar(40)
  narration       String?       @db.VarChar(255)
  /// Set on a reversal row: the entry it undoes. Never set on the row being reversed — a
  /// cancellation adds a new row, it never edits or deletes the original (P2-04).
  reversedEntryId String?       @map("reversed_entry_id") @db.Uuid
  createdBy       String?       @map("created_by") @db.VarChar(36)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation("CompanyStockValuationEntry", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, itemType, itemId, storeId, movedOn])
  @@index([companyId, movedOn])
  @@map("stock_valuation_entries")
}

enum CostCentreKind {
  PRODUCTION
  SERVICE
  ADMIN
  SALES
}

/// Where a cost belongs (P1-19).
model CostCentre {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  code      String         @db.VarChar(20)
  name      String         @db.VarChar(120)
  kind      CostCentreKind @default(PRODUCTION)
  parentId  String?        @map("parent_id") @db.Uuid
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   CostCentre?   @relation("CostCentreTree", fields: [parentId], references: [id])
  children CostCentre[]  @relation("CostCentreTree")
  items    JournalItem[]
  budgets  Budget[]
  company  Company       @relation("CompanyCostCentre", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@index([companyId, parentId])
  @@map("cost_centres")
}

/// A budget line (P1-19).
///
/// The scope key exists because Postgres does not treat two NULLs as equal, so a unique index
/// over nullable period and cost-centre columns would let the same budget be entered twice.
model Budget {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  fyCode       String   @map("fy_code") @db.VarChar(10)
  /// `2026-08` for a month, or null for the whole year.
  periodKey    String?  @map("period_key") @db.VarChar(7)
  ledgerId     Int      @map("ledger_id")
  costCentreId String?  @map("cost_centre_id") @db.Uuid
  amount       Decimal  @default(0) @db.Decimal(14, 2)
  /// `fy|period|ledger|costCentre`, with the nulls spelled out.
  scopeKey     String   @map("scope_key") @db.VarChar(120)
  notes        String?  @db.VarChar(255)
  createdBy    String?  @map("created_by") @db.VarChar(36)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ledger     AccountLedger @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  costCentre CostCentre?   @relation(fields: [costCentreId], references: [id])
  company    Company       @relation("CompanyBudget", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, scopeKey])
  @@index([companyId, fyCode])
  @@map("budgets")
}

/// What a product cost in a period (P1-19).
model ProductCostSheet {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  productId        BigInt   @map("product_id")
  periodKey        String   @map("period_key") @db.VarChar(7)
  quantityProduced Decimal  @default(0) @map("quantity_produced") @db.Decimal(14, 3)
  materialCost     Decimal  @default(0) @map("material_cost") @db.Decimal(14, 2)
  labourCost       Decimal  @default(0) @map("labour_cost") @db.Decimal(14, 2)
  overheadCost     Decimal  @default(0) @map("overhead_cost") @db.Decimal(14, 2)
  /// What the scrap that came out was worth; it comes off the cost of the good output.
  scrapCredit      Decimal  @default(0) @map("scrap_credit") @db.Decimal(14, 2)
  totalCost        Decimal  @default(0) @map("total_cost") @db.Decimal(14, 2)
  perUnitCost      Decimal  @default(0) @map("per_unit_cost") @db.Decimal(14, 4)
  /// How the overhead was spread: the rule, so the number can be argued with.
  overheadBasis    String?  @map("overhead_basis") @db.VarChar(40)
  lines            Json
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  company Company @relation("CompanyProductCostSheet", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, productId, periodKey])
  @@index([companyId, periodKey])
  @@map("product_cost_sheets")
}

/// Which ledger work-in-progress posts to (P2-14). One row per tenant, created on first write;
/// a tenant that never visits the setting reads the "WIP" default without one.
model CostingSetting {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @unique @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  wipLedgerCode String   @default("WIP") @map("wip_ledger_code") @db.VarChar(20)
  updatedBy     String?  @map("updated_by") @db.VarChar(36)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyCostingSetting", fields: [companyId], references: [id], onDelete: Restrict)

  @@map("costing_settings")
}

// ── Bank reconciliation and cheques (P1-20) ───────────────────────────────────

enum StatementLineStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

enum ChequeKind {
  RECEIVED
  ISSUED
}

enum ChequeStatus {
  IN_HAND
  DEPOSITED
  CLEARED
  BOUNCED
  CANCELLED
}

/// One imported bank statement (P1-20).
model BankStatement {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  bankAccountId  String   @map("bank_account_id") @db.Uuid
  /// The bank whose layout the file was read as; "GENERIC" when a mapping was supplied.
  format         String   @db.VarChar(20)
  fileName       String?  @map("file_name") @db.VarChar(160)
  fromDate       DateTime @map("from_date") @db.Date
  toDate         DateTime @map("to_date") @db.Date
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(14, 2)
  closingBalance Decimal  @default(0) @map("closing_balance") @db.Decimal(14, 2)
  rowCount       Int      @default(0) @map("row_count")
  /// Rows the file had that were already on file from an earlier import.
  duplicateCount Int      @default(0) @map("duplicate_count")
  importedBy     String?  @map("imported_by") @db.VarChar(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bankAccount BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  lines       BankStatementLine[]
  company     Company             @relation("CompanyBankStatement", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, bankAccountId, fromDate])
  @@map("bank_statements")
}

/// One line of a statement, and what it was matched to (P1-20).
model BankStatementLine {
  id               String              @id @default(uuid()) @db.Uuid
  companyId        String              @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  statementId      String              @map("statement_id") @db.Uuid
  bankAccountId    String              @map("bank_account_id") @db.Uuid
  txnDate          DateTime            @map("txn_date") @db.Date
  valueDate        DateTime?           @map("value_date") @db.Date
  description      String              @db.VarChar(400)
  refNo            String?             @map("ref_no") @db.VarChar(60)
  /// Money out of the account and money in; a bank gives one or the other, never both.
  debit            Decimal             @default(0) @db.Decimal(14, 2)
  credit           Decimal             @default(0) @db.Decimal(14, 2)
  runningBalance   Decimal?            @map("running_balance") @db.Decimal(14, 2)
  /// The reference with the noise taken out, which is what matching compares.
  normalisedRef    String?             @map("normalised_ref") @db.VarChar(60)
  /// Date, amount and reference hashed: re-importing an overlapping statement finds this and
  /// skips the row rather than doubling the bank.
  dedupeHash       String              @map("dedupe_hash") @db.VarChar(64)
  status           StatementLineStatus @default(UNMATCHED)
  matchedVoucherId Int?                @map("matched_voucher_id")
  /// How sure the automatic match was, 0 to 100; a person's match is always 100.
  matchConfidence  Int?                @map("match_confidence")
  matchedBy        String?             @map("matched_by") @db.VarChar(36)
  matchedAt        DateTime?           @map("matched_at") @db.Timestamptz(6)
  notes            String?             @db.VarChar(255)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  company   Company       @relation("CompanyBankStatementLine", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, bankAccountId, dedupeHash])
  @@index([companyId, bankAccountId, txnDate])
  @@index([companyId, status])
  @@map("bank_statement_lines")
}

/// A cheque received or issued, post-dated or not (P1-20).
///
/// In Indian trade a post-dated cheque is the normal instrument: a receivable that becomes money
/// on a date. It is not cash until it clears, which is why it has a status rather than a flag.
model Cheque {
  id                String       @id @default(uuid()) @db.Uuid
  companyId         String       @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  kind              ChequeKind
  chequeNo          String       @map("cheque_no") @db.VarChar(20)
  /// The date written on it; a later one is what makes it post-dated.
  chequeDate        DateTime     @map("cheque_date") @db.Date
  bankName          String?      @map("bank_name") @db.VarChar(120)
  partyName         String?      @map("party_name") @db.VarChar(160)
  customerId        String?      @map("customer_id") @db.Uuid
  supplierId        Int?         @map("supplier_id")
  amount            Decimal      @default(0) @db.Decimal(14, 2)
  status            ChequeStatus @default(IN_HAND)
  /// The account it went into or is drawn on.
  bankAccountId     String?      @map("bank_account_id") @db.Uuid
  depositedOn       DateTime?    @map("deposited_on") @db.Date
  clearedOn         DateTime?    @map("cleared_on") @db.Date
  bouncedOn         DateTime?    @map("bounced_on") @db.Date
  bounceCharges     Decimal      @default(0) @map("bounce_charges") @db.Decimal(14, 2)
  bounceReason      String?      @map("bounce_reason") @db.VarChar(160)
  refDocType        String?      @map("ref_doc_type") @db.VarChar(30)
  refDocId          String?      @map("ref_doc_id") @db.VarChar(40)
  /// The sales invoice or GRN invoice this cheque's payment belongs to (P2-06); `refDocId` names
  /// the payment line, this names the document, so a PDC that clears can re-run its posting.
  sourceDocId       String?      @map("source_doc_id") @db.VarChar(36)
  voucherId         Int?         @map("voucher_id")
  reversalVoucherId Int?         @map("reversal_voucher_id")
  /// How many times this cheque has been presented (P2-06); each re-presentation after a bounce
  /// needs its own voucher reference so a repeat clear can never post the receipt twice.
  presentedCount    Int          @default(0) @map("presented_count")
  notes             String?      @db.VarChar(255)
  createdBy         String?      @map("created_by") @db.VarChar(36)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  supplier    Supplier?    @relation(fields: [supplierId], references: [id])
  company     Company      @relation("CompanyCheque", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, kind, chequeNo, chequeDate])
  @@index([companyId, status, chequeDate])
  @@map("cheques")
}

// ── Statutory payroll (P1-16) ─────────────────────────────────────────────────

enum TaxRegime {
  OLD
  NEW
}

/// Professional tax and labour welfare fund, which are state taxes (P1-16).
///
/// Neither is a national rate. Professional tax has its own slabs in each state that levies it,
/// several states charge a different amount in one month of the year, and the labour welfare fund
/// is a fixed amount at a frequency the state decides. A flat number is wrong everywhere.
model StatutoryRule {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  stateCode    String   @map("state_code") @db.VarChar(2)
  stateName    String   @map("state_name") @db.VarChar(80)
  /// `[{ upTo, amount, month? }]`, ordered; `month` (1-12) charges that amount in that month only.
  ptSlabs      Json     @map("pt_slabs")
  ptEnabled    Boolean  @default(true) @map("pt_enabled")
  lwfEmployee  Decimal  @default(0) @map("lwf_employee") @db.Decimal(10, 2)
  lwfEmployer  Decimal  @default(0) @map("lwf_employer") @db.Decimal(10, 2)
  /// MONTHLY, HALF_YEARLY or ANNUAL, with the months it is actually collected in.
  lwfFrequency String   @default("ANNUAL") @map("lwf_frequency") @db.VarChar(16)
  lwfMonths    Json     @default("[12]") @map("lwf_months")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyStatutoryRule", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, stateCode])
  @@map("statutory_rules")
}

/// The statutory split for one employee in one payroll run (P1-16).
///
/// It is a table of its own rather than columns on `PayrollResult` because the three wages are
/// different wages — PF is on basic plus dearness allowance, ESI on gross, professional tax on
/// gross as the state defines it — and flattening them into one row is how a contribution ends up
/// worked out on the wrong base.
model PayrollStatutory {
  id           String  @id @default(uuid()) @db.Uuid
  companyId    String  @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  payrollRunId Int     @map("payroll_run_id")
  employeeId   BigInt  @map("employee_id")
  employeeCode String  @map("employee_code") @db.VarChar(40)
  periodKey    String  @map("period_key") @db.VarChar(7)
  stateCode    String? @map("state_code") @db.VarChar(2)
  uan          String? @db.VarChar(12)
  esicNumber   String? @map("esic_number") @db.VarChar(17)

  pfWage  Decimal @default(0) @map("pf_wage") @db.Decimal(14, 2)
  esiWage Decimal @default(0) @map("esi_wage") @db.Decimal(14, 2)
  ptWage  Decimal @default(0) @map("pt_wage") @db.Decimal(14, 2)

  /// The employee's 12%.
  epfEmployee    Decimal @default(0) @map("epf_employee") @db.Decimal(14, 2)
  /// The employer's 12%, split the way the EPFO takes it: 8.33% to pension, the rest to PF.
  epsEmployer    Decimal @default(0) @map("eps_employer") @db.Decimal(14, 2)
  epfEmployer    Decimal @default(0) @map("epf_employer") @db.Decimal(14, 2)
  /// 0.50% each, paid by the employer on top of the 12%.
  edliCharges    Decimal @default(0) @map("edli_charges") @db.Decimal(14, 2)
  pfAdminCharges Decimal @default(0) @map("pf_admin_charges") @db.Decimal(14, 2)
  /// Voluntary provident fund: the employee's own extra, which the employer does not match.
  vpf            Decimal @default(0) @db.Decimal(14, 2)

  esiEmployee Decimal @default(0) @map("esi_employee") @db.Decimal(14, 2)
  esiEmployer Decimal @default(0) @map("esi_employer") @db.Decimal(14, 2)

  professionalTax Decimal @default(0) @map("professional_tax") @db.Decimal(14, 2)
  lwfEmployee     Decimal @default(0) @map("lwf_employee") @db.Decimal(14, 2)
  lwfEmployer     Decimal @default(0) @map("lwf_employer") @db.Decimal(14, 2)
  incomeTax       Decimal @default(0) @map("income_tax") @db.Decimal(14, 2)

  /// Basic and dearness allowance as a share of gross; under half fails the Labour Code check.
  wageSharePercent Decimal @default(0) @map("wage_share_percent") @db.Decimal(5, 2)
  wageCheckPassed  Boolean @default(true) @map("wage_check_passed")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyPayrollStatutory", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, payrollRunId, employeeId])
  @@index([companyId, periodKey])
  @@map("payroll_statutory")
}

/// What an employee said about their tax for the year (P1-16).
model EmployeeTaxDeclaration {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  employeeId        BigInt    @map("employee_id")
  fyCode            String    @map("fy_code") @db.VarChar(10)
  regime            TaxRegime @default(NEW)
  /// 80C, 80D, house rent, interest on a housing loan — whatever the old regime allows.
  declarations      Json      @default("{}")
  /// What the year is expected to come to, and what has already been taken off.
  projectedIncome   Decimal   @default(0) @map("projected_income") @db.Decimal(14, 2)
  projectedTax      Decimal   @default(0) @map("projected_tax") @db.Decimal(14, 2)
  taxDeductedToDate Decimal   @default(0) @map("tax_deducted_to_date") @db.Decimal(14, 2)
  /// Proof was seen; until then the declaration is a claim and the old regime may be refused.
  proofsVerified    Boolean   @default(false) @map("proofs_verified")
  notes             String?   @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyEmployeeTaxDeclaration", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, employeeId, fyCode])
  @@map("employee_tax_declarations")
}

/// ESI eligibility fixed for a contribution half-year (P2-02): Apr-Sep or Oct-Mar. The scheme
/// decides eligibility once, at the start of the period, from the wage that month — an employee
/// who crosses the wage limit later keeps contributing until the period ends. Written once per
/// employee per period and then left alone, the same reason the leave register is a table and not
/// a recomputation.
model EsiContributionPeriod {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  employeeId  BigInt   @map("employee_id")
  /// e.g. "2026-H1" (April-September 2026) or "2026-H2" (October 2026-March 2027).
  periodKey   String   @map("period_key") @db.VarChar(9)
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  eligible    Boolean  @default(false)
  wageAtStart Decimal  @default(0) @map("wage_at_start") @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyEsiContributionPeriod", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, employeeId, periodKey])
  @@map("esi_contribution_periods")
}

/// Overtime worked, running per employee per calendar quarter (P2-16): the OSH Code's 125-hour
/// cap (`QUARTERLY_OVERTIME_CAP` in `labour.calc.ts`) is a quarter-to-date figure, not a
/// per-run one, so each payroll run adds its own overtime hours onto the total already banked
/// for the quarter instead of computing the cap against a blank slate. `breached` is sticky
/// within the quarter once any run has pushed the total past the cap, even if a later run's own
/// hours are zero.
model OvertimeQuarterPeriod {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  employeeId   BigInt   @map("employee_id")
  /// e.g. "2026-Q3" (July-September 2026), a calendar quarter.
  quarterKey   String   @map("quarter_key") @db.VarChar(7)
  quarterStart DateTime @map("quarter_start") @db.Date
  quarterEnd   DateTime @map("quarter_end") @db.Date
  hoursAccrued Decimal  @default(0) @map("hours_accrued") @db.Decimal(10, 2)
  breached     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyOvertimeQuarterPeriod", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, employeeId, quarterKey])
  @@map("overtime_quarter_periods")
}

// ── Labour Code entitlements (P1-17b) ─────────────────────────────────────────

enum LeaveAccrualBasis {
  ANNUAL
  MONTHLY
  DAYS_WORKED
}

enum SettlementStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

/// A day the factory does not work (P1-17b). National holidays are statutory; the rest are the
/// company's, and the list is per state because a festival is not a holiday everywhere.
model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  holidayOn DateTime @map("holiday_on") @db.Date
  name      String   @db.VarChar(120)
  /// NATIONAL, FESTIVAL or COMPANY. A national holiday cannot be worked without double wages.
  kind      String   @default("FESTIVAL") @db.VarChar(16)
  stateCode String?  @map("state_code") @db.VarChar(2)
  isPaid    Boolean  @default(true) @map("is_paid")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation("CompanyHoliday", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, holidayOn, name])
  @@index([companyId, holidayOn])
  @@map("holidays")
}

/// A kind of leave and the policy attached to it (P1-17b).
model LeaveType {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  code             String            @db.VarChar(20)
  name             String            @db.VarChar(80)
  /// Days a year, or the divisor when the basis is days worked (one day per twenty, say).
  daysPerYear      Decimal           @default(0) @map("days_per_year") @db.Decimal(6, 2)
  basis            LeaveAccrualBasis @default(ANNUAL)
  /// One earned day for every this many days actually worked, when the basis says so.
  daysWorkedPerDay Int               @default(20) @map("days_worked_per_day")
  isPaid           Boolean           @default(true) @map("is_paid")
  /// How much may be carried into the next year; the rest lapses.
  carryForwardMax  Decimal           @default(0) @map("carry_forward_max") @db.Decimal(6, 2)
  encashable       Boolean           @default(false)
  /// Leave without pay: a request against this type may be approved even when it takes the
  /// balance negative (P2-09), instead of being refused for insufficient balance.
  allowNegative    Boolean           @default(false) @map("allow_negative")
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  balances LeaveBalance[]
  requests LeaveRequest[]
  company  Company        @relation("CompanyLeaveType", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("leave_types")
}

/// What an employee has of a leave type in a year (P1-17b).
///
/// A running balance rather than a derived figure, because leave is argued about and the argument
/// is always "what did I have at the start of the year" — which a recomputation cannot answer
/// once the policy has changed.
model LeaveBalance {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  employeeId  BigInt   @map("employee_id")
  leaveTypeId String   @map("leave_type_id") @db.Uuid
  fyCode      String   @map("fy_code") @db.VarChar(10)
  opening     Decimal  @default(0) @db.Decimal(6, 2)
  accrued     Decimal  @default(0) @db.Decimal(6, 2)
  taken       Decimal  @default(0) @db.Decimal(6, 2)
  encashed    Decimal  @default(0) @db.Decimal(6, 2)
  /// What went past the carry-forward cap at the year end and was lost.
  lapsed      Decimal  @default(0) @db.Decimal(6, 2)
  closing     Decimal  @default(0) @db.Decimal(6, 2)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  company   Company   @relation("CompanyLeaveBalance", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, employeeId, leaveTypeId, fyCode])
  @@index([companyId, fyCode])
  @@map("leave_balances")
}

/// Full and final settlement (P1-17b).
model FinalSettlement {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  employeeId         BigInt   @map("employee_id")
  employeeCode       String   @map("employee_code") @db.VarChar(40)
  separationOn       DateTime @map("separation_on") @db.Date
  lastWorkingDay     DateTime @map("last_working_day") @db.Date
  reason             String?  @db.VarChar(160)
  /// Whether the employee served their notice; what they did not serve is recovered.
  noticeDaysRequired Int      @default(0) @map("notice_days_required")
  noticeDaysServed   Int      @default(0) @map("notice_days_served")

  /// What is owed.
  salaryDue       Decimal @default(0) @map("salary_due") @db.Decimal(14, 2)
  leaveEncashment Decimal @default(0) @map("leave_encashment") @db.Decimal(14, 2)
  gratuity        Decimal @default(0) @db.Decimal(14, 2)
  bonus           Decimal @default(0) @db.Decimal(14, 2)
  otherDues       Decimal @default(0) @map("other_dues") @db.Decimal(14, 2)
  /// What comes off.
  noticeRecovery  Decimal @default(0) @map("notice_recovery") @db.Decimal(14, 2)
  advanceRecovery Decimal @default(0) @map("advance_recovery") @db.Decimal(14, 2)
  otherRecovery   Decimal @default(0) @map("other_recovery") @db.Decimal(14, 2)
  netPayable      Decimal @default(0) @map("net_payable") @db.Decimal(14, 2)

  /// The service and wage the gratuity was worked out on, kept so the figure can be defended.
  yearsOfService   Decimal @default(0) @map("years_of_service") @db.Decimal(6, 2)
  lastDrawnWage    Decimal @default(0) @map("last_drawn_wage") @db.Decimal(14, 2)
  gratuityEligible Boolean @default(false) @map("gratuity_eligible")

  status     SettlementStatus @default(DRAFT)
  voucherId  Int?             @map("voucher_id")
  notes      String?          @db.VarChar(255)
  preparedBy String?          @map("prepared_by") @db.VarChar(36)
  approvedBy String?          @map("approved_by") @db.VarChar(36)
  approvedAt DateTime?        @map("approved_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyFinalSettlement", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, employeeId, separationOn])
  @@index([companyId, status])
  @@map("final_settlements")
}

// ─── Payments (P1-21) ────────────────────────────────────────────────────────

enum PaymentGatewayProvider {
  FIXTURE
  RAZORPAY
}

enum PaymentLinkStatus {
  CREATED
  PARTIALLY_PAID
  PAID
  EXPIRED
  CANCELLED
}

enum PaymentCaptureStatus {
  CAPTURED
  FAILED
  REFUNDED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// One gateway per tenant. Secrets are encrypted at rest and never returned; `webhookToken` is
/// the opaque segment of the callback URL, so the URL a tenant hands the gateway carries no
/// company id.
model PaymentGatewayConfig {
  id             String                 @id @default(uuid()) @db.Uuid
  companyId      String                 @unique @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  provider       PaymentGatewayProvider @default(FIXTURE)
  enabled        Boolean                @default(false)
  keyId          String?                @map("key_id") @db.VarChar(120)
  keySecret      String?                @map("key_secret") @db.VarChar(400)
  webhookSecret  String?                @map("webhook_secret") @db.VarChar(400)
  webhookToken   String                 @unique @map("webhook_token") @db.VarChar(64)
  /// Where the money lands and what the gateway keeps for itself.
  bankLedgerCode String                 @default("BANK-001") @map("bank_ledger_code") @db.VarChar(20)
  feeLedgerCode  String                 @default("PG-FEE-001") @map("fee_ledger_code") @db.VarChar(20)
  expiryHours    Int                    @default(72) @map("expiry_hours")
  lastVerifiedAt DateTime?              @map("last_verified_at") @db.Timestamptz(6)
  createdBy      String?                @map("created_by") @db.VarChar(36)
  updatedBy      String?                @map("updated_by") @db.VarChar(36)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyPaymentGatewayConfig", fields: [companyId], references: [id], onDelete: Restrict)

  @@map("payment_gateway_configs")
}

/// A link a customer can pay. `amountPaid` is the sum of its captures, kept on the row so the
/// list does not have to add them up.
model PaymentLink {
  id             String                 @id @default(uuid()) @db.Uuid
  companyId      String                 @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  linkNo         String                 @map("link_no") @db.VarChar(30)
  provider       PaymentGatewayProvider @default(FIXTURE)
  providerLinkId String?                @map("provider_link_id") @db.VarChar(120)
  shortUrl       String?                @map("short_url") @db.VarChar(400)
  salesInvoiceId String?                @map("sales_invoice_id") @db.Uuid
  customerId     String?                @map("customer_id") @db.Uuid
  amount         Decimal                @db.Decimal(14, 2)
  amountPaid     Decimal                @default(0) @map("amount_paid") @db.Decimal(14, 2)
  currencyCode   String                 @default("INR") @map("currency_code") @db.VarChar(3)
  status         PaymentLinkStatus      @default(CREATED)
  description    String?                @db.VarChar(255)
  notifyEmail    String?                @map("notify_email") @db.VarChar(120)
  notifyPhone    String?                @map("notify_phone") @db.VarChar(20)
  expiresAt      DateTime?              @map("expires_at") @db.Timestamptz(6)
  cancelledAt    DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  cancelReason   String?                @map("cancel_reason") @db.VarChar(255)
  createdBy      String?                @map("created_by") @db.VarChar(36)
  updatedBy      String?                @map("updated_by") @db.VarChar(36)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company          @relation("CompanyPaymentLink", fields: [companyId], references: [id], onDelete: Restrict)
  salesInvoice SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  captures     PaymentCapture[]

  @@unique([companyId, linkNo])
  @@unique([companyId, providerLinkId])
  @@index([companyId, status])
  @@index([companyId, salesInvoiceId])
  @@map("payment_links")
}

/// One payment the gateway reports against a link. The provider's payment id is the idempotency
/// key: the same capture cannot post twice however many times the webhook is delivered.
model PaymentCapture {
  id                    String               @id @default(uuid()) @db.Uuid
  companyId             String               @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  paymentLinkId         String               @map("payment_link_id") @db.Uuid
  providerPaymentId     String               @map("provider_payment_id") @db.VarChar(120)
  status                PaymentCaptureStatus @default(CAPTURED)
  amount                Decimal              @db.Decimal(14, 2)
  /// What the gateway kept, and the GST on it. Both are the gateway's numbers, in paise-exact
  /// rupees; the books never guess them.
  fee                   Decimal              @default(0) @db.Decimal(14, 2)
  feeTax                Decimal              @default(0) @map("fee_tax") @db.Decimal(14, 2)
  method                String?              @db.VarChar(30)
  capturedAt            DateTime             @map("captured_at") @db.Timestamptz(6)
  salesInvoicePaymentId String?              @map("sales_invoice_payment_id") @db.Uuid
  voucherId             String?              @map("voucher_id") @db.VarChar(36)
  feeVoucherId          String?              @map("fee_voucher_id") @db.VarChar(36)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company     @relation("CompanyPaymentCapture", fields: [companyId], references: [id], onDelete: Restrict)
  paymentLink PaymentLink @relation(fields: [paymentLinkId], references: [id], onDelete: Restrict)

  @@unique([companyId, providerPaymentId])
  @@index([companyId, paymentLinkId])
  @@map("payment_captures")
}

/// Every callback, stored before it is acted on: what arrived, whether it was signed correctly,
/// and what became of it. A gateway that redelivers an event finds it here and does nothing.
model PaymentWebhookEvent {
  id              String             @id @default(uuid()) @db.Uuid
  companyId       String             @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  providerEventId String             @map("provider_event_id") @db.VarChar(160)
  eventType       String             @map("event_type") @db.VarChar(60)
  signatureValid  Boolean            @default(false) @map("signature_valid")
  status          WebhookEventStatus @default(RECEIVED)
  payload         Json
  error           String?            @db.VarChar(500)
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz(6)

  company Company @relation("CompanyPaymentWebhookEvent", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, providerEventId])
  @@index([companyId, status])
  @@map("payment_webhook_events")
}

enum SubscriptionInvoiceStatus {
  DUE
  PAID
  FAILED
  VOID
}

/// What a tenant owes the platform for one period. Raised by the platform, moved to paid by the
/// gateway's webhook, and the subscription's status follows it.
model SubscriptionInvoice {
  id                String                    @id @default(uuid()) @db.Uuid
  companyId         String                    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  planCode          String                    @map("plan_code") @db.VarChar(30)
  periodStart       DateTime                  @map("period_start") @db.Timestamptz(6)
  periodEnd         DateTime                  @map("period_end") @db.Timestamptz(6)
  amount            Decimal                   @db.Decimal(12, 2)
  status            SubscriptionInvoiceStatus @default(DUE)
  dueAt             DateTime                  @map("due_at") @db.Timestamptz(6)
  paidAt            DateTime?                 @map("paid_at") @db.Timestamptz(6)
  providerInvoiceId String?                   @map("provider_invoice_id") @db.VarChar(120)
  providerPaymentId String?                   @map("provider_payment_id") @db.VarChar(120)
  failureReason     String?                   @map("failure_reason") @db.VarChar(255)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanySubscriptionInvoice", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, periodStart])
  @@index([companyId, status])
  @@map("subscription_invoices")
}

// ─── SMS and one-time passwords (P1-22) ──────────────────────────────────────

enum SmsProviderName {
  FIXTURE
  MSG91
}

/// TRAI's categories. Transactional and service messages need a DLT-registered template;
/// promotional messages are blocked for numbers on the DND registry.
enum SmsCategory {
  TRANSACTIONAL
  SERVICE_IMPLICIT
  SERVICE_EXPLICIT
  PROMOTIONAL
}

enum SmsMessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum OtpPurpose {
  MOBILE_VERIFY
  FIELD_LOGIN
  PAYMENT_CONFIRM
}

/// One SMS account per tenant. The auth key is encrypted at rest and never returned; the DLT ids
/// are not secret but without them every transactional message is dropped by the operator.
model SmsConfig {
  id                String          @id @default(uuid()) @db.Uuid
  companyId         String          @unique @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  provider          SmsProviderName @default(FIXTURE)
  enabled           Boolean         @default(false)
  /// The sender id registered on DLT: six letters, e.g. SHFTLN.
  senderId          String?         @map("sender_id") @db.VarChar(6)
  /// The principal entity id the tenant registered with on the DLT platform.
  principalEntityId String?         @map("principal_entity_id") @db.VarChar(30)
  authKey           String?         @map("auth_key") @db.VarChar(400)
  /// A cap the tenant sets on itself, so a loop cannot spend a month's credit in an hour.
  dailyCap          Int             @default(2000) @map("daily_cap")
  lastVerifiedAt    DateTime?       @map("last_verified_at") @db.Timestamptz(6)
  createdBy         String?         @map("created_by") @db.VarChar(36)
  updatedBy         String?         @map("updated_by") @db.VarChar(36)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanySmsConfig", fields: [companyId], references: [id], onDelete: Restrict)

  @@map("sms_configs")
}

/// A message the operator will actually deliver: the body must match the DLT registration
/// character for character apart from the variables.
model SmsTemplate {
  id            String      @id @default(uuid()) @db.Uuid
  companyId     String      @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  code          String      @db.VarChar(40)
  name          String      @db.VarChar(80)
  category      SmsCategory @default(TRANSACTIONAL)
  dltTemplateId String?     @map("dlt_template_id") @db.VarChar(30)
  body          String      @db.VarChar(1000)
  /// The placeholder names in the order the body uses them.
  variables     String[]
  isActive      Boolean     @default(true) @map("is_active")
  createdBy     String?     @map("created_by") @db.VarChar(36)
  updatedBy     String?     @map("updated_by") @db.VarChar(36)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanySmsTemplate", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("sms_templates")
}

/// Every send, whatever became of it. An OTP's message body is stored with the code masked.
model SmsMessage {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  toMobile          String           @map("to_mobile") @db.VarChar(15)
  templateCode      String?          @map("template_code") @db.VarChar(40)
  dltTemplateId     String?          @map("dlt_template_id") @db.VarChar(30)
  body              String           @db.VarChar(1000)
  segments          Int              @default(1)
  status            SmsMessageStatus @default(QUEUED)
  providerMessageId String?          @map("provider_message_id") @db.VarChar(120)
  purpose           String?          @db.VarChar(30)
  error             String?          @db.VarChar(255)
  requestId         String?          @map("request_id") @db.VarChar(64)
  queuedAt          DateTime         @default(now()) @map("queued_at") @db.Timestamptz(6)
  sentAt            DateTime?        @map("sent_at") @db.Timestamptz(6)
  deliveredAt       DateTime?        @map("delivered_at") @db.Timestamptz(6)

  company Company @relation("CompanySmsMessage", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, toMobile])
  @@index([companyId, status])
  @@map("sms_messages")
}

/// A code somebody has to type back. Only its hash is stored, it expires, and it counts the
/// attempts against it.
model OtpChallenge {
  id           String     @id @default(uuid()) @db.Uuid
  companyId    String     @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  purpose      OtpPurpose
  mobile       String     @db.VarChar(15)
  codeHash     String     @map("code_hash") @db.VarChar(120)
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(6)
  attempts     Int        @default(0)
  maxAttempts  Int        @default(5) @map("max_attempts")
  consumedAt   DateTime?  @map("consumed_at") @db.Timestamptz(6)
  smsMessageId String?    @map("sms_message_id") @db.Uuid
  /// Who asked, when there is a session behind the request.
  requestedBy  String?    @map("requested_by") @db.VarChar(36)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation("CompanyOtpChallenge", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, mobile, purpose])
  @@map("otp_challenges")
}

// ─── Scheduled work (P2-01) ───────────────────────────────────────────────────

/// Per-tenant opt-in for the monthly Tally export job. Off by default: the export is manual
/// unless a tenant asks for the file to be prepared for it every month.
model TallyConfig {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @unique @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  autoExportEnabled Boolean  @default(false) @map("auto_export_enabled")
  createdBy         String?  @map("created_by") @db.VarChar(36)
  updatedBy         String?  @map("updated_by") @db.VarChar(36)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation("CompanyTallyConfig", fields: [companyId], references: [id], onDelete: Restrict)

  @@map("tally_configs")
}

// ─── Leave management (P2-09) ─────────────────────────────────────────────────

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A dated leave application against the leave ledger (P2-09). Approval deducts from the
/// `LeaveBalance` via the existing ledger functions in `labour.service.ts`; cancelling an
/// approved request restores the balance with a reversing entry rather than deleting the row —
/// the request stays as the record of what happened and when it was undone.
model LeaveRequest {
  id           String             @id @default(uuid()) @db.Uuid
  companyId    String             @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  employeeId   BigInt             @map("employee_id")
  leaveTypeId  String             @map("leave_type_id") @db.Uuid
  fyCode       String             @map("fy_code") @db.VarChar(10)
  fromDate     DateTime           @map("from_date") @db.Date
  toDate       DateTime           @map("to_date") @db.Date
  /// The first day is only a half day.
  halfDayStart Boolean            @default(false) @map("half_day_start")
  /// The last day is only a half day.
  halfDayEnd   Boolean            @default(false) @map("half_day_end")
  /// Calendar span minus weekly-offs and holidays, minus the two half-day flags.
  days         Decimal            @default(0) @db.Decimal(6, 2)
  reason       String?            @db.VarChar(255)
  status       LeaveRequestStatus @default(PENDING)
  appliedBy    String?            @map("applied_by") @db.VarChar(36)
  approverId   String?            @map("approver_id") @db.VarChar(36)
  decidedAt    DateTime?          @map("decided_at") @db.Timestamptz(6)
  comments     String?            @db.VarChar(255)
  /// Set when an APPROVED request is CANCELLED, so the reversing ledger entry can be traced.
  cancelledAt  DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  company   Company   @relation("CompanyLeaveRequest", fields: [companyId], references: [id], onDelete: Restrict)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([companyId, employeeId, status])
  @@index([companyId, fromDate, toDate])
  @@map("leave_requests")
}

// ── Export order time-and-action calendar (TN-03) ─────────────────────────────

enum OrderTnaStatus {
  ACTIVE
  SHIPPED
  CANCELLED
}

enum TnaMilestoneStatus {
  PENDING
  DONE
  SKIPPED
}

/// One buyer order's T&A plan, counted back from the ex-factory date (TN-03).
model OrderTna {
  id            String         @id @default(uuid()) @db.Uuid
  companyId     String         @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  /// User-entered, or "<buyerPoNo>-<styleRef>" when left blank.
  tnaNo         String         @map("tna_no") @db.VarChar(30)
  customerId    String         @map("customer_id") @db.Uuid
  /// Optional link to a SalesOrder (Int id), checked tenant-scoped by the service.
  salesOrderId  Int?           @map("sales_order_id")
  buyerPoNo     String         @map("buyer_po_no") @db.VarChar(40)
  styleRef      String         @map("style_ref") @db.VarChar(60)
  description   String?        @db.VarChar(200)
  orderQty      Decimal        @map("order_qty") @db.Decimal(14, 3)
  uom           String?        @db.VarChar(10)
  orderDate     DateTime       @map("order_date") @db.Date
  exFactoryDate DateTime       @map("ex_factory_date") @db.Date
  /// GARMENT_KNIT | HOME_TEXTILE | LEATHER_FOOTWEAR | GENERIC (order-tna.calc.ts).
  template      String         @db.VarChar(30)
  merchandiser  String?        @db.VarChar(80)
  status        OrderTnaStatus @default(ACTIVE)
  createdBy     String?        @map("created_by") @db.VarChar(36)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  company    Company             @relation("CompanyOrderTna", fields: [companyId], references: [id], onDelete: Restrict)
  customer   Customer            @relation("CustomerOrderTna", fields: [customerId], references: [id], onDelete: Restrict)
  milestones OrderTnaMilestone[]

  @@unique([companyId, tnaNo])
  @@index([companyId, status, exFactoryDate])
  @@map("order_tnas")
}

/// A milestone on an OrderTna; planned dates of PENDING rows move with the ex-factory date.
model OrderTnaMilestone {
  id          String             @id @default(uuid()) @db.Uuid
  companyId   String             @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  tnaId       String             @map("tna_id") @db.Uuid
  seq         Int
  name        String             @db.VarChar(80)
  plannedDate DateTime           @map("planned_date") @db.Date
  actualDate  DateTime?          @map("actual_date") @db.Date
  status      TnaMilestoneStatus @default(PENDING)
  owner       String?            @db.VarChar(80)
  remarks     String?            @db.VarChar(300)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company  @relation("CompanyOrderTnaMilestone", fields: [companyId], references: [id], onDelete: Restrict)
  tna     OrderTna @relation(fields: [tnaId], references: [id], onDelete: Cascade)

  @@unique([tnaId, seq])
  @@index([companyId, status, plannedDate])
  @@map("order_tna_milestones")
}

/// TN-02: a customer's (OEM's) delivery schedule against an open PO / scheduling agreement.
enum CustomerScheduleStatus {
  OPEN
  CLOSED
  CANCELLED
}

/// TN-02: near-term schedule lines are firm, later ones tentative; adherence counts FIRM only.
enum ScheduleFirmness {
  FIRM
  TENTATIVE
}

/// TN-02: one release of a customer's delivery schedule (a new revision is a new row).
model CustomerSchedule {
  id           String                 @id @default(uuid()) @db.Uuid
  companyId    String                 @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  /// The customer's schedule / release number.
  scheduleNo   String                 @map("schedule_no") @db.VarChar(40)
  customerId   String                 @map("customer_id") @db.Uuid
  /// Scheduling agreement / open PO number.
  customerPoNo String?                @map("customer_po_no") @db.VarChar(40)
  /// First day of the schedule month.
  periodMonth  DateTime               @map("period_month") @db.Date
  receivedOn   DateTime               @map("received_on") @db.Date
  revision     Int                    @default(0)
  status       CustomerScheduleStatus @default(OPEN)
  notes        String?                @db.VarChar(500)
  createdBy    String?                @map("created_by") @db.VarChar(36)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  lines    CustomerScheduleLine[]
  customer Customer               @relation("CustomerDeliverySchedule", fields: [customerId], references: [id], onDelete: Restrict)
  company  Company                @relation("CompanyCustomerSchedule", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, scheduleNo, revision])
  @@index([companyId, customerId, periodMonth])
  @@map("customer_schedules")
}

/// TN-02: one part and due date on a delivery schedule.
model CustomerScheduleLine {
  id             String           @id @default(uuid()) @db.Uuid
  companyId      String           @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  scheduleId     String           @map("schedule_id") @db.Uuid
  productId      BigInt?          @map("product_id")
  customerPartNo String           @map("customer_part_no") @db.VarChar(40)
  description    String?          @db.VarChar(120)
  dueDate        DateTime         @map("due_date") @db.Date
  firmness       ScheduleFirmness @default(FIRM)
  scheduledQty   Decimal          @map("scheduled_qty") @db.Decimal(14, 3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  dispatches CustomerScheduleDispatch[]
  schedule   CustomerSchedule           @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  product    Product?                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  company    Company                    @relation("CompanyCustomerScheduleLine", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, dueDate])
  @@index([scheduleId])
  @@map("customer_schedule_lines")
}

/// TN-02: a quantity dispatched against a schedule line (linked to an invoice by id only).
model CustomerScheduleDispatch {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  lineId         String   @map("line_id") @db.Uuid
  dispatchDate   DateTime @map("dispatch_date") @db.Date
  qty            Decimal  @db.Decimal(14, 3)
  salesInvoiceId String?  @map("sales_invoice_id") @db.Uuid
  invoiceNo      String?  @map("invoice_no") @db.VarChar(30)
  asnNo          String?  @map("asn_no") @db.VarChar(40)
  createdBy      String?  @map("created_by") @db.VarChar(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  line    CustomerScheduleLine @relation(fields: [lineId], references: [id], onDelete: Restrict)
  company Company              @relation("CompanyCustomerScheduleDispatch", fields: [companyId], references: [id], onDelete: Restrict)

  @@index([lineId])
  @@index([companyId, dispatchDate])
  @@map("customer_schedule_dispatches")
}

// ── Export incentives and authorisations (TN-01) ─────────────────────────────

enum ExportIncentiveScheme {
  RODTEP
  ROSCTL
  DRAWBACK
}

enum ExportIncentiveStatus {
  DECLARED
  SCROLLED
  SCRIP_GENERATED
  UTILISED
  TRANSFERRED
  CREDITED
  REJECTED
}

/// A duty incentive earned on one shipping bill (RoDTEP, RoSCTL or drawback), from declaration to
/// credit. The status only moves forward; `scripExpiresOn` is the scrip date plus 12 months.
model ExportIncentiveClaim {
  id               String                @id @default(uuid()) @db.Uuid
  companyId        String                @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  scheme           ExportIncentiveScheme
  shippingBillNo   String                @map("shipping_bill_no") @db.VarChar(20)
  shippingBillDate DateTime              @map("shipping_bill_date") @db.Date
  portCode         String?               @map("port_code") @db.VarChar(10)
  salesInvoiceId   String?               @map("sales_invoice_id") @db.Uuid
  fobValueInr      Decimal               @map("fob_value_inr") @db.Decimal(16, 2)
  ratePercent      Decimal?              @map("rate_percent") @db.Decimal(6, 3)
  /// fob * rate / 100 when a rate is given, otherwise as entered.
  expectedAmount   Decimal               @map("expected_amount") @db.Decimal(14, 2)
  scrolledAmount   Decimal?              @map("scrolled_amount") @db.Decimal(14, 2)
  scrolledOn       DateTime?             @map("scrolled_on") @db.Date
  scripNo          String?               @map("scrip_no") @db.VarChar(30)
  scripDate        DateTime?             @map("scrip_date") @db.Date
  scripExpiresOn   DateTime?             @map("scrip_expires_on") @db.Date
  utilisedAmount   Decimal               @default(0) @map("utilised_amount") @db.Decimal(14, 2)
  /// Buyer IEC or name when a scrip was sold.
  transferredTo    String?               @map("transferred_to") @db.VarChar(120)
  /// Sale proceeds of a scrip, or the drawback credit.
  realisedInr      Decimal?              @map("realised_inr") @db.Decimal(14, 2)
  creditedOn       DateTime?             @map("credited_on") @db.Date
  status           ExportIncentiveStatus @default(DECLARED)
  notes            String?               @db.VarChar(500)
  createdBy        String?               @map("created_by") @db.VarChar(36)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company       @relation("CompanyExportIncentiveClaim", fields: [companyId], references: [id], onDelete: Restrict)
  salesInvoice SalesInvoice? @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)

  @@unique([companyId, scheme, shippingBillNo])
  @@index([companyId, status])
  @@map("export_incentive_claims")
}

enum ExportAuthorisationType {
  EPCG
  ADVANCE_AUTHORISATION
}

enum ExportAuthorisationStatus {
  ACTIVE
  EO_FULFILLED
  REDEEMED
  EXPIRED
  CANCELLED
}

/// An EPCG or Advance Authorisation licence and its export obligation. Never deleted; a
/// withdrawn licence is CANCELLED.
model ExportAuthorisation {
  id                     String                    @id @default(uuid()) @db.Uuid
  companyId              String                    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  authType               ExportAuthorisationType   @map("auth_type")
  authNo                 String                    @map("auth_no") @db.VarChar(30)
  issueDate              DateTime                  @map("issue_date") @db.Date
  rlaOffice              String?                   @map("rla_office") @db.VarChar(60)
  dutySaved              Decimal                   @map("duty_saved") @db.Decimal(16, 2)
  eoMultiple             Decimal                   @default(6) @map("eo_multiple") @db.Decimal(5, 2)
  /// EPCG: dutySaved * eoMultiple unless overridden; AA: as entered.
  exportObligationAmount Decimal                   @map("eo_amount") @db.Decimal(16, 2)
  eoPeriodMonths         Int                       @map("eo_period_months")
  eoDueDate              DateTime                  @map("eo_due_date") @db.Date
  /// EPCG only: issue date + 48 months, by which 50% of the obligation is due.
  block1DueDate          DateTime?                 @map("block1_due_date") @db.Date
  status                 ExportAuthorisationStatus @default(ACTIVE)
  eodcNo                 String?                   @map("eodc_no") @db.VarChar(30)
  eodcDate               DateTime?                 @map("eodc_date") @db.Date
  notes                  String?                   @db.VarChar(500)
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company                 @relation("CompanyExportAuthorisation", fields: [companyId], references: [id], onDelete: Restrict)
  entries ExportObligationEntry[]

  @@unique([companyId, authNo])
  @@map("export_authorisations")
}

/// One shipping bill counted towards an authorisation's export obligation.
model ExportObligationEntry {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  authorisationId  String    @map("authorisation_id") @db.Uuid
  shippingBillNo   String    @map("shipping_bill_no") @db.VarChar(20)
  shippingBillDate DateTime  @map("shipping_bill_date") @db.Date
  salesInvoiceId   String?   @map("sales_invoice_id") @db.Uuid
  fobValueInr      Decimal   @map("fob_value_inr") @db.Decimal(16, 2)
  /// BRC / e-BRC date; the obligation counts realised value.
  realisedOn       DateTime? @map("realised_on") @db.Date
  brcNo            String?   @map("brc_no") @db.VarChar(40)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company       Company             @relation("CompanyExportObligationEntry", fields: [companyId], references: [id], onDelete: Restrict)
  authorisation ExportAuthorisation @relation(fields: [authorisationId], references: [id], onDelete: Restrict)

  @@unique([companyId, authorisationId, shippingBillNo])
  @@map("export_obligation_entries")
}

/// TN-09: lifecycle of a body-building or fabrication job.
enum ProjectJobStatus {
  QUOTED
  IN_PROGRESS
  COMPLETED
  DELIVERED
  CANCELLED
}

/// TN-09: a stage on a job's plan.
enum ProjectJobStageStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

/// TN-09: what a cost line is.
enum ProjectJobCostType {
  MATERIAL
  LABOUR
  SUBCONTRACT
  OVERHEAD
}

/// TN-09: a DRAFT cost line can be removed; a POSTED one is locked.
enum ProjectJobCostStatus {
  DRAFT
  POSTED
}

/// TN-09: advances received and invoices raised against a job.
enum ProjectJobBillingKind {
  ADVANCE
  STAGE_INVOICE
  FINAL
}

/// TN-09: one customer job (a truck body on the customer's chassis, a fabrication order) costed
/// on its own and compared with its quote.
model ProjectJob {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  jobNo             String           @map("job_no") @db.VarChar(30)
  customerId        String           @map("customer_id") @db.Uuid
  title             String           @db.VarChar(120)
  description       String?          @db.VarChar(500)
  quotedAmount      Decimal          @map("quoted_amount") @db.Decimal(14, 2)
  quoteDate         DateTime         @map("quote_date") @db.Date
  targetDate        DateTime?        @map("target_date") @db.Date
  /// Customer-owned chassis or material held in custody while the job runs.
  chassisNo         String?          @map("chassis_no") @db.VarChar(40)
  chassisMake       String?          @map("chassis_make") @db.VarChar(80)
  chassisReceivedOn DateTime?        @map("chassis_received_on") @db.Date
  conditionNotes    String?          @map("condition_notes") @db.VarChar(500)
  status            ProjectJobStatus @default(QUOTED)
  createdBy         String?          @map("created_by") @db.VarChar(36)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company             @relation("CompanyProjectJob", fields: [companyId], references: [id], onDelete: Restrict)
  customer Customer            @relation("CustomerProjectJob", fields: [customerId], references: [id], onDelete: Restrict)
  stages   ProjectJobStage[]
  costs    ProjectJobCost[]
  billings ProjectJobBilling[]

  @@unique([companyId, jobNo])
  @@index([companyId, status])
  @@map("project_jobs")
}

/// TN-09: an ordered stage of a job's plan (chassis inward, fabrication, paneling ...).
model ProjectJobStage {
  id           String                @id @default(uuid()) @db.Uuid
  companyId    String                @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  jobId        String                @map("job_id") @db.Uuid
  seq          Int
  name         String                @db.VarChar(80)
  /// Relative weight for % complete (default 1).
  weight       Int                   @default(1)
  plannedStart DateTime?             @map("planned_start") @db.Date
  plannedEnd   DateTime?             @map("planned_end") @db.Date
  actualStart  DateTime?             @map("actual_start") @db.Date
  actualEnd    DateTime?             @map("actual_end") @db.Date
  status       ProjectJobStageStatus @default(PENDING)
  remarks      String?               @db.VarChar(300)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company             @relation("CompanyProjectJobStage", fields: [companyId], references: [id], onDelete: Restrict)
  job      ProjectJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  billings ProjectJobBilling[]

  @@unique([jobId, seq])
  @@index([companyId])
  @@map("project_job_stages")
}

/// TN-09: a cost booked to a job. Amount = qty x rate (labour: hours x rate per hour).
model ProjectJobCost {
  id            String               @id @default(uuid()) @db.Uuid
  companyId     String               @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  jobId         String               @map("job_id") @db.Uuid
  type          ProjectJobCostType
  costDate      DateTime             @map("cost_date") @db.Date
  description   String               @db.VarChar(200)
  qty           Decimal              @db.Decimal(14, 3)
  uom           String?              @db.VarChar(20)
  rate          Decimal              @db.Decimal(14, 2)
  amount        Decimal              @db.Decimal(14, 2)
  /// RawMaterial.id, checked tenant-scoped by the service.
  rawMaterialId String?              @map("raw_material_id") @db.Uuid
  /// RawMaterialTransaction.rmTxnId of an issue, checked tenant-scoped; costed once.
  stockIssueId  BigInt?              @map("stock_issue_id")
  /// Employee.id for labour, checked tenant-scoped.
  employeeId    BigInt?              @map("employee_id")
  vendorName    String?              @map("vendor_name") @db.VarChar(120)
  status        ProjectJobCostStatus @default(DRAFT)
  createdBy     String?              @map("created_by") @db.VarChar(36)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company    @relation("CompanyProjectJobCost", fields: [companyId], references: [id], onDelete: Restrict)
  job     ProjectJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([companyId, stockIssueId])
  @@index([companyId, jobId, type])
  @@map("project_job_costs")
}

/// TN-09: an advance received or an invoice raised against a job.
model ProjectJobBilling {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  jobId           String                @map("job_id") @db.Uuid
  kind            ProjectJobBillingKind
  billDate        DateTime              @map("bill_date") @db.Date
  amount          Decimal               @db.Decimal(14, 2)
  /// On an invoice: the part of it settled from advances already received.
  advanceAdjusted Decimal               @default(0) @map("advance_adjusted") @db.Decimal(14, 2)
  stageId         String?               @map("stage_id") @db.Uuid
  /// SalesInvoice.id, checked tenant-scoped by the service.
  salesInvoiceId  String?               @map("sales_invoice_id") @db.Uuid
  reference       String?               @db.VarChar(60)
  remarks         String?               @db.VarChar(300)
  createdBy       String?               @map("created_by") @db.VarChar(36)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company          @relation("CompanyProjectJobBilling", fields: [companyId], references: [id], onDelete: Restrict)
  job     ProjectJob       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  stage   ProjectJobStage? @relation(fields: [stageId], references: [id], onDelete: Restrict)

  @@index([companyId, jobId])
  @@map("project_job_billings")
}
