/// Chart-of-accounts tree (P1-09c): primary groups by nature, Schedule III head per group.
model LedgerGroup {
  id           Int             @id @default(autoincrement())
  companyId    String          @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  code         String          @db.VarChar(40)
  name         String          @db.VarChar(120)
  nature       LedgerType
  parentId     Int?            @map("parent_id")
  /// Schedule III line the group rolls up to on the balance sheet or P&L.
  scheduleHead String?         @map("schedule_head") @db.VarChar(80)
  isSystem     Boolean         @default(false) @map("is_system")
  isActive     Boolean         @default(true) @map("is_active")
  sortOrder    Int             @default(0) @map("sort_order")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent       LedgerGroup?    @relation("LedgerGroupTree", fields: [parentId], references: [id])
  children     LedgerGroup[]   @relation("LedgerGroupTree")
  ledgers      AccountLedger[]

  company Company @relation("CompanyLedgerGroup", fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@index([companyId, parentId])
  @@map("ledger_groups")
}

model AccountLedger {
  id          Int           @id @default(autoincrement())
