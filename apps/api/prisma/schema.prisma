}

/// Field-sales mobile app: a planned or executed customer visit (id generated on the device).
model MobileVisit {
  id          String    @id @db.Uuid
  companyId   String    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  agentUserId String    @map("agent_user_id") @db.VarChar(36)
  customerId  String    @map("customer_id") @db.Uuid
  routeId     String?   @map("route_id") @db.Uuid
  plannedDate DateTime  @map("planned_date") @db.Date
  plannedTime String?   @map("planned_time") @db.VarChar(5)
  sequence    Int       @default(0)
  status      String    @default("PLANNED") @db.VarChar(20)
  outcome     String?   @db.VarChar(20)
  checkInAt   DateTime? @map("check_in_at") @db.Timestamptz(6)
  checkOutAt  DateTime? @map("check_out_at") @db.Timestamptz(6)
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  notes       String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  company  Company  @relation("CompanyMobileVisit", fields: [companyId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id])
  route    Route?   @relation(fields: [routeId], references: [id])

  @@index([companyId, agentUserId, plannedDate])
  @@index([companyId, customerId])
  @@index([companyId, updatedAt])
  @@map("mobile_visits")
}

/// Field collection captured on the mobile app; posted to invoices and receipt vouchers on push.
model MobileCollection {
  id          String    @id @db.Uuid
  companyId   String    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  receiptNo   String    @map("receipt_no") @db.VarChar(30)
  agentUserId String    @map("agent_user_id") @db.VarChar(36)
  customerId  String    @map("customer_id") @db.Uuid
  visitId     String?   @map("visit_id") @db.Uuid
  amount      Decimal   @db.Decimal(14, 2)
  paymentMode String    @map("payment_mode") @db.VarChar(20)
  referenceNo String?   @map("reference_no") @db.VarChar(100)
