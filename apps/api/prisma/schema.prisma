generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                       BigInt         @id @default(autoincrement())
  empCode                  String         @unique
  fullName                 String
  mobile                   String?        @db.VarChar(20)
  email                    String?        @unique @db.VarChar(100)
  dateOfJoining            DateTime?
  departmentId             Int?
  status                   EmployeeStatus @default(active)
  createdAt                DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime       @updatedAt @db.Timestamptz(6)
  createdBy                String?
  updatedBy                String?
  collectionAgentCustomers Customer[]     @relation("EmployeeCollectionAgent")
  createdByUser            User?          @relation("EmployeeCreatedBy", fields: [createdBy], references: [userId])
  department               Department?    @relation(fields: [departmentId], references: [id])
  updatedByUser            User?          @relation("EmployeeUpdatedBy", fields: [updatedBy], references: [userId])
  stores                   Store[]
  user                     User?

  @@index([departmentId])
  @@index([status])
  @@map("employees")
}

model Admin {
  id                  BigInt               @id @default(autoincrement())
  fullName            String
  email               String?              @unique
  phone               String?
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  username            String               @unique
  passwordHash        String
  status              UserStatus           @default(active)
  lastLoginAt         DateTime?            @db.Timestamptz(6)
  roleId              Int?
  role                Role?                @relation(fields: [roleId], references: [id])
  auditLogs           AuditLog[]           @relation("ChangedByAdmin")
  loginAttempts       LoginAttempt[]
  passwordResetTokens PasswordResetToken[]
  userSessions        UserSession[]

  @@map("admins")
}

model User {
  userId                String               @id @default(uuid())
  username              String               @unique
  fullName              String
  email                 String?              @unique
  passwordHash          String
  employeeId            BigInt?              @unique
  roleId                Int?
  status                UserStatus           @default(active)
  mustChangePw          Boolean              @default(false)
  failedAttempts        Int                  @default(0)
  lockedUntil           DateTime?            @db.Timestamptz(6)
  lastLoginAt           DateTime?            @db.Timestamptz(6)
  lastLoginIp           String?
  mfaEnabled            Boolean              @default(false)
  mfaSecret             String?
  createdBy             String?
  createdOn             DateTime             @default(now()) @db.Timestamptz(6)
  updatedOn             DateTime             @updatedAt @db.Timestamptz(6)
  auditLogs             AuditLog[]           @relation("ChangedBy")
  createdEmployees      Employee[]           @relation("EmployeeCreatedBy")
  updatedEmployees      Employee[]           @relation("EmployeeUpdatedBy")
  loginAttempts         LoginAttempt[]
  passwordResetTokens   PasswordResetToken[]
  createdSalesOrders    SalesOrder[]         @relation("SalesOrderCreatedBy")
  mdApprovedSalesOrders SalesOrder[]         @relation("SalesOrderMdApprover")
  sessions              UserSession[]
  expensesCreated       Expense[]            @relation("ExpenseCreatedBy")
  employee              Employee?            @relation(fields: [employeeId], references: [id])
  role                  Role?                @relation(fields: [roleId], references: [id])

  @@index([status])
  @@index([employeeId])
  @@index([roleId])
  @@map("users")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String?
  adminId      BigInt?
  sessionToken String    @unique
  ipAddress    String?
  userAgent    String?
  deviceLabel  String?
  loginAt      DateTime  @default(now()) @db.Timestamptz(6)
  logoutAt     DateTime? @db.Timestamptz(6)
  expiresAt    DateTime  @db.Timestamptz(6)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  admin        Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([adminId, isActive])
  @@index([sessionToken])
  @@map("user_sessions")
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String?
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz(6)
  usedAt      DateTime? @db.Timestamptz(6)
  used        Boolean   @default(false)
  requestedIp String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  adminId     BigInt?
  admin       Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model LoginAttempt {
  id            BigInt   @id @default(autoincrement())
  username      String
  userId        String?
  ipAddress     String
  success       Boolean
  failureReason String?
  userAgent     String?
  attemptedAt   DateTime @default(now()) @db.Timestamptz(6)
  adminId       BigInt?
  admin         Admin?   @relation(fields: [adminId], references: [id])
  user          User?    @relation(fields: [userId], references: [userId])

  @@index([username])
  @@index([ipAddress])
  @@index([attemptedAt])
  @@index([userId])
  @@map("login_attempts")
}

model AuditLog {
  id                BigInt      @id @default(autoincrement())
  entityName        String
  entityId          String?
  action            AuditAction
  oldValues         Json?
  newValues         Json?
  changedBy         String?
  ipAddress         String?
  userAgent         String?
  changedAt         DateTime    @default(now()) @db.Timestamptz(6)
  changedByAdmin    BigInt?
  changedByAdminRel Admin?      @relation("ChangedByAdmin", fields: [changedByAdmin], references: [id])
  changedByUser     User?       @relation("ChangedBy", fields: [changedBy], references: [userId])

  @@index([entityName, entityId])
  @@index([changedBy])
  @@map("audit_log")
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique
  module          String
  action          String
  scope           String?
  description     String?
  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id              Int              @id @default(autoincrement())
  code            String           @unique @default("ADMIN")
  name            String
  description     String?
  isSystem        Boolean          @default(true)
  status          RoleStatus       @default(active)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  rolePermissions RolePermission[]
  users           User[]
  Admin           Admin[]

  @@map("roles")
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Department {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]

  @@map("departments")
}

model Customer {
  contactPerson        String?                  @db.VarChar(80)
  whatsapp             String?                  @db.VarChar(15)
  email                String?                  @db.VarChar(120)
  gstin                String?                  @db.VarChar(15)
  creditLimit          Decimal                  @default(0) @db.Decimal(14, 2)
  createdBy            String
  createdAt            DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(6)
  aiRiskBand           String?                  @db.VarChar(10)
  aiRiskScore          Int?
  altPhone             String?                  @db.VarChar(15)
  bankAccount          Json?
  transports           Json?
  billingAddressLine1  String                   @db.VarChar(255)
  billingCity          String                   @db.VarChar(100)
  billingState         String                   @db.VarChar(100)
  billingPincode       String                   @db.VarChar(20)
  billingCountry       String?                  @default("India") @db.VarChar(100)
  collectionAgentId    BigInt?
  companyId            String                   @db.Uuid
  creditDays           Int                      @default(0)
  customerCode         String                   @db.VarChar(20)
  customerType         String                   @db.VarChar(100)
  deletedAt            DateTime?                @db.Timestamptz(6)
  designation          String?                  @db.VarChar(60)
  displayName          String?                  @db.VarChar(80)
  firmName             String                   @db.VarChar(160)
  gstRegType           String?                  @db.VarChar(20)
  mobile               Json?                    @map("mobile")
  pan                  String?                  @db.VarChar(10)
  priceList            String?                  @default("Standard") @db.VarChar(20)
  routeId              String?                  @db.Uuid
  searchTsv            Unsupported("tsvector")?
  shippingAddressLine1 String?                  @db.VarChar(255)
  shippingCity         String?                  @db.VarChar(100)
  shippingState        String?                  @db.VarChar(100)
  shippingPincode      String?                  @db.VarChar(20)
  shippingCountry      String?                  @default("India") @db.VarChar(100)
  stateCode            String                   @db.VarChar(2)
  status               String                   @default("Active") @db.VarChar(20)
  tcsRate              Decimal                  @default(0) @db.Decimal(5, 2)
  tdsSection           String?                  @db.VarChar(10)
  updatedBy            String?
  id                   String                   @id @default(uuid()) @db.Uuid
  collectionAgent      Employee?                @relation("EmployeeCollectionAgent", fields: [collectionAgentId], references: [id])
  company              Company                  @relation(fields: [companyId], references: [id])
  route                Route?                   @relation(fields: [routeId], references: [id])
  salesOrders          SalesOrder[]             @relation("CustomerSalesOrders")
  salesInvoices        SalesInvoice[]
  addresses            CustomerAddress[]

  @@unique([companyId, customerCode])
  @@index([companyId, status], map: "idx_cust_company_status")
  @@index([routeId, collectionAgentId], map: "idx_cust_route_agent")
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(uuid()) @map("id")
  address    Json     @map("address")
  customerId String   @map("customer_id") @db.Uuid
  is_default Boolean  @default(false)
  label      String   @db.VarChar(40)
  state_code String   @db.VarChar(50)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model Company {
  id             String          @id @default(uuid()) @db.Uuid
  companyCode    String?         @unique @db.VarChar(20)
  companyName    String          @db.VarChar(160)
  legalName      String?         @db.VarChar(160)
  shortName      String?         @db.VarChar(60)
  gstin          String?         @db.VarChar(15)
  currencyCode   String          @default("INR") @db.VarChar(3)
  phone          String?         @db.VarChar(20)
  mobile         String?         @db.VarChar(20)
  email          String?         @db.VarChar(120)
  website        String?         @db.VarChar(200)
  logoUrl        String?
  faviconUrl     String?
  addressLine1   String?         @db.VarChar(255)
  addressLine2   String?         @db.VarChar(255)
  city           String?         @db.VarChar(100)
  state          String?         @db.VarChar(100)
  zipcode        String?         @db.VarChar(20)
  country        String?         @db.VarChar(100)
  isOnboarded    Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdBy      String?         @db.Uuid
  updatedBy      String?         @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  businessPlaces BusinessPlace[]
  customers      Customer[]
  whatsappConfig WhatsappConfig?
  invoiceSetting InvoiceSetting?
  expenses       Expense[]

  @@map("companies")
}

model WhatsappConfig {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @unique @db.Uuid
  phoneNumberId String   @db.VarChar(50)
  wabaId        String   @db.VarChar(50)
  businessPhone String   @db.VarChar(20)
  accessToken   String   @db.Text
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  company       Company  @relation(fields: [companyId], references: [id])

  @@map("whatsapp_configs")
}

model BusinessPlace {
  id           BigInt            @id @default(autoincrement())
  companyId    String            @db.Uuid
  code         String            @db.VarChar(20)
  name         String            @db.VarChar(120)
  type         BusinessPlaceType
  gstPlaceCode String?           @db.VarChar(2)
  phone        String?           @db.VarChar(20)
  email        String?           @db.VarChar(120)
  isHeadOffice Boolean           @default(false)
  isActive     Boolean           @default(true)
  address      Json?
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(6)
  company      Company           @relation(fields: [companyId], references: [id])
  machines     Machine[]
  stores       Store[]

  @@map("business_places")
}

model Route {
  id        String     @id @default(uuid()) @db.Uuid
  routeCode String     @unique
  routeName String
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  customers Customer[]

  @@map("routes")
}

model SupplierMaterialPrice {
  id            String    @id @default(uuid())
  supplierId    Int
  rawMaterialId String
  price         Decimal
  validFrom     DateTime
  validTo       DateTime?
  createdAt     DateTime  @default(now())
  supplier      Supplier  @relation(fields: [supplierId], references: [id])

  @@index([supplierId, rawMaterialId, validFrom, validTo])
}

model Supplier {
  designation           String?                 @map("designation") @db.VarChar(60)
  mobile                Json?                   @map("mobile")
  email                 String?                 @map("email") @db.VarChar(120)
  website               String?                 @map("website") @db.VarChar(200)
  gstin                 String?                 @map("gstin") @db.VarChar(15)
  pan                   String?                 @map("pan") @db.VarChar(10)
  currency              String                  @default("INR") @map("currency") @db.Char(3)
  altPhone              String?                 @map("alt_phone") @db.VarChar(15)
  bankHolder            String?                 @map("bank_holder") @db.VarChar(80)
  bankIfsc              String?                 @map("bank_ifsc") @db.VarChar(11)
  billingAddressLine1   String                  @map("billing_address_line1") @db.VarChar(255)
  billingCity           String                  @map("billing_city") @db.VarChar(100)
  billingState          String                  @map("billing_state") @db.VarChar(100)
  billingPincode        String                  @map("billing_pincode") @db.VarChar(20)
  billingCountry        String?                 @default("India") @map("billing_country") @db.VarChar(100)
  category              String                  @map("category") @db.VarChar(255)
  companyId             String                  @map("company_id")
  contactPerson         String?                 @map("contact_person") @db.VarChar(80)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy             String                  @map("created_by")
  deletedAt             DateTime?               @map("deleted_at") @db.Timestamptz(6)
  displayName           String?                 @map("display_name") @db.VarChar(80)
  gstRegType            String?                 @map("gst_reg_type") @db.VarChar(20)
  leadTimeDays          Int                     @map("lead_time_days") @db.SmallInt
  legalName             String                  @map("legal_name") @db.VarChar(160)
  minOrderQty           Decimal?                @map("min_order_qty") @db.Decimal(12, 3)
  msmeStatus            String?                 @map("msme_status") @db.VarChar(10)
  onTimePct             Decimal?                @map("on_time_pct") @db.Decimal(5, 2)
  paymentTerms          String                  @map("payment_terms") @db.VarChar(20)
  stateCode             String                  @map("state_code") @db.VarChar(2)
  status                String                  @default("Active") @map("status") @db.VarChar(20)
  supplierCode          String                  @map("supplier_code") @db.VarChar(20)
  tdsSection            String?                 @map("tds_section") @db.VarChar(10)
  udyamNo               String?                 @map("udyam_no") @db.VarChar(20)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy             String?                 @map("updated_by")
  upiId                 String?                 @map("upi_id") @db.VarChar(50)
  vendorType            String                  @map("vendor_type") @db.VarChar(20)
  bankAccount           Json?                   @map("bank_account")
  rawMaterialCategories String?                 @map("raw_material_categories") @db.VarChar(255)
  whatsapp              String?                 @map("whatsapp") @db.VarChar(15)
  id                    Int                     @id @default(autoincrement())
  materialPrices        SupplierMaterialPrice[]
  purchaseOrders        PurchaseOrder[]
  addresses             SupplierAddress[]
  expenses              Expense[]
  grnInvoices           GrnInvoice[]

  @@unique([companyId, supplierCode])
  @@index([legalName])
  @@index([status])
  @@map("suppliers")
}

model SupplierAddress {
  id         String   @id @default(uuid()) @map("id")
  address    Json     @map("address")
  supplierId Int      @map("supplier_id")
  is_default Boolean  @default(false)
  label      String   @db.VarChar(40)
  state_code String   @db.VarChar(50)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_addresses")
}

model Shift {
  id                   Int                    @id @default(autoincrement())
  shiftCode            String                 @unique
  shiftName            String                 @unique
  startTime            String
  endTime              String
  breakDuration        Int?
  gracePeriod          Int?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  HourlyProduction     HourlyProduction[]
  productionWastages   ProductionWastage[]
  WeeklyMachineProgram WeeklyMachineProgram[]
  dailyProductionPlans DailyProductionPlan[]

  @@map("shifts")
}

model Category {
  id            Int           @id @default(autoincrement())
  categoryCode  String        @unique
  categoryName  String
  description   String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  products      Product[]
  subCategories SubCategory[]

  @@map("categories")
}

model SubCategory {
  id              Int       @id @default(autoincrement())
  subCategoryCode String    @unique
  subCategoryName String
  description     String?
  categoryId      Int
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]
  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([id, categoryId])
  @@index([categoryId])
  @@map("sub_categories")
}

model ProductImage {
  id        BigInt  @id @default(autoincrement())
  productId BigInt
  imageUrl  String
  isPrimary Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Product {
  id                        BigInt                     @id @default(autoincrement())
  productCode               String                     @unique
  itemCode                  String?
  productName               String
  displayName               String?
  description               String?
  categoryId                Int
  subCategoryId             Int?
  uomId                     Int?
  capacityLitres            Decimal?                   @db.Decimal(6, 2)
  typeCode                  String?
  bundleQty                 Int?
  weightPerPiece            Decimal?                   @db.Decimal(10, 2)
  dimensions                String?
  mouldReference            String?
  tags                      String?
  isActive                  Boolean                    @default(true)
  createdBy                 String?
  modifiedBy                String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  mrp                       Decimal?                   @db.Decimal(12, 2)
  b2b                       Decimal?                   @db.Decimal(12, 2)
  b2c                       Decimal?                   @db.Decimal(12, 2)
  exportPrice               Decimal?                   @db.Decimal(12, 2)
  cess                      Decimal?                   @db.Decimal(5, 2)
  gstRate                   Decimal?                   @db.Decimal(5, 2)
  gstTaxRateId              String?                    @map("gst_tax_rate_id")
  hsnCode                   String?
  maximumQty                String                     @default("0") @map("maximum_qty")
  minimumQty                String                     @default("0") @map("minimum_qty")
  billOfMaterials           BillOfMaterial[]
  finishedGoodsStocks       FinishedGoodsStock[]
  finishedGoodsTransactions FinishedGoodsTransaction[]
  images                    ProductImage[]
  productionOrders          ProductionOrder[]
  productionWastages        ProductionWastage[]
  productionSteps           ProductionStep[]
  category                  Category                   @relation(fields: [categoryId], references: [id])
  gstTaxRate                GstTaxRate?                @relation(fields: [gstTaxRateId], references: [id])
  subCategory               SubCategory?               @relation(fields: [subCategoryId, categoryId], references: [id, categoryId])
  uom                       UnitOfMeasure?             @relation(fields: [uomId], references: [id], onDelete: Restrict)
  salesOrderItems           SalesOrderItem[]           @relation("SalesOrderItemProduct")
  StockAdjustmentItem       StockAdjustmentItem[]
  weeklyPrograms            WeeklyMachineProgram[]     @relation("ProductWeeklyPrograms")
  salesInvoiceItems         SalesInvoiceItem[]
  goodsDispatchItems        GoodsDispatchItem[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([uomId])
  @@index([gstTaxRateId])
  @@index([productName])
  @@map("products")
}

model ProductionStep {
  id         BigInt  @id @default(autoincrement())
  productId  BigInt  @map("product_id")
  stepKey    String  @map("step_key")
  stepOrder  Int     @map("step_order")

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("production_steps")
}

model UnitOfMeasure {
  id          Int       @id @default(autoincrement())
  uomCode     String    @unique
  uomName     String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Product     Product[]

  @@map("units_of_measure")
}

model Location {
  locationId   String   @id @map("location_id") @db.VarChar(20)
  locationCode String   @unique @map("location_code") @db.VarChar(30)
  locationName String   @map("location_name") @db.VarChar(100)
  locationType String   @map("location_type") @db.VarChar(50)
  address      String?  @map("address") @db.VarChar(255)
  city         String?  @map("city") @db.VarChar(100)
  state        String?  @map("state") @db.VarChar(100)
  country      String?  @map("country") @db.VarChar(100)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    String?  @map("created_by") @db.VarChar(36)
  updatedBy    String?  @map("updated_by") @db.VarChar(36)
  stores       Store[]

  @@index([locationCode])
  @@index([isActive])
  @@map("locations")
}

model Machine {
  machineId             String                 @id @map("machine_id") @db.VarChar(20)
  machineName           String                 @map("machine_name") @db.VarChar(100)
  technologyType        TechnologyType?
  machineType           MachineType?
  capacity              Decimal?               @db.Decimal(10, 2)
  targetTemperature     Decimal?               @map("target_temperature") @db.Decimal(5, 2)
  targetLoadPercent     Decimal?               @map("target_load_percent") @db.Decimal(5, 2)
  manufacturer          String?                @db.VarChar(100)
  modelNumber           String?                @map("model_number") @db.VarChar(50)
  cycleTime             Decimal?               @map("cycle_time") @db.Decimal(10, 2)
  operatorId            String?                @map("operator_id") @db.VarChar(20)
  machineStatus         MachineStatus          @default(IDLE)
  isActive              Boolean                @default(true)
  description           String?                @db.VarChar(255)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  businessPlaceId       BigInt?
  hourlyProductions     HourlyProduction[]
  businessPlace         BusinessPlace?         @relation(fields: [businessPlaceId], references: [id])
  productionOrders      ProductionOrder[]
  productionWastages    ProductionWastage[]
  weeklyMachinePrograms WeeklyMachineProgram[]
  dailyProductionPlans  DailyProductionPlan[]
  oeeSnapshots          MachineOeeSnapshot[]

  @@map("machines")
}

model Store {
  storeId                   String                     @id @map("store_id") @db.VarChar(20)
  storeName                 String                     @map("store_name") @db.VarChar(120)
  locationId                String?                    @map("location_id") @db.VarChar(20)
