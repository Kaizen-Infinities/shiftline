# Core
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://shiftline:shiftline@localhost:5432/shiftline
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Background jobs (pg-boss). Run `npm run worker -w @shiftline/api` in a second
# terminal, or set EMBED_WORKER=true to run the jobs inside the API process.
EMBED_WORKER=false
PGBOSS_SCHEMA=pgboss
# Retention archives (gzipped NDJSON per sweep); gitignored.
ARCHIVE_DIR=./archives
# Daily pg_dump (01:30 IST) and rotation; gitignored. pg_dump must be >= the server version.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
PG_DUMP_PATH=pg_dump

# Observability. Logs are pino JSON (pretty in development); SENTRY_DSN enables error reporting.
LOG_LEVEL=
LOG_FORMAT=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Release tag on Sentry events. Unset means no release is attached.
# GIT_SHA=

# Auth. Access tokens last 15 minutes; the refresh cookie slides for REFRESH_TOKEN_TTL_DAYS
# (30 days absolute). Cross-origin dev needs SameSite=None (default outside production).
# Both keys must be at least 32 characters; the values below are development placeholders.
JWT_ACCESS_SECRET=dev-jwt-access-secret-shiftline-local-0123456789abcdef
# Encrypts stored credentials (SMTP passwords, WhatsApp tokens, GSP secrets). Required in production.
DATA_ENCRYPTION_KEY=dev-data-encryption-key-shiftline-local-0123456789ab
# Signs the platform gateway's subscription callbacks (P1-21). Unset means the callback is refused.
# PLATFORM_GATEWAY_WEBHOOK_SECRET=
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_REUSE_GRACE_MS=10000
# Login attempts per IP per 15 minutes (browser test suites raise it)
AUTH_RATE_LIMIT_MAX=30
# Global ceiling per IP per 15 minutes; raise it for a browser suite that renders every screen from one IP.
GLOBAL_RATE_LIMIT_MAX=1200
REFRESH_COOKIE_SAMESITE=
COOKIE_SECURE=

# First platform admin (required in production, no defaults). Development placeholders:
ADMIN_EMAIL=admin@dev.shiftline.local
ADMIN_USERNAME=devadmin
# Quoted: unquoted, dotenv reads "#" as the start of a comment and the password as "DevAdmin".
ADMIN_PASSWORD="DevAdmin#2026!!"

# Password for the seeded demo tenant users (owner@demo.shiftline.local and friends).
SEED_PASSWORD=Demo@12345678

# Email (fallback when a company has no SMTP config)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_ENCRYPTION=ssl
FROM_NAME=Shiftline

# Exchange rates (daily pull). FIXTURE (default) uses no network; RBI reads the feed below.
# Any other value fails validation at boot.
# RATE_PROVIDER=FIXTURE
# RBI reference-rate feed; unset means no RBI rates are fetched (rates are then entered by hand).
# RBI_RATE_URL=

# Files
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Field app (mobile). Cheque OCR is off until a key is set; attachments use ImageKit
# unless MOBILE_STORAGE_DRIVER=s3 (then install @aws-sdk/client-s3 and set AWS_*).
ANTHROPIC_API_KEY=
MOBILE_OCR_MODEL=claude-opus-5
MOBILE_STORAGE_DRIVER=
AWS_S3_BUCKET=
AWS_REGION=
AWS_S3_PUBLIC_URL=
# Resend (password-reset email). Required in production.
RESEND_API_KEY=
RESEND_FROM=Shiftline <no-reply@example.com>
