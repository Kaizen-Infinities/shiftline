# ============================================================
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/

# Production build
build/
dist/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Package manager locks (keep one — remove whichever you don't use)
# yarn.lock
# pnpm-lock.yaml

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*


