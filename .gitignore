# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
.mcp.json
mcp-servers/
figma-plugin
figma-mcp
# ============================================================
# PYTHON / FASTAPI (backend)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
*.egg-link
.installed.cfg
lib/
lib64/

# Virtual environments
.venv/
venv/
env/
ENV/
.env/
.Python

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# Jupyter
.ipynb_checkpoints/

# Distribution / packaging
MANIFEST


